        </div>

        <div class="results-info">
          Showing: <span id="visibleCount"><%= @validated_data.length %></span> rows
        </div>
      </section>

      <!-- Error List Section -->
      <section id="errorsSection" class="errors-section">
        <div class="errors-header">
          <h3>
            <i class="fas fa-exclamation-circle"></i>
            Validation Errors
            <span class="errors-count" id="errorsSummaryCount"><%= total_errors %></span>
          </h3>
          <div class="error-hint">Click any error to jump to the corresponding cell</div>
        </div>

        <div id="errorList" class="errors-grid">
          <% if total_errors > 0 %>
            <% @validated_data.each_with_index do |row, row_index| %>
              <% row.each do |header, cell| %>
                <% if cell.is_a?(Hash) && !cell[:match] %>
                  <div class="error-card" data-row="<%= row_index %>" data-column="<%= header %>">
                    <div class="error-header">
                      <span>Row <%= row_index + 1 %> • <%= header %></span>
