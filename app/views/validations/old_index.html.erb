          <% else %>
            <div class="empty-state">
              <div class="empty-icon">
                <i class="fas fa-check-circle"></i>
              </div>
              <h3>No Validation Errors Found</h3>
              <p>All data has passed validation successfully! 🎉</p>
            </div>
          <% end %>
        </div>
      </section>




//Table code:

<section class="table-section">
        <div class="table-header">
          <h3>Validated Excel Data</h3>
          <p>Rows with mismatches are highlighted. Click any error cell to see detailed information.</p>
        </div>

        <div class="table-controls">
          <div class="filter-controls">
            <label class="filter-label">Filter by status:</label>
            <select id="rowFilter" class="filter-select">
              <option value="all">All rows</option>
              <option value="valid">Only valid rows</option>
              <option value="errors">Only rows with errors</option>
            </select>
          </div>

          <div class="table-info">
            Columns: <strong><%= @extracted_headers.length %></strong> • 
            Rows: <strong><%= @validated_data.length %></strong>
          </div>
        </div>

        <div class="table-wrapper">
          <table class="validation-table">
            <thead>
              <tr>
                <% @extracted_headers.each do |header| %>
                  <th><%= header %></th>
                <% end %>
              </tr>
            </thead>
            <tbody id="validatedBody">
              <% @validated_data.each_with_index do |row, row_index| %>
                <% row_has_error = row.any? { |_k, v| v.is_a?(Hash) && !v[:match] } %>
                <tr id="row-<%= row_index %>" data-row-errors="<%= row_has_error %>">
                  <% @extracted_headers.each do |header| %>
                    <% cell = row[header] %>
                    <% if cell.is_a?(Hash) %>
                      <% if cell[:match] %>
                        <td class="cell-valid">
                          <div class="cell-value"><%= cell[:actual].presence || 'N/A' %></div>
                          <div class="cell-details">Calc: <%= number_with_precision(cell[:calc], precision: 2) %></div>
                        </td>
                      <% else %>
                        <td class="cell-error" data-row="<%= row_index %>" data-column="<%= header %>">
                          <div class="cell-value"><%= cell[:actual].presence || 'N/A' %></div>
                          <div class="cell-details">Expected: <%= number_with_precision(cell[:calc], precision: 2) %></div>
                        </td>
                      <% end %>
                    <% else %>
                      <td class="cell-normal"><%= cell %></td>
                    <% end %>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% else %>
      <!-- Empty State when no file uploaded -->
      <section class="upload-card">
        <div class="empty-state">
          <div class="empty-icon">
            <i class="fas fa-file-excel"></i>
          </div>
          <h3>No Excel File Uploaded</h3>
          <p>Upload an Excel file to start validation and see the results here.</p>
        </div>
      </section>
    <% end %>