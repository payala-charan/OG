        <%= form_with url: upload_validations_path, local: true, multipart: true, html: { id: "uploadForm" } do |form| %>
          <div id="fileUploadArea" class="file-upload-area">
            <i class="fas fa-cloud-upload-alt"></i>
            <h5 class="mb-1">Drag & Drop or Click to Upload</h5>
            <p class="text-muted mb-2">Supports .xlsx and .xls files</p>
            <%= form.file_field :file, id: "fileInput", class: "d-none", accept: ".xlsx, .xls" %>
            <div id="fileName" class="mt-2"></div>
          </div>

          <div class="mt-4">
            <%= form.label :conversion_criteria, "Select Conversion Criteria", class: "form-label fw-semibold" %>
            <%= form.select :conversion_criteria,
              options_for_select([
                ["Highest Margin (Default)", "highest_margin"],
                ["Highest Percent Margin", "percent_margin"],
                ["Low Cost", "low_cost"],
                ["Preferred Product", "preferred_product"]
              ]),
              { prompt: "Choose Criteria" },
              class: "form-select" %>
          </div>

          <div class="text-center mt-4">
            <%= form.submit "Validate File", class: "btn btn-primary px-4 py-2" %>
          </div>
        <% end %>
      </div>
    </div>

    <% if @extracted_headers.present? && @validated_data.present? %>
      <div class="card mb-4">
        <div class="card-header">
          <i class="fas fa-chart-line me-2"></i> Validation Summary
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-3">
              <div class="stats-card total">
                <div class="stats-value"><%= @validated_data.length %></div>
                <div>Total Rows</div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="stats-card valid">
                <div class="stats-value">
                  <% valid_rows = @validated_data.count { |r| r.all? { |_k, v| !v.is_a?(Hash) || v[:match] } } %>
                  <%= valid_rows %>
                </div>
                <div>Valid Rows</div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="stats-card warning">
                <div class="stats-value">
                  <% error_rows = @validated_data.count { |r| r.any? { |_k, v| v.is_a?(Hash) && !v[:match] } } %>
                  <%= error_rows %>
                </div>
                <div>Rows with Errors</div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="stats-card error">
                <div class="stats-value">
                  <% total_errors = @validated_data.sum { |r| r.count { |_k, v| v.is_a?(Hash) && !v[:match] } } %>
                  <%= total_errors %>
                </div>
                <div>Total Errors</div>
              </div>
            </div>
          </div>
          
          <!-- Progress Bar -->
          <div class="mt-4">
            <div class="d-flex justify-content-between">
              <span class="fw-semibold">Data Quality Score</span>
              <span class="fw-semibold">
                <% quality_score = ((valid_rows.to_f / @validated_data.length) * 100).round(1) %>
                <%= quality_score %>%
              </span>
            </div>
            <div class="progress">
              <div class="progress-bar" role="progressbar" style="width: <%= quality_score %>%" 
                   aria-valuenow="<%= quality_score %>" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Tabs for Errors and Table -->
      <div class="card">
        <div class="card-header">
          <i class="fas fa-table me-2"></i> Data Analysis
        </div>
        <div class="card-body">
          <ul class="nav nav-tabs" id="dataTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" id="errors-tab" data-bs-toggle="tab" data-bs-target="#errors" type="button" role="tab" aria-controls="errors" aria-selected="true">
                <i class="fas fa-exclamation-triangle me-2"></i>Error Details
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="table-tab" data-bs-toggle="tab" data-bs-target="#table" type="button" role="tab" aria-controls="table" aria-selected="false">
                <i class="fas fa-table me-2"></i>Data Table
              </button>
            </li>
          </ul>
          
          <div class="tab-content" id="dataTabsContent">
            <!-- Errors Tab -->
            <div class="tab-pane fade show active" id="errors" role="tabpanel" aria-labelledby="errors-tab">
              <div class="error-list-container">
                <% if total_errors > 0 %>
                  <% @validated_data.each_with_index do |row, i| %>
                    <% row.each do |header, cell| %>
                      <% if cell.is_a?(Hash) && !cell[:match] %>
                        <div class="error-list-item" data-row="<%= i %>" data-column="<%= header %>">
                          <div class="d-flex justify-content-between align-items-start">
                            <div>
                              <strong>Row <%= i + 1 %></strong> - <%= header %><br>
                              <small class="text-muted">
                                Actual: <%= cell[:actual] || "N/A" %> |
                                Expected: <%= number_with_precision(cell[:calc], precision: 2) %>
                              </small>
                            </div>
                            <span class="badge bg-danger">Error</span>
                          </div>
                        </div>
                      <% end %>
                    <% end %>
                  <% end %>
                <% else %>
                  <div class="text-center py-4">
                    <i class="fas fa-check-circle text-success mb-3" style="font-size: 3rem;"></i>
                    <h4 class="text-success">No Errors Found!</h4>
                    <p class="text-muted">All data has been validated successfully.</p>
                  </div>
                <% end %>
              </div>
            </div>
            
            <!-- Table Tab -->
            <div class="tab-pane fade" id="table" role="tabpanel" aria-labelledby="table-tab">
              <div class="table-container">
                <table class="table table-bordered align-middle" id="dataTable">
                  <thead>
                    <tr>
                      <% @extracted_headers.each do |header| %>
                        <th><%= header %></th>
                      <% end %>
                    </tr>
                  </thead>
                  <tbody>
                    <% @validated_data.each_with_index do |row, i| %>
                      <tr id="row-<%= i %>">
                        <% @extracted_headers.each do |header| %>
                          <% cell = row[header] %>
                          <% if cell.is_a?(Hash) %>
                            <td class="<%= cell[:match] ? 'success-cell' : 'error-cell' %>" data-row="<%= i %>" data-column="<%= header %>">
                              <%= cell[:actual] || "N/A" %>
                              <div class="small text-muted">Calc: <%= number_with_precision(cell[:calc], precision: 2) %></div>
                            </td>
                          <% else %>
                            <td><%= cell %></td>
                          <% end %>
                        <% end %>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const fileUploadArea = document.getElementById("fileUploadArea");
      const fileInput = document.getElementById("fileInput");
      const fileName = document.getElementById("fileName");

      // File upload logic
      fileUploadArea.addEventListener("click", () => fileInput.click());
      
      fileUploadArea.addEventListener("dragover", e => {
        e.preventDefault();
        fileUploadArea.classList.add("dragover");
      });
      
      fileUploadArea.addEventListener("dragleave", () => fileUploadArea.classList.remove("dragover"));
      
      fileUploadArea.addEventListener("drop", e => {
        e.preventDefault();
        fileUploadArea.classList.remove("dragover");
        const file = e.dataTransfer.files[0];
        fileInput.files = e.dataTransfer.files;
        showFile(file);
      });
      
      fileInput.addEventListener("change", () => {
        if (fileInput.files.length > 0) showFile(fileInput.files[0]);
      });

      function showFile(file) {
        fileName.innerHTML = `
          <div class="alert alert-info mt-2 mb-0 d-flex align-items-center">
            <i class="fas fa-file-excel text-success me-2 fs-5"></i>
            <div>
              <strong>${file.name}</strong> selected
              <div class="small">Size: ${(file.size / 1024).toFixed(2)} KB</div>
            </div>
          </div>`;
      }

      // Error navigation
      document.querySelectorAll(".error-list-item").forEach(item => {
        item.addEventListener("click", () => {
          // Switch to table tab
          const tableTab = document.getElementById("table-tab");
          const bsTab = new bootstrap.Tab(tableTab);
          bsTab.show();
          
          // Highlight the error cell
          setTimeout(() => {
            const row = document.getElementById(`row-${item.dataset.row}`);
            if (!row) return;
            
            const headers = <%= raw @extracted_headers.to_json %>;
            const index = headers.indexOf(item.dataset.column);
            
            if (index >= 0) {
              const cell = row.children[index];
              document.querySelectorAll(".highlight-error").forEach(e => e.classList.remove("highlight-error"));
              cell.classList.add("highlight-error");
              
              // Scroll to the cell
              cell.scrollIntoView({ behavior: "smooth", block: "center" });
              
              // Remove highlight after animation
              setTimeout(() => {
                cell.classList.remove("highlight-error");
              }, 3000);
            }
          }, 300);
        });
      });
    });
  </script>
</body>
</html>





