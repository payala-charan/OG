      background: rgba(255, 255, 255, 0.02);
    }

    .validation-table tbody tr:hover {
      background: rgba(224, 20, 30, 0.07);
    }

    .cell-valid {
      background: rgba(61, 220, 132, 0.12);
      color: var(--og-success);
      border-left: 3px solid var(--og-success);
    }

    .cell-no-conversion-product {
      background: rgba(255, 176, 32, 0.14);
      color: var(--og-warning);
      border-left: 3px solid var(--og-warning);
    }

    .cell-error {
      background: rgba(255, 59, 71, 0.16);
      color: var(--og-danger);
      border-left: 3px solid var(--og-danger);
