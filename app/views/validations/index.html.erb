      transition: var(--transition);
    }

    .cell-close:hover {
      background: rgba(255, 90, 31, 0.22);
    }

    .cell-nearest {
      background: rgba(255, 176, 32, 0.14);
      color: var(--og-amber);
      border-left: 3px solid var(--og-warning);
