<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OG - Excel Validation & Document Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --primary: #4361ee;
      --primary-light: #6c8aff;
      --primary-dark: #3a56d4;
      --secondary: #7209b7;
      --accent: #4cc9f0;
      --danger: #f72585;
      --warning: #ff9e00;
      --success: #06d6a0;
      --light: #f8f9fc;
      --dark: #2b2d42;
      --gray: #8d99ae;
      --border-radius: 16px;
      --shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      --transition: all 0.4s ease;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', 'Segoe UI', sans-serif;
      color: var(--dark);
      background: linear-gradient(135deg, #f5f7ff 0%, #f0f4ff 100%);
      overflow-x: hidden;
      line-height: 1.6;
    }

    /* Header & Navigation */
    .navbar {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      padding: 1rem 0;
      transition: var(--transition);
    }

    .navbar-brand {
      font-weight: 800;
      font-size: 1.8rem;
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: flex;
      align-items: center;
    }

    .navbar-brand i {
      margin-right: 0.5rem;
      font-size: 2rem;
    }

    .nav-link {
      font-weight: 500;
      color: var(--dark);
      margin: 0 0.5rem;
      transition: var(--transition);
      position: relative;
    }

    .nav-link:hover {
      color: var(--primary);
    }

    .nav-link::after {
      content: '';
      position: absolute;
      bottom: -5px;
      left: 0;
      width: 0;
      height: 2px;
      background: var(--primary);
      transition: var(--transition);
    }

    .nav-link:hover::after {
      width: 100%;
    }

    .btn-login, .btn-signup {
      border-radius: 50px;
      font-weight: 600;
      padding: 0.5rem 1.5rem;
      transition: var(--transition);
    }

    .btn-login {
      background: transparent;
      border: 2px solid var(--primary);
      color: var(--primary);
    }

    .btn-login:hover {
      background: var(--primary);
      color: white;
      transform: translateY(-3px);
      box-shadow: 0 6px 15px rgba(67, 97, 238, 0.3);
    }

    .btn-signup {
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
      border: none;
      color: white;
      margin-left: 0.5rem;
    }

    .btn-signup:hover {
      background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 100%);
      transform: translateY(-3px);
      box-shadow: 0 6px 15px rgba(67, 97, 238, 0.4);
    }

    /* Hero Section */
    .hero {
      min-height: 90vh;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
      padding: 4rem 0;
    }

    .hero-content {
      position: relative;
      z-index: 2;
    }

    .hero h1 {
      font-weight: 800;
      font-size: 3.5rem;
      line-height: 1.2;
      margin-bottom: 1.5rem;
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero p {
      font-size: 1.2rem;
      color: var(--gray);
      margin-bottom: 2rem;
      max-width: 600px;
    }

    .hero-btns .btn {
      border-radius: 50px;
      padding: 0.8rem 2rem;
      font-weight: 600;
      margin-right: 1rem;
      margin-bottom: 1rem;
      transition: var(--transition);
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
      border: none;
      box-shadow: 0 6px 20px rgba(67, 97, 238, 0.3);
    }

    .btn-primary:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 25px rgba(67, 97, 238, 0.4);
    }

    .btn-outline-primary {
      border: 2px solid var(--primary);
      color: var(--primary);
    }

    .btn-outline-primary:hover {
      background: var(--primary);
      color: white;
      transform: translateY(-5px);
    }

    .hero-image {
      position: relative;
      z-index: 1;
    }

    .floating-card {
      position: absolute;
      border-radius: var(--border-radius);
      background: white;
      box-shadow: var(--shadow);
      padding: 1.5rem;
      display: flex;
      align-items: center;
      animation: float 6s ease-in-out infinite;
    }

    .floating-card:nth-child(1) {
      top: 10%;
      left: 5%;
      animation-delay: 0s;
    }

    .floating-card:nth-child(2) {
      top: 60%;
      right: 10%;
      animation-delay: 2s;
    }

    .floating-card:nth-child(3) {
      bottom: 20%;
      left: 15%;
      animation-delay: 4s;
    }

    .floating-card i {
      font-size: 2rem;
      margin-right: 1rem;
      color: var(--primary);
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-20px); }
    }

    /* Features Section */
    .section-title {
      text-align: center;
      margin-bottom: 4rem;
    }

    .section-title h2 {
      font-weight: 800;
      font-size: 2.5rem;
      margin-bottom: 1rem;
      color: var(--dark);
    }

    .section-title p {
      color: var(--gray);
      font-size: 1.1rem;
      max-width: 600px;
      margin: 0 auto;
    }

    .features {
      padding: 6rem 0;
      background: white;
    }

    .feature-card {
      background: white;
      border-radius: var(--border-radius);
      padding: 2.5rem 2rem;
      box-shadow: var(--shadow);
      transition: var(--transition);
      height: 100%;
      text-align: center;
      border-top: 4px solid transparent;
    }

    .feature-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
      border-top: 4px solid var(--primary);
    }

    .feature-icon {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
    }

    .feature-icon i {
      font-size: 2rem;
      color: white;
    }

    .feature-card h3 {
      font-weight: 700;
      margin-bottom: 1rem;
      color: var(--dark);
    }

    .feature-card p {
      color: var(--gray);
    }

    /* How It Works */
    .how-it-works {
      padding: 6rem 0;
      background: linear-gradient(135deg, #f5f7ff 0%, #f0f4ff 100%);
    }

    .step-card {
      background: white;
      border-radius: var(--border-radius);
      padding: 2rem;
      box-shadow: var(--shadow);
      text-align: center;
      position: relative;
      transition: var(--transition);
    }

    .step-card:hover {
      transform: translateY(-5px);
    }

    .step-number {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 1.2rem;
      margin: 0 auto 1.5rem;
    }

    /* Payor Analysis */
    .payor-analysis {
      padding: 6rem 0;
      background: white;
    }

    .analysis-card {
      background: white;
      border-radius: var(--border-radius);
      padding: 2.5rem;
      box-shadow: var(--shadow);
      transition: var(--transition);
      height: 100%;
    }

    .analysis-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
    }

    .analysis-icon {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      background: rgba(67, 97, 238, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.5rem;
    }

    .analysis-icon i {
      font-size: 1.8rem;
      color: var(--primary);
    }

    /* CTA Section */
    .cta-section {
      padding: 6rem 0;
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      color: white;
      text-align: center;
    }

    .cta-section h2 {
      font-weight: 800;
      font-size: 2.5rem;
      margin-bottom: 1.5rem;
    }

    .cta-section p {
      font-size: 1.2rem;
      margin-bottom: 2rem;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
      opacity: 0.9;
    }

    .btn-light {
      background: white;
      color: var(--primary);
      border-radius: 50px;
      padding: 0.8rem 2.5rem;
      font-weight: 600;
      transition: var(--transition);
    }

    .btn-light:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 20px rgba(255, 255, 255, 0.3);
    }

    /* Footer */
    .footer {
      background: var(--dark);
      color: white;
      padding: 4rem 0 2rem;
    }

    .footer h5 {
      font-weight: 700;
      margin-bottom: 1.5rem;
    }

    .footer ul {
      list-style: none;
      padding: 0;
    }

    .footer ul li {
      margin-bottom: 0.8rem;
    }

    .footer ul li a {
      color: rgba(255, 255, 255, 0.7);
      text-decoration: none;
      transition: var(--transition);
    }

    .footer ul li a:hover {
      color: white;
      padding-left: 5px;
    }

    .social-icons a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      color: white;
      margin-right: 0.5rem;
      transition: var(--transition);
    }

    .social-icons a:hover {
      background: var(--primary);
      transform: translateY(-3px);
    }

    .footer-bottom {
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding-top: 2rem;
      margin-top: 3rem;
      text-align: center;
      color: rgba(255, 255, 255, 0.6);
    }

    /* Responsive Design */
    @media (max-width: 992px) {
      .hero h1 {
        font-size: 2.8rem;
      }
      
      .floating-card {
        position: relative;
        margin-bottom: 1.5rem;
        animation: none;
      }
      
      .hero-image {
        margin-top: 3rem;
      }
    }

    @media (max-width: 768px) {
      .hero h1 {
        font-size: 2.2rem;
      }
      
      .hero p {
        font-size: 1rem;
      }
      
      .section-title h2 {
        font-size: 2rem;
      }
      
      .feature-card, .step-card, .analysis-card {
        margin-bottom: 1.5rem;
      }
      
      .btn-login, .btn-signup {
        margin-bottom: 0.5rem;
      }
    }

    @media (max-width: 576px) {
      .hero h1 {
        font-size: 1.8rem;
      }
      
      .hero-btns .btn {
        display: block;
        width: 100%;
        margin-right: 0;
      }
    }
  </style>
</head>

<body>
  <!-- Navigation -->
  <nav class="navbar navbar-expand-lg navbar-light fixed-top">
    <div class="container">
      <a class="navbar-brand" href="#">
        <i class="fas fa-bolt"></i> OG
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link" href="#features">Features</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#how-it-works">How It Works</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#payor-analysis">Payor Analysis</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#contact">Contact</a>
          </li>
          <% if current_user %>
           <li class="nav-item" style="display: inline-block; margin-left: 10px;">
              <li class="nav-item" style="display: inline-block; margin-left: 10px;">
              <%= button_to "Logout", logout_path, method: :delete,
                  data: { turbo_confirm: "Are you sure you want to logout?" },
                  form: { style: "display: inline;" },
                  style: "background-color: #dc3545; color: white; padding: 8px 16px; border-radius: 6px; 
                          border: none; cursor: pointer;"
              %>
            </li>
          <% else %>
            <li class="nav-item">
              <%= link_to "Login", login_path, class: "nav-link btn-login" %>
            </li>
            <li class="nav-item">
              <%= link_to "Sign Up", signup_path, class: "nav-link btn-signup" %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6 hero-content">
          <br>
          <h1>Transform Your Excel Data with Advanced Validation & Analysis</h1>
          <p>OG is your all-in-one solution for Excel validation, document storage, and payor preference analysis. Streamline your workflow with our powerful tools.</p>
          <div class="hero-btns">
            <a href="/features" class="btn btn-primary">Get Started Free</a>
            <a href="#" class="btn btn-outline-primary">Watch Demo</a>
          </div>
        </div>
        <div class="col-lg-6 hero-image">
          <div class="floating-card">
            <i class="fas fa-file-excel"></i>
            <div>
              <h5>Excel Validation</h5>
              <p class="mb-0">Advanced error detection</p>
            </div>
          </div>
          <div class="floating-card">
            <i class="fas fa-database"></i>
            <div>
              <h5>Document Storage</h5>
              <p class="mb-0">Secure & organized</p>
            </div>
          </div>
          <div class="floating-card">
            <i class="fas fa-chart-pie"></i>
            <div>
              <h5>Payor Analysis</h5>
              <p class="mb-0">Insightful reporting</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features" id="features">
    <div class="container">
      <div class="section-title">
        <h2>Powerful Features for Your Data Needs</h2>
        <p>Discover how OG can transform your data management and analysis workflow</p>
      </div>
      <div class="row g-4">
        <div class="col-lg-4 col-md-6">
          <div class="feature-card">
            <div class="feature-icon">
              <i class="fas fa-check-double"></i>
            </div>
            <h3>Excel Validation</h3>
            <p>Automatically validate your Excel files with advanced algorithms that detect errors, inconsistencies, and data quality issues.</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
          <div class="feature-card">
            <div class="feature-icon">
              <i class="fas fa-cloud-upload-alt"></i>
            </div>
            <h3>Document Storage</h3>
            <p>Securely store and organize various document types with our advanced document management system.</p>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
          <div class="feature-card">
            <div class="feature-icon">
              <i class="fas fa-chart-bar"></i>
            </div>
            <h3>Payor Analysis</h3>
            <p>Analyze payor preferences and insurance data to gain valuable insights for your business decisions.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="how-it-works" id="how-it-works">
    <div class="container">
      <div class="section-title">
        <h2>How OG Works</h2>
        <p>Simple steps to transform your data management process</p>
      </div>
      <div class="row g-4">
        <div class="col-lg-4">
          <div class="step-card">
            <div class="step-number">1</div>
            <h4>Upload Your Files</h4>
            <p>Drag and drop your Excel files or documents directly into the platform.</p>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="step-card">
            <div class="step-number">2</div>
            <h4>Automated Validation</h4>
            <p>Our system automatically validates your data and identifies any issues.</p>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="step-card">
            <div class="step-number">3</div>
            <h4>Analyze & Export</h4>
            <p>View detailed analysis reports and export your validated data.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Payor Analysis -->
  <section class="payor-analysis" id="payor-analysis">
    <div class="container">
      <div class="section-title">
        <h2>Advanced Payor & Insurance Analysis</h2>
        <p>Gain valuable insights from your PayorPreferences data</p>
      </div>
      <div class="row g-4">
        <div class="col-lg-6">
          <div class="analysis-card">
            <div class="analysis-icon">
              <i class="fas fa-search-dollar"></i>
            </div>
            <h3>Payor Preference Insights</h3>
            <p>Identify patterns and trends in payor preferences to optimize your business strategies and improve revenue cycles.</p>
            <ul class="mt-3">
              <li>Track payment patterns</li>
              <li>Identify preferred providers</li>
              <li>Analyze reimbursement rates</li>
            </ul>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="analysis-card">
            <div class="analysis-icon">
              <i class="fas fa-shield-alt"></i>
            </div>
            <h3>Insurance Data Analysis</h3>
            <p>Comprehensive analysis of insurance data to help you make informed decisions about coverage and claims.</p>
            <ul class="mt-3">
              <li>Claims processing analytics</li>
              <li>Coverage pattern recognition</li>
              <li>Risk assessment tools</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <h2>Ready to Transform Your Data Management?</h2>
      <p>Join thousands of professionals who use OG to streamline their Excel validation, document storage, and payor analysis workflows.</p>
      <a href="/features" class="btn btn-light">Start Your Free Trail Now</a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer" id="contact">
    <div class="container">
      <div class="row">
        <div class="col-lg-4 mb-4">
          <h5><i class="fas fa-fire  me-2"></i> OG</h5>
          <p>Advanced Excel validation, document storage, and payor analysis platform for professionals.</p>
          <div class="social-icons mt-3">
            <a href="#"><i class="fab fa-facebook-f"></i></a>
            <a href="#"><i class="fab fa-twitter"></i></a>
            <a href="#"><i class="fab fa-linkedin-in"></i></a>
            <a href="#"><i class="fab fa-instagram"></i></a>
          </div>
        </div>
        <div class="col-lg-2 col-md-6 mb-4">
          <h5>Product</h5>
          <ul>
            <li><a href="#">Features</a></li>
            <li><a href="#">Pricing</a></li>
            <li><a href="#">Use Cases</a></li>
            <li><a href="#">Updates</a></li>
          </ul>
        </div>
        <div class="col-lg-2 col-md-6 mb-4">
          <h5>Company</h5>
          <ul>
            <li><a href="#">About</a></li>
            <li><a href="#">Blog</a></li>
            <li><a href="#">Careers</a></li>
            <li><a href="#">Contact</a></li>
          </ul>
        </div>
        <div class="col-lg-2 col-md-6 mb-4">
          <h5>Support</h5>
          <ul>
            <li><a href="#">Help Center</a></li>
            <li><a href="#">Documentation</a></li>
            <li><a href="#">Community</a></li>
            <li><a href="#">Status</a></li>
          </ul>
        </div>
        <div class="col-lg-2 col-md-6 mb-4">
          <h5>Legal</h5>
          <ul>
            <li><a href="#">Privacy Policy</a></li>
            <li><a href="#">Terms of Service</a></li>
            <li><a href="#">Security</a></li>
            <li><a href="#">Compliance</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2023 OG - Original Group. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Navbar background on scroll
    window.addEventListener('scroll', function() {
      if (window.scrollY > 50) {
        document.querySelector('.navbar').style.background = 'rgba(255, 255, 255, 0.95)';
        document.querySelector('.navbar').style.boxShadow = '0 4px 20px rgba(0, 0, 0, 0.1)';
      } else {
        document.querySelector('.navbar').style.background = 'rgba(255, 255, 255, 0.9)';
        document.querySelector('.navbar').style.boxShadow = '0 4px 20px rgba(0, 0, 0, 0.05)';
      }
    });

    // Smooth scrolling for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          window.scrollTo({
            top: target.offsetTop - 80,
            behavior: 'smooth'
          });
        }
      });
    });
  </script>
</body>
</html>