<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OG - Enterprise Healthcare & Integration Intelligence</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <style data-theme-style="classic" media="<%= theme_media(:classic) %>">
    :root {
      --primary: #4361ee;
      --primary-light: #6c8aff;
      --primary-dark: #3a56d4;
      --secondary: #7209b7;
      --accent: #4cc9f0;
      --danger: #f72585;
      --success: #06d6a0;
      --warning: #ffb703;
      --dark: #0f172a;
      --gray: #64748b;
      --light: #f8fafc;
      --transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: 'Inter', sans-serif;
      color: var(--dark);
      background: #ffffff;
      overflow-x: hidden;
      line-height: 1.6;
    }

    /* Navbar Config */
    .navbar {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(12px);
      box-shadow: 0 4px 30px rgba(0, 0, 0, 0.03);
      padding: 1.2rem 0;
      transition: var(--transition);
      border-bottom: 1px solid rgba(0,0,0,0.05);
    }
    .navbar-brand {
      font-weight: 800;
      font-size: 1.8rem;
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: flex;
      align-items: center;
    }
    .navbar-brand i { margin-right: 0.5rem; font-size: 2rem; }
    .nav-link { font-weight: 600; color: #475569; margin: 0 0.8rem; position: relative; }
    .nav-link:hover { color: var(--primary); }
    
    .btn-rounded {
      border-radius: 50px;
      font-weight: 600;
      padding: 0.6rem 1.8rem;
      transition: var(--transition);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .btn-login { background: transparent; border: 2px solid #e2e8f0; color: #475569; }
    .btn-login:hover { border-color: var(--primary); color: var(--primary); }
    .btn-signup { background: linear-gradient(135deg, var(--primary), var(--primary-light)); color: white; border: none; box-shadow: 0 6px 15px rgba(67, 97, 238, 0.25); }
    .btn-signup:hover { transform: translateY(-3px); box-shadow: 0 10px 25px rgba(67, 97, 238, 0.35); color: white; }

    /* Hero Section: Extreme Gradient Animation */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: 8rem 0 4rem;
      background: radial-gradient(circle at top right, rgba(67, 97, 238, 0.08) 0%, transparent 40%),
                  radial-gradient(circle at bottom left, rgba(114, 9, 183, 0.05) 0%, transparent 40%);
    }
    .hero-content h1 {
      font-weight: 900;
      font-size: 4.2rem;
      line-height: 1.15;
      letter-spacing: -1.5px;
      margin-bottom: 1.5rem;
      color: var(--dark);
    }
    .hero-content h1 span {
      background: linear-gradient(110deg, var(--primary), var(--secondary));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-content p {
      font-size: 1.25rem;
      color: #475569;
      margin-bottom: 2.5rem;
      max-width: 90%;
      line-height: 1.7;
    }
    .hero-btns { display: flex; gap: 1rem; flex-wrap: wrap; }
    .hero-primary-btn {
      background: var(--dark);
      color: white;
      padding: 1rem 2.5rem;
      border-radius: 50px;
      font-size: 1.1rem;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.8rem;
      transition: var(--transition);
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.2);
    }
    .hero-primary-btn:hover { transform: translateY(-4px); box-shadow: 0 15px 40px rgba(15, 23, 42, 0.3); color: white; }
    
    /* Feature Cloud Container (Replaces Clumsy Orbital) */
    .hero-cloud-wrapper {
      position: relative;
      width: 100%;
      margin-top: 3rem;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .orb-core-bg {
      width: 320px;
      height: 320px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      filter: blur(80px);
      opacity: 0.15;
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      animation: pulse-glow 8s infinite alternate;
      z-index: 0;
    }
    @keyframes pulse-glow { 0% { transform: translate(-50%, -50%) scale(0.8); opacity: 0.1; } 100% { transform: translate(-50%, -50%) scale(1.2); opacity: 0.25; } }

    .feature-cloud {
      position: relative;
      z-index: 2;
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      justify-content: center;
      align-items: center;
      max-width: 100%;
    }

    .floating-badge {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(16px);
      padding: 0.8rem 1.4rem;
      border-radius: 50px;
      box-shadow: 0 8px 25px rgba(0,0,0,0.06);
      display: flex;
      align-items: center;
      gap: 0.6rem;
      border: 1px solid rgba(255, 255, 255, 0.8);
      animation: float-badge 4s ease-in-out infinite alternate;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: default;
    }
    
    .floating-badge i { font-size: 1.2rem; }
    .floating-badge span { font-size: 0.95rem; font-weight: 700; color: var(--dark); white-space: nowrap; }

    .floating-badge:hover { 
      transform: translateY(-5px) scale(1.05) !important; 
      z-index: 20; 
      box-shadow: 0 15px 35px rgba(67, 97, 238, 0.15); 
      border-color: rgba(67, 97, 238, 0.4); 
    }

    /* Staggered Animations & Colors */
    @keyframes float-badge { 0% { transform: translateY(0); } 100% { transform: translateY(-12px); } }
    
    .floating-badge:nth-child(2n) { animation-delay: 0.5s; animation-duration: 5s; }
    .floating-badge:nth-child(3n) { animation-delay: 1.2s; animation-duration: 4.5s; }
    .floating-badge:nth-child(4n) { animation-delay: 2.1s; animation-duration: 6s; }
    .floating-badge:nth-child(5n) { animation-delay: 0.8s; animation-duration: 5.5s; }

    .c-1 i { color: var(--primary); }
    .c-2 i { color: var(--secondary); }
    .c-3 i { color: var(--success); }
    .c-4 i { color: var(--danger); }
    .c-5 i { color: var(--warning); }
    .c-6 i { color: #f59e0b; }
    .c-7 i { color: #10b981; }
    .c-8 i { color: #8b5cf6; }
    .c-9 i { color: #ec4899; }
    .c-10 i { color: #3b82f6; }
    .c-11 i { color: #14b8a6; }
    .c-12 i { color: #6366f1; }

    /* Features Grid Display */
    .features-section { padding: 6rem 0 8rem; background: #f8fafc; border-top: 1px solid rgba(0,0,0,0.03); }
    .section-head { text-align: center; margin-bottom: 5rem; }
    .section-head h2 { font-size: 2.8rem; font-weight: 900; color: var(--dark); margin-bottom: 1rem; letter-spacing: -1px; }
    .section-head p { font-size: 1.2rem; color: #64748b; max-width: 600px; margin: 0 auto; }
    
    .marketing-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 2rem;
    }
    .market-card {
      background: white;
      border-radius: 20px;
      padding: 2.5rem 2rem;
      box-shadow: 0 10px 40px rgba(0,0,0,0.03);
      transition: all 0.4s ease;
      border: 1px solid rgba(0,0,0,0.02);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      z-index: 1;
    }
    .market-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 5px;
      background: linear-gradient(90deg, var(--primary), var(--secondary));
      transform: scaleX(0); transform-origin: left; transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .market-card:hover { transform: translateY(-8px); box-shadow: 0 20px 45px rgba(67, 97, 238, 0.08); }
    .market-card:hover::before { transform: scaleX(1); }
    
    .m-icon {
      width: 65px; height: 65px;
      border-radius: 18px;
      background: #f1f5f9;
      display: flex; justify-content: center; align-items: center;
      font-size: 1.8rem; color: var(--primary);
      margin-bottom: 1.5rem;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .market-card:hover .m-icon {
      background: var(--primary); color: white; transform: scale(1.1) rotate(-8deg); box-shadow: 0 10px 20px rgba(67, 97, 238, 0.25);
    }
    .market-card h3 { font-size: 1.3rem; font-weight: 800; margin-bottom: 0.8rem; color: #0f172a; letter-spacing: -0.3px; }
    .market-card p { font-size: 0.95rem; color: #64748b; line-height: 1.6; margin-bottom: 0; }

    /* CTA Graphic Footer Box */
    .cta-container {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      border-radius: 30px;
      padding: 6rem 3rem;
      text-align: center;
      margin: 4rem auto 6rem;
      position: relative;
      overflow: hidden;
      box-shadow: 0 25px 50px rgba(15, 23, 42, 0.25);
    }
    .cta-container::after {
      content: ''; position: absolute; right: -10%; top: -20%;
      width: 400px; height: 400px; border-radius: 50%;
      background: radial-gradient(circle, rgba(67, 97, 238, 0.2) 0%, transparent 60%);
    }
    .cta-container h2 { color: white; font-size: 3rem; font-weight: 900; margin-bottom: 1.5rem; position: relative; z-index: 2; letter-spacing: -1px; }
    .cta-container p { color: #94a3b8; font-size: 1.2rem; max-width: 600px; margin: 0 auto 3rem; position: relative; z-index: 2; }
    .btn-light-special {
      background: white; color: #0f172a; padding: 1.2rem 3rem; border-radius: 50px;
      font-weight: 800; font-size: 1.1rem; text-decoration: none; position: relative; z-index: 2;
      transition: var(--transition); display: inline-flex; align-items: center; gap: 0.8rem;
    }
    .btn-light-special:hover { transform: translateY(-4px); box-shadow: 0 15px 35px rgba(255, 255, 255, 0.2); color: var(--primary); }

    /* Quick Stats Footer */
    .footer-modern { background: #fff; padding: 4rem 0 2rem; border-top: 1px solid #f1f5f9; text-align: center; }
    .footer-modern p { color: #94a3b8; font-weight: 500; font-size: 0.95rem; }

    @media (max-width: 992px) {
      .hero { padding: 8rem 0 2rem; text-align: center; }
      .hero-content p { margin: 0 auto 2rem; }
      .hero-btns { justify-content: center; }
      .hero-cloud-wrapper { margin-top: 3rem; padding: 0 1rem; }
      .section-head h2 { font-size: 2.2rem; }
      .marketing-grid { grid-template-columns: 1fr; }
    }
  </style>
<style data-theme-style="og" media="<%= theme_media(:og) %>">
    /* OG overrides for inline-styled navbar text and footer social links */
    .og-nav-text { color: var(--og-text) !important; }
    .og-social-link { color: #9a9089 !important; }
    .og-social-linkedin:hover { color: #ffa41b !important; }
    .og-social-instagram:hover { color: #ff5a1f !important; }
    .og-social-email:hover { color: #ff2d36 !important; }
    :root {
      --primary: var(--og-red);
      --primary-light: var(--og-red-bright);
      --primary-dark: var(--og-red-dark);
      --secondary: var(--og-ember);
      --accent: var(--og-amber);
      --danger: var(--og-danger);
      --success: var(--og-success);
      --warning: var(--og-warning);
      --dark: var(--og-text);
      --gray: var(--og-muted);
      --light: var(--og-surface-2);
      --transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);

      /* Bootstrap 5 overrides for this page */
      --bs-body-bg: var(--og-bg);
      --bs-body-color: var(--og-text);
      --bs-primary: #e0141e;
      --bs-primary-rgb: 224, 20, 30;
      --bs-danger: #ff3b47;
      --bs-danger-rgb: 255, 59, 71;
      --bs-dark-rgb: 243, 236, 228;
      --bs-link-color: var(--og-amber);
      --bs-link-hover-color: var(--og-ember);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: var(--og-font-body);
      color: var(--og-text);
      background: var(--og-bg);
      overflow-x: hidden;
      line-height: 1.6;
    }

    /* Navbar */
    .navbar {
      background: rgba(7, 7, 7, 0.72);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4);
      padding: 1.2rem 0;
      transition: var(--transition);
      border-bottom: 1px solid var(--og-line);
    }
    .navbar::after {
      content: '';
      position: absolute; left: 0; right: 0; bottom: -1px; height: 1px;
      background: linear-gradient(90deg, transparent, rgba(224, 20, 30, 0.7), rgba(255, 164, 27, 0.5), transparent);
      pointer-events: none;
    }
    .navbar-brand {
      font-family: var(--og-font-display);
      font-weight: 400;
      font-size: 2.1rem;
      letter-spacing: 0.08em;
      line-height: 1;
      color: var(--og-text);
      display: flex;
      align-items: center;
    }
    .navbar-brand i { margin-right: 0.5rem; font-size: 1.6rem; }
    .navbar-brand .text-primary {
      color: var(--og-red) !important;
      filter: drop-shadow(0 0 8px rgba(224, 20, 30, 0.7));
    }
    .navbar-toggler { border: 1px solid var(--og-line-strong); }
    .navbar-toggler:focus { box-shadow: 0 0 0 3px rgba(224, 20, 30, 0.25); }
    .nav-link {
      font-weight: 600;
      color: var(--og-text-soft);
      margin: 0 0.8rem;
      position: relative;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.82rem;
    }
    .nav-link:hover, .nav-link:focus { color: var(--og-amber); }
    .navbar .text-dark { color: var(--og-text) !important; }
    .navbar .text-dark:hover { color: var(--og-amber) !important; }

    .btn-rounded {
      border-radius: 50px;
      font-weight: 600;
      padding: 0.6rem 1.8rem;
      transition: var(--transition);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .btn-login { background: transparent; border: 1px solid var(--og-line-strong); color: var(--og-text-soft); }
    .btn-login:hover { border-color: var(--og-amber); color: var(--og-amber); }
    .btn-login.border-danger { border-color: rgba(255, 59, 71, 0.55) !important; }
    .btn-login.text-danger { color: var(--og-danger) !important; }
    .btn-login.border-danger:hover { background: rgba(255, 59, 71, 0.12) !important; border-color: var(--og-danger) !important; }
    .btn-signup {
      background: var(--og-grad-blood);
      color: #fff;
      border: none;
      box-shadow: 0 6px 18px rgba(224, 20, 30, 0.35);
    }
    .btn-signup:hover { transform: translateY(-3px); box-shadow: var(--og-glow-red); color: #fff; }

    /* Hero: sunset silhouette, cinematic overlays */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: 8rem 0 4rem;
      overflow: hidden;
      isolation: isolate;
      background:
        linear-gradient(90deg, rgba(7, 7, 7, 0.96) 0%, rgba(7, 7, 7, 0.86) 34%, rgba(7, 7, 7, 0.35) 62%, rgba(7, 7, 7, 0.55) 100%),
        linear-gradient(180deg, rgba(7, 7, 7, 0.55) 0%, rgba(7, 7, 7, 0) 30%, rgba(7, 7, 7, 0) 65%, #070707 100%),
        var(--og-img-sunset, none) 70% 42% / cover no-repeat,
        #1a0304;
    }
    /* Letterbox bars + vignette */
    .hero::before {
      content: '';
      position: absolute; inset: 0;
      z-index: -1;
      pointer-events: none;
      background:
        radial-gradient(ellipse at 70% 45%, transparent 35%, rgba(0, 0, 0, 0.55) 100%);
    }
    .hero::after {
      content: '';
      position: absolute; left: 0; right: 0; bottom: 0; height: 120px;
      z-index: -1;
      pointer-events: none;
      background: linear-gradient(180deg, transparent, var(--og-bg));
    }
    .og-ember-field {
      position: absolute; inset: 0;
      z-index: -1;
      pointer-events: none;
      background-image:
        radial-gradient(2px 2px at 12% 80%, rgba(255, 164, 27, 0.8), transparent 60%),
        radial-gradient(1.5px 1.5px at 28% 65%, rgba(255, 90, 31, 0.8), transparent 60%),
        radial-gradient(2px 2px at 46% 90%, rgba(255, 164, 27, 0.7), transparent 60%),
        radial-gradient(1.5px 1.5px at 63% 72%, rgba(255, 45, 54, 0.8), transparent 60%),
        radial-gradient(2.5px 2.5px at 78% 85%, rgba(255, 164, 27, 0.7), transparent 60%),
        radial-gradient(1.5px 1.5px at 90% 60%, rgba(255, 90, 31, 0.8), transparent 60%);
      animation: og-embers 9s linear infinite;
      opacity: 0.8;
    }
    @keyframes og-embers {
      0% { transform: translateY(0); opacity: 0; }
      15% { opacity: 0.8; }
      100% { transform: translateY(-55vh); opacity: 0; }
    }

    .og-titlecard {
      display: block;
      width: 190px;
      max-width: 60%;
      height: auto;
      margin-bottom: 1.6rem;
      border-radius: 6px;
      border: 1px solid rgba(224, 20, 30, 0.45);
      box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.5), 0 14px 40px rgba(224, 20, 30, 0.3);
      transform: rotate(-2deg);
    }
    .hero-kicker {
      display: block;
      font-family: var(--og-font-mono);
      text-transform: uppercase;
      letter-spacing: 0.4em;
      font-size: 0.85rem;
      color: var(--og-amber);
      margin-bottom: 0.75rem;
      text-shadow: 0 0 18px rgba(255, 164, 27, 0.35);
    }
    .hero-content h1 {
      font-family: var(--og-font-display);
      font-weight: 400;
      font-size: 5.6rem;
      line-height: 0.95;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      margin-bottom: 0.4rem;
      color: var(--og-text);
      text-shadow: 0 4px 30px rgba(0, 0, 0, 0.6);
    }
    .hero-content h1 span {
      background: var(--og-grad-sunset);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 22px rgba(224, 20, 30, 0.35));
    }
    .hero-content .og-slash { width: 110px; margin: 1rem 0 1.6rem; }
    .hero-content p {
      font-size: 1.15rem;
      color: var(--og-text-soft);
      margin-bottom: 2.5rem;
      max-width: 90%;
      line-height: 1.75;
    }
    .hero-btns { display: flex; gap: 1rem; flex-wrap: wrap; }
    .hero-primary-btn {
      background: var(--og-grad-blood);
      color: #fff;
      padding: 1rem 2.5rem;
      border-radius: 50px;
      font-size: 1.05rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.8rem;
      transition: var(--transition);
      border: 1px solid rgba(255, 45, 54, 0.6);
      box-shadow: 0 10px 30px rgba(224, 20, 30, 0.35);
    }
    .hero-primary-btn:hover {
      transform: translateY(-4px);
      box-shadow: var(--og-glow-red), 0 0 40px rgba(255, 90, 31, 0.35);
      color: #fff;
    }

    /* Feature cloud */
    .hero-cloud-wrapper {
      position: relative;
      width: 100%;
      margin-top: 3rem;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .orb-core-bg {
      width: 320px;
      height: 320px;
      border-radius: 50%;
      background: radial-gradient(circle, var(--og-amber) 0%, var(--og-ember) 45%, var(--og-red) 100%);
      filter: blur(80px);
      opacity: 0.2;
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      animation: pulse-glow 8s infinite alternate;
      z-index: 0;
    }
    @keyframes pulse-glow { 0% { transform: translate(-50%, -50%) scale(0.8); opacity: 0.12; } 100% { transform: translate(-50%, -50%) scale(1.2); opacity: 0.3; } }

    .feature-cloud {
      position: relative;
      z-index: 2;
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      justify-content: center;
      align-items: center;
      max-width: 100%;
    }

    .floating-badge {
      background: rgba(14, 13, 13, 0.78);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      padding: 0.8rem 1.4rem;
      border-radius: 50px;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);
      display: flex;
      align-items: center;
      gap: 0.6rem;
      border: 1px solid var(--og-line-strong);
      animation: float-badge 4s ease-in-out infinite alternate;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: default;
    }

    .floating-badge i { font-size: 1.2rem; }
    .floating-badge span { font-size: 0.92rem; font-weight: 700; color: var(--og-text); white-space: nowrap; }

    .floating-badge:hover {
      transform: translateY(-5px) scale(1.05) !important;
      z-index: 20;
      box-shadow: var(--og-glow-red);
      border-color: rgba(224, 20, 30, 0.6);
    }

    @keyframes float-badge { 0% { transform: translateY(0); } 100% { transform: translateY(-12px); } }

    .floating-badge:nth-child(2n) { animation-delay: 0.5s; animation-duration: 5s; }
    .floating-badge:nth-child(3n) { animation-delay: 1.2s; animation-duration: 4.5s; }
    .floating-badge:nth-child(4n) { animation-delay: 2.1s; animation-duration: 6s; }
    .floating-badge:nth-child(5n) { animation-delay: 0.8s; animation-duration: 5.5s; }

    .c-1 i { color: var(--og-red-bright); }
    .c-2 i { color: var(--og-ember); }
    .c-3 i { color: var(--og-amber); }
    .c-4 i { color: var(--og-gold); }
    .c-5 i { color: var(--og-red-bright); }
    .c-6 i { color: var(--og-amber); }
    .c-7 i { color: var(--og-ember); }
    .c-8 i { color: var(--og-moon); }
    .c-9 i { color: var(--og-red-bright); }
    .c-10 i { color: var(--og-text); }
    .c-11 i { color: var(--og-gold); }
    .c-12 i { color: var(--og-ember); }

    /* Features grid */
    .features-section {
      padding: 6rem 0 8rem;
      background:
        radial-gradient(900px 400px at 50% 0%, rgba(224, 20, 30, 0.1), transparent 70%),
        var(--og-bg);
      border-top: 1px solid var(--og-line);
      counter-reset: og-card;
    }
    .section-head { text-align: center; margin-bottom: 5rem; }
    .section-kicker { display: block; margin-bottom: 0.6rem; color: var(--og-amber); }
    .section-head h2 {
      font-family: var(--og-font-display);
      font-size: 3.6rem;
      font-weight: 400;
      color: var(--og-text);
      margin-bottom: 0.2rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
    .section-head .og-slash { margin: 0.4rem auto 1.4rem; }
    .section-head p { font-size: 1.1rem; color: var(--og-text-soft); max-width: 600px; margin: 0 auto; }

    .marketing-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 2rem;
    }
    .market-card {
      counter-increment: og-card;
      background: linear-gradient(180deg, var(--og-surface) 0%, var(--og-bg-alt) 100%);
      border-radius: var(--og-radius);
      padding: 2.5rem 2rem;
      box-shadow: var(--og-shadow-sm);
      transition: all 0.4s ease;
      border: 1px solid var(--og-line);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      z-index: 1;
    }
    .market-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: var(--og-grad-sunset);
      transform: scaleX(0); transform-origin: left; transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .market-card::after {
      content: counter(og-card, decimal-leading-zero);
      position: absolute; top: 1.2rem; right: 1.4rem;
      font-family: var(--og-font-display);
      font-size: 2.6rem;
      line-height: 1;
      color: rgba(255, 255, 255, 0.06);
      transition: color 0.4s ease;
      pointer-events: none;
    }
    .market-card:hover {
      transform: translateY(-8px);
      border-color: rgba(224, 20, 30, 0.45);
      box-shadow: var(--og-glow-red);
    }
    .market-card:hover::before { transform: scaleX(1); }
    .market-card:hover::after { color: rgba(224, 20, 30, 0.35); }

    .m-icon {
      width: 65px; height: 65px;
      border-radius: 16px;
      background: var(--og-surface-2);
      border: 1px solid var(--og-line-strong);
      display: flex; justify-content: center; align-items: center;
      font-size: 1.7rem; color: var(--og-red-bright);
      margin-bottom: 1.5rem;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .market-card:hover .m-icon {
      background: var(--og-grad-blood); color: #fff; border-color: transparent;
      transform: scale(1.1) rotate(-8deg); box-shadow: 0 10px 24px rgba(224, 20, 30, 0.45);
    }
    .market-card h3 {
      font-family: var(--og-font-display);
      font-size: 1.7rem;
      font-weight: 400;
      letter-spacing: 0.05em;
      margin-bottom: 0.6rem;
      color: var(--og-text);
    }
    .market-card p { font-size: 0.95rem; color: var(--og-muted); line-height: 1.65; margin-bottom: 0; }
    .market-card:hover p { color: var(--og-text-soft); }

    /* CTA box */
    .cta-container {
      background:
        linear-gradient(90deg, rgba(7, 7, 7, 0.92) 0%, rgba(7, 7, 7, 0.75) 50%, rgba(7, 7, 7, 0.92) 100%),
        var(--og-img-sunset, none) center 45% / cover no-repeat,
        var(--og-blood);
      border: 1px solid rgba(224, 20, 30, 0.35);
      border-radius: 24px;
      padding: 6rem 3rem;
      text-align: center;
      margin: 4rem auto 6rem;
      position: relative;
      overflow: hidden;
      box-shadow: var(--og-shadow), 0 0 60px rgba(224, 20, 30, 0.15);
    }
    .cta-container::after {
      content: ''; position: absolute; right: -10%; top: -20%;
      width: 400px; height: 400px; border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 90, 31, 0.22) 0%, transparent 60%);
      pointer-events: none;
    }
    .cta-container .og-tagline { position: relative; z-index: 2; display: block; margin-bottom: 0.8rem; color: var(--og-amber); }
    .cta-container h2 {
      color: var(--og-text);
      font-family: var(--og-font-display);
      font-size: 3.8rem;
      font-weight: 400;
      margin-bottom: 1.2rem;
      position: relative; z-index: 2;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      line-height: 1;
    }
    .cta-container p { color: var(--og-text-soft); font-size: 1.15rem; max-width: 600px; margin: 0 auto 3rem; position: relative; z-index: 2; }
    .btn-light-special {
      background: var(--og-grad-blood); color: #fff; padding: 1.2rem 3rem; border-radius: 50px;
      font-weight: 800; font-size: 1.05rem; text-transform: uppercase; letter-spacing: 0.1em;
      text-decoration: none; position: relative; z-index: 2;
      border: 1px solid rgba(255, 45, 54, 0.6);
      box-shadow: 0 12px 30px rgba(224, 20, 30, 0.35);
      transition: var(--transition); display: inline-flex; align-items: center; gap: 0.8rem;
    }
    .btn-light-special:hover { transform: translateY(-4px); box-shadow: var(--og-glow-red), 0 0 40px rgba(255, 90, 31, 0.35); color: #fff; }

    /* Footer */
    .footer-modern {
      background: var(--og-bg-alt);
      padding: 4rem 0 2rem;
      border-top: 1px solid var(--og-line);
      text-align: center;
      position: relative;
    }
    .footer-modern::before {
      content: ''; position: absolute; top: -1px; left: 50%; width: 180px; height: 2px;
      transform: translateX(-50%);
      background: var(--og-grad-blood);
      box-shadow: 0 0 14px rgba(224, 20, 30, 0.6);
    }
    .footer-modern .og-tagline { display: block; margin-bottom: 1rem; }
    .footer-modern p { color: var(--og-muted); font-weight: 500; font-size: 0.95rem; }

    @media (max-width: 992px) {
      .hero {
        padding: 8rem 0 2rem;
        text-align: center;
        background:
          linear-gradient(180deg, rgba(7, 7, 7, 0.88) 0%, rgba(7, 7, 7, 0.7) 45%, rgba(7, 7, 7, 0.9) 85%, #070707 100%),
          var(--og-img-sunset, none) center 40% / cover no-repeat,
          #1a0304;
      }
      .hero-content h1 { font-size: 4rem; }
      .og-titlecard { margin-left: auto; margin-right: auto; }
      .hero-content .og-slash { margin-left: auto; margin-right: auto; }
      .hero-content p { margin: 0 auto 2rem; }
      .hero-btns { justify-content: center; }
      .hero-cloud-wrapper { margin-top: 3rem; padding: 0 1rem; }
      .section-head h2 { font-size: 2.8rem; }
      .cta-container h2 { font-size: 2.8rem; }
      .marketing-grid { grid-template-columns: 1fr; }
    }

    @media (prefers-reduced-motion: reduce) {
      .og-ember-field,
      .orb-core-bg,
      .floating-badge { animation: none !important; }
      .market-card, .m-icon, .hero-primary-btn, .btn-light-special, .btn-signup, .floating-badge { transition: none !important; }
      .market-card:hover, .floating-badge:hover, .hero-primary-btn:hover, .btn-light-special:hover, .btn-signup:hover { transform: none !important; }
      .market-card:hover .m-icon { transform: none; }
    }
  </style>
</head>

