<style data-theme-style="classic" media="<%= theme_media(:classic) %>">
  .dbt-page {
    --dbt-ink: #1e293b;
    --dbt-muted: #64748b;
    --dbt-line: #e2e8f0;
    --dbt-blue: #4361ee;
    --dbt-purple: #7209b7;
    max-width: 1080px;
    margin: 0 auto;
    padding: 28px 20px 72px;
    color: var(--dbt-ink);
    font-family: Inter, "Segoe UI", system-ui, sans-serif;
  }

  .dbt-header, .dbt-source-card, .dbt-toolbar, .dbt-related-head, .dbt-selected li, .dbt-order li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .dbt-header { align-items: flex-start; margin-bottom: 20px; }
  .dbt-kicker { margin: 0 0 6px; color: var(--dbt-blue); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .dbt-header h1 { margin: 0; font-size: 2rem; letter-spacing: -0.03em; }
  .dbt-lead { max-width: 640px; margin: 8px 0 0; color: var(--dbt-muted); }

  .dbt-back, .dbt-text-btn, .dbt-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
  }

  .dbt-back, .dbt-text-btn {
    border: 1px solid var(--dbt-line);
    background: #fff;
    color: var(--dbt-ink);
    padding: 10px 16px;
  }

  .dbt-btn {
    border: 0;
    background: linear-gradient(135deg, var(--dbt-blue), var(--dbt-purple));
    color: #fff;
    padding: 12px 18px;
    cursor: pointer;
  }

  .dbt-source-card, .dbt-panel, .dbt-analysis, .dbt-table-wrap {
    background: #fff;
    border: 1px solid var(--dbt-line);
    border-radius: 18px;
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.05);
  }

  .dbt-source-card { padding: 16px 18px; margin-bottom: 18px; }
  .dbt-source-label, .dbt-meta, .dbt-visible, .dbt-path, .dbt-empty, .dbt-panel p { color: var(--dbt-muted); }
  .dbt-source-label { display: block; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
  #source-database { font-size: 1.25rem; }

  .dbt-flashes { display: grid; gap: 8px; margin-bottom: 16px; }
  .dbt-flash { border-radius: 12px; padding: 12px 14px; }
  .dbt-flash--alert { background: #fff1f2; color: #9f1239; }
  .dbt-flash--notice { background: #ecfdf5; color: #065f46; }

  .dbt-analysis { padding: 8px; margin-bottom: 18px; }
  .dbt-analysis-head, .dbt-panel { padding: 16px 18px; }
  .dbt-analysis-head h2, .dbt-panel h2, .dbt-details summary { margin: 0 0 8px; }
  .dbt-panel + .dbt-panel { border-top: 1px solid var(--dbt-line); border-radius: 0; box-shadow: none; }
  .dbt-selected, .dbt-related, .dbt-reasons, .dbt-tree, .dbt-order { margin: 0; padding: 0; list-style: none; }
  .dbt-selected { display: grid; gap: 8px; }
  .dbt-selected li, .dbt-related li, .dbt-order li { justify-content: flex-start; }
  .dbt-related { display: grid; gap: 14px; }
  .dbt-related-head { justify-content: flex-start; flex-wrap: wrap; }
  .dbt-include { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; font-weight: 700; }
  .dbt-include input { width: 18px; height: 18px; accent-color: var(--dbt-blue); }
  .dbt-related-actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 14px; flex-wrap: wrap; }
  .dbt-related-actions p { margin: 0; }
  .dbt-reasons { margin-top: 6px; }
  .dbt-reasons li, .dbt-tree li { margin: 4px 0; }
  .dbt-tree ul { margin-top: 4px; padding-left: 18px; }
  .dbt-order { display: grid; gap: 8px; padding-left: 22px; list-style: decimal; }
  .dbt-tick { color: var(--dbt-blue); font-weight: 800; }
  .dbt-tag { display: inline-flex; align-items: center; border-radius: 999px; background: #eef2ff; color: #3730a3; padding: 2px 8px; font-size: 0.75rem; font-weight: 700; }
  .dbt-tag--large { background: #fff7ed; color: #9a3412; }
  .is-required .dbt-tag { background: #fff7ed; color: #9a3412; }
  .is-referencing .dbt-tag { background: #f5f3ff; color: #6d28d9; }
  .dbt-details { padding: 8px 0 14px; }
  .dbt-details summary { cursor: pointer; font-weight: 800; }
  .dbt-details h3 { margin: 12px 0 6px; font-size: 0.95rem; }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.86rem; }

  .dbt-form { margin-top: 8px; }
  .dbt-toolbar {
    position: sticky;
    top: 0;
    z-index: 5;
    padding: 12px;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid var(--dbt-line);
    border-radius: 16px;
    margin-bottom: 12px;
  }
  .dbt-toolbar p { margin: 0; }
  .dbt-filter { display: flex; flex-direction: column; gap: 4px; color: var(--dbt-muted); font-size: 0.75rem; font-weight: 700; }
  .dbt-filter input, .dbt-table { width: 100%; }
  .dbt-filter input { border: 1px solid var(--dbt-line); border-radius: 10px; padding: 8px 10px; font: inherit; color: var(--dbt-ink); }
  .dbt-table-wrap { overflow-x: auto; }
  .dbt-table { border-collapse: collapse; }
  .dbt-table caption { caption-side: bottom; padding: 10px; color: var(--dbt-muted); text-align: left; }
  .dbt-table th, .dbt-table td { padding: 11px 14px; border-bottom: 1px solid var(--dbt-line); text-align: left; vertical-align: middle; }
  .dbt-table th { font-size: 0.78rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--dbt-muted); }
  .dbt-num, .dbt-select { text-align: right; font-variant-numeric: tabular-nums; }
  .dbt-select { width: 90px; text-align: center; }
  .dbt-table tbody tr:hover { background: #f8fafc; }
  .dbt-table tr.is-selected { background: #eef2ff; }
  .dbt-table tr.is-required { background: #fff7ed; }
  .dbt-table tr.is-referencing { background: #f5f3ff; }
  .dbt-table input { width: 18px; height: 18px; accent-color: var(--dbt-blue); }
  .dbt-table label { font-weight: 600; }

  @media (max-width: 760px) {
    .dbt-header, .dbt-source-card, .dbt-toolbar { align-items: stretch; flex-direction: column; }
  }
  .dbt-plan { border-top: 1px solid var(--dbt-line); }
  .dbt-plan-stats { display: flex; flex-wrap: wrap; gap: 24px; margin: 12px 0; }
  .dbt-plan-stats strong { display: block; font-size: 1.15rem; }
  .dbt-plan-table { width: 100%; border-collapse: collapse; margin: 8px 0 14px; }
  .dbt-plan-table th, .dbt-plan-table td { padding: 9px 10px; border-bottom: 1px solid var(--dbt-line); text-align: left; vertical-align: top; }
  .dbt-plan-table th { font-size: 0.75rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--dbt-muted); }
  .dbt-plan-table ul { margin: 4px 0 0; padding-left: 18px; }
  .dbt-plan-table .dbt-blocker { color: #9f1239; }
  .dbt-plan-table .dbt-warning { color: #9a3412; }
  .dbt-state { display: inline-flex; border-radius: 999px; padding: 2px 8px; font-size: 0.75rem; font-weight: 700; white-space: nowrap; }
  .dbt-state--ready, .dbt-state--succeeded { background: #ecfdf5; color: #065f46; }
  .dbt-state--blocked, .dbt-state--failed { background: #fff1f2; color: #9f1239; }
  .dbt-state--pending, .dbt-state--running { background: #eef2ff; color: #3730a3; }
  .dbt-state--rolled_back { background: #f1f5f9; color: #475569; }
  .dbt-safety { margin: 8px 0 14px; padding-left: 18px; color: var(--dbt-muted); }
  .dbt-safety li { margin: 3px 0; }
  .dbt-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .dbt-action { border: 1px solid var(--dbt-line); border-radius: 14px; padding: 14px; display: flex; flex-direction: column; gap: 10px; }
  .dbt-action h3 { margin: 0; font-size: 1rem; }
  .dbt-action p { margin: 0; }
  .dbt-action input[type="text"] { border: 1px solid var(--dbt-line); border-radius: 10px; padding: 8px 10px; font: inherit; }
  .dbt-btn--quiet { background: #fff; color: var(--dbt-ink); border: 1px solid var(--dbt-line); }
  .dbt-btn--danger { background: #be123c; }
  .dbt-runs { width: 100%; border-collapse: collapse; }
  .dbt-runs th, .dbt-runs td { padding: 9px 10px; border-bottom: 1px solid var(--dbt-line); text-align: left; }
  .dbt-runs th { font-size: 0.75rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--dbt-muted); }
  .dbt-rollback { color: #be123c; font-weight: 700; }
  .dbt-recent-runs { margin-bottom: 18px; }
  .dbt-error { white-space: pre-wrap; background: #fff1f2; color: #9f1239; border-radius: 12px; padding: 12px 14px; }

  @media (max-width: 760px) {
    .dbt-actions { grid-template-columns: 1fr; }
  }
</style>
