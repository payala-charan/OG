<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payor Preferences Dashboard</title>
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js for visualizations -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Custom scrollbar for better appearance */
        .table-container::-webkit-scrollbar {
            height: 8px;
            width: 8px;
        }
        .table-container::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 4px;
        }
        .table-container::-webkit-scrollbar-track {
            background: #f3f4f6;
        }
        .dashboard-card {
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }
        .card-hover {
            transition: all 0.3s ease;
        }
        .card-hover:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
        .gradient-bg { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .gradient-bg-2 { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }
        .gradient-bg-3 { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); }
        .gradient-bg-4 { background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); }
        
        /* Custom colors for payors */
        .payor-medicare { background-color: #3B82F6; }
        .payor-medicaid { background-color: #10B981; }
        .payor-private { background-color: #8B5CF6; }
        .payor-anthem { background-color: #EF4444; }
        .payor-united { background-color: #F59E0B; }
        .payor-cigna { background-color: #06B6D4; }
        .payor-aetna { background-color: #84CC16; }
    </style>
</head>
<body class="bg-gray-50 min-h-screen p-4 md:p-8 font-sans">

    <div id="app" class="max-w-7xl mx-auto">
        <!-- Header Section -->
        <div class="mb-8">
            <h1 class="text-4xl font-extrabold text-gray-900 mb-2">Payor Preferences Analysis</h1>
            <p class="text-gray-600">Advanced comparison dashboard for payor preferences across accounting periods</p>
        </div>
        <div>
            <%= link_to features_path do %>
            <i class="fas fa-sign-out-alt"></i> Back
            <% end %>
        </div>

        <!-- Summary Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <div class="bg-white rounded-xl p-6 dashboard-card card-hover">
                <div class="flex items-center">
                    <div class="rounded-lg p-3 gradient-bg text-white mr-4">
                        <i class="fas fa-calendar-alt text-xl"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500">Accounting Periods</p>
                        <h3 class="text-2xl font-bold text-gray-900">
                            <%= @payor_preferences.map(&:accounting_period_id).uniq.count %>
                        </h3>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl p-6 dashboard-card card-hover">
                <div class="flex items-center">
                    <div class="rounded-lg p-3 gradient-bg-2 text-white mr-4">
                        <i class="fas fa-hand-holding-usd text-xl"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500">Total Payors</p>
                        <h3 class="text-2xl font-bold text-gray-900">
                            <%= @payor_preferences.map(&:payor).uniq.count %>
                        </h3>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl p-6 dashboard-card card-hover">
                <div class="flex items-center">
                    <div class="rounded-lg p-3 gradient-bg-3 text-white mr-4">
                        <i class="fas fa-pills text-xl"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500">Generic Groups</p>
                        <h3 class="text-2xl font-bold text-gray-900">
                            <%= @payor_preferences.map(&:generic_name_group).uniq.count %>
                        </h3>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl p-6 dashboard-card card-hover">
                <div class="flex items-center">
                    <div class="rounded-lg p-3 gradient-bg-4 text-white mr-4">
                        <i class="fas fa-chart-line text-xl"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500">Total Records</p>
                        <h3 class="text-2xl font-bold text-gray-900">
                            <%= @payor_preferences.count %>
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Advanced Filter Section -->
        <div class="bg-white rounded-xl dashboard-card p-6 mb-8">
            <h2 class="text-xl font-bold text-gray-900 mb-4">Advanced Comparison Filters</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Generic Name Group</label>
                    <select id="genericFilter" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                        <option value="">All Groups</option>
                        <% @payor_preferences.map(&:generic_name_group).uniq.sort.each do |group| %>
                            <option value="<%= group %>"><%= group.capitalize %></option>
                        <% end %>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Payor</label>
                    <select id="payorFilter" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                        <option value="">All Payors</option>
                        <% @payor_preferences.map(&:payor).uniq.sort.each do |payor| %>
                            <option value="<%= payor %>"><%= payor.capitalize %></option>
                        <% end %>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Conversion Type</label>
                    <select id="conversionFilter" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                        <option value="">All Types</option>
                        <% @payor_preferences.map(&:conversion_type).uniq.compact.sort.each do |type| %>
                            <option value="<%= type %>"><%= type %></option>
                        <% end %>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Accounting Periods</label>
                    <select id="periodFilter" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                        <option value="">All Periods</option>
                        <% @payor_preferences.map(&:accounting_period_id).uniq.sort.each do |period| %>
                            <option value="<%= period %>"><%= period %></option>
                        <% end %>
                    </select>
                </div>
            </div>
            <div class="flex justify-between items-center">
                <div class="relative flex-1 max-w-md">
                    <input type="text" id="searchInput" placeholder="Search by brand, strength..." class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    <i class="fas fa-search absolute left-3 top-3 text-gray-400"></i>
                </div>
                <button id="updateChartBtn" class="ml-4 bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 transition duration-150 ease-in-out">
                    <i class="fas fa-sync-alt mr-2"></i>Update Chart
                </button>
            </div>
        </div>

        <!-- Charts Section -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
            <!-- Payor Distribution Chart -->
            <div class="bg-white rounded-xl p-6 dashboard-card">
                <h2 class="text-xl font-bold text-gray-900 mb-4">Payor Distribution</h2>
                <div class="h-80">
                    <canvas id="payorChart"></canvas>
                </div>
            </div>

            <!-- Dynamic Comparison Chart -->
            <div class="bg-white rounded-xl p-6 dashboard-card">
                <h2 class="text-xl font-bold text-gray-900 mb-4">Brand Comparison by Strength & Quarter</h2>
                <div class="mb-4 flex items-center space-x-4 text-sm text-gray-600">
                    <div class="flex items-center">
                        <div class="w-3 h-3 bg-blue-500 rounded mr-2"></div>
                        <span>Q3 Results</span>
                    </div>
                    <div class="flex items-center">
                        <div class="w-3 h-3 bg-green-500 rounded mr-2"></div>
                        <span>Q4 Results</span>
                    </div>
                </div>
                <div id="chartFiltersInfo" class="text-sm text-gray-500 italic mb-2">
                    Select Generic Name Group, Payor, and Conversion Type to view comparison
                </div>
                <div class="h-80">
                    <canvas id="dynamicComparisonChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Data Table Section -->
        <div class="bg-white rounded-xl dashboard-card mb-8">
            <div class="p-6 border-b border-gray-200">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between">
                    <h2 class="text-xl font-bold text-gray-900">Payor Preferences Data</h2>
                    <div class="mt-4 md:mt-0 text-sm text-gray-500">
                        Showing <span id="visibleCount"><%= @payor_preferences.count %></span> of <%= @payor_preferences.count %> records
                    </div>
                </div>
            </div>

            <div class="table-container overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-indigo-600 text-white sticky top-0">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Accounting Period</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Generic Name Group</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Payor</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Insurances</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Strength</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Conversion Type</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Target Column</th>
                            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Factor</th>
                            <th class="px-6 py-3 text-left text-xs font-medium tracking-wider">Values</th>
                            <th class="px-6 py-3 text-center text-xs font-medium uppercase tracking-wider">Result</th>
                            <th class="px-6 py-3 text-center text-xs font-medium uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="payorTableBody" class="bg-white divide-y divide-gray-200">
                        <% @payor_preferences.each_with_index do |p, index| %>
                            <tr class="hover:bg-indigo-50 transition-colors duration-200 <%= (index % 2 === 0) ? 'bg-gray-50' : 'bg-white' %>" 
                                data-period="<%= p.accounting_period_id %>" 
                                data-payor="<%= p.payor %>" 
                                data-generic="<%= p.generic_name_group %>"
                                data-conversion="<%= p.conversion_type %>"
                                data-search="<%= "#{p.generic_name_group} #{p.payor} #{p.conversion_type} #{p.strength} #{p.values&.keys&.join(' ')}" %>">
                                
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                        <%= p.accounting_period_id %>
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700"><%= p.generic_name_group.capitalize %></td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= get_payor_color_class(p.payor) %> text-white">
                                        <%= p.payor.capitalize %>
                                    </span>
                                </td>
                                
                                <td class="px-6 py-4 text-sm text-gray-600">
                                    <% if p.insurances.present? %>
                                        <% begin %>
                                            <% ins = JSON.parse(p.insurances) rescue p.insurances %>
                                            <% if ins.is_a?(Array) %>
                                                <% ins.each do |insurance| %>
                                                    <span class="inline-block bg-gray-100 rounded-full px-2 py-1 text-xs font-medium text-gray-800 mr-1 mb-1"><%= insurance %></span>
                                                <% end %>
                                            <% else %>
                                                <span class="inline-block bg-gray-100 rounded-full px-2 py-1 text-xs font-medium text-gray-800"><%= ins %></span>
                                            <% end %>
                                        <% rescue %>
                                            <span class="inline-block bg-gray-100 rounded-full px-2 py-1 text-xs font-medium text-gray-800"><%= p.insurances %></span>
                                        <% end %>
                                    <% else %>
                                        <span class="text-gray-400 italic">None specified</span>
                                    <% end %>
                                </td>
                                
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= p.strength %></td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= p.conversion_type %></td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= p.conversion_target_col %></td>
                                
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                                    <% if p.factor.to_s.capitalize == 'Max' %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            <i class="fas fa-arrow-up mr-1"></i> <%= p.factor.to_s.capitalize %>
                                        </span>
                                    <% else %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                            <i class="fas fa-arrow-down mr-1"></i> <%= p.factor.to_s.capitalize %>
                                        </span>
                                    <% end %>
                                </td>
                                
                                <td class="px-6 py-4 text-sm text-gray-600">
                                    <div class="space-y-1">
                                        <% if p.values.present? %>
                                            <% p.values.each do |brand, val| %>
                                                <div class="flex justify-between items-center">
                                                    <span class="font-medium text-gray-800 text-xs"><%= brand %>:</span>
                                                    <span class="text-indigo-600 font-semibold"><%= val %></span>
                                                </div>
                                            <% end %>
                                        <% end %>
                                    </div>
                                </td>
                                
                                <td class="px-6 py-4 text-sm text-gray-700 text-center">
                                    <div class="flex items-center justify-center space-x-1 px-3 py-1 rounded-lg <%= p.factor.to_s.capitalize == 'Max' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                                        <span class="text-lg leading-none"><%= p.factor.to_s.capitalize == 'Max' ? '↗' : '↘' %></span>
                                        <strong class="text-lg"><%= p.result %></strong>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-center">
                                    <%= link_to payor_preference_path(p), class: "inline-flex items-center px-3 py-1 border border-transparent text-xs leading-4 font-medium rounded-md shadow-sm text-white bg-indigo-500 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out" do %>
                                        <i class="fas fa-eye mr-1"></i> View
                                    <% end %>
                                </td>
                            </tr>
                        <% end %>
                    </tbody>
                </table>
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="hidden p-12 text-center">
                <i class="fas fa-inbox text-5xl text-gray-300 mb-4"></i>
                <h3 class="text-lg font-medium text-gray-900">No data found</h3>
                <p class="text-gray-500 mt-1">Try adjusting your search or filters</p>
            </div>
        </div>
    </div>

    <script>
        // Payor color mapping
        const payorColors = {
            'medicare': '#3B82F6',
            'medicaid': '#10B981', 
            'private': '#8B5CF6',
            'anthem': '#EF4444',
            'united': '#F59E0B',
            'cigna': '#06B6D4',
            'aetna': '#84CC16',
            'humana': '#EC4899',
            'bluecross': '#1E40AF'
        };

        let dynamicComparisonChart = null;
        let payorChart = null;

        // Initialize dashboard when DOM is loaded
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Initializing dashboard...');
            initializeCharts();
            setupEventListeners();
            updateVisibleCount();
        });

        function initializeCharts() {
            console.log('Initializing charts...');
            const payorPreferences = <%= raw @payor_preferences.to_json %>;

            // Initialize Payor Distribution Chart
            initializePayorChart(payorPreferences);
            
            // Initialize Dynamic Comparison Chart
            initializeDynamicComparisonChart();
            
            console.log('Charts initialized successfully');
        }

        function initializePayorChart(payorPreferences) {
            const ctx = document.getElementById('payorChart');
            if (!ctx) {
                console.error('Payor chart canvas element not found!');
                return;
            }

            // Payor Distribution Chart with custom colors
            const payorCounts = {};
            payorPreferences.forEach(p => {
                payorCounts[p.payor] = (payorCounts[p.payor] || 0) + 1;
            });

            const payorLabels = Object.keys(payorCounts);
            const payorBackgroundColors = payorLabels.map(payor => payorColors[payor.toLowerCase()] || '#6B7280');

            payorChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: payorLabels.map(p => p.charAt(0).toUpperCase() + p.slice(1)),
                    datasets: [{
                        data: Object.values(payorCounts),
                        backgroundColor: payorBackgroundColors,
                        borderWidth: 2,
                        borderColor: '#FFFFFF'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                boxWidth: 12,
                                padding: 15
                            }
                        }
                    }
                }
            });
        }

        function initializeDynamicComparisonChart() {
            const ctx = document.getElementById('dynamicComparisonChart');
            if (!ctx) {
                console.error('Dynamic comparison chart canvas element not found!');
                return;
            }

            dynamicComparisonChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Select filters to view data'],
                    datasets: [
                        {
                            label: 'Q3',
                            backgroundColor: 'rgba(59, 130, 246, 0.7)',
                            borderColor: 'rgba(59, 130, 246, 1)',
                            borderWidth: 1,
                            data: [0]
                        },
                        {
                            label: 'Q4',
                            backgroundColor: 'rgba(16, 185, 129, 0.7)',
                            borderColor: 'rgba(16, 185, 129, 1)',
                            borderWidth: 1,
                            data: [0]
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            title: {
                                display: true,
                                text: 'Brand & Strength Combinations'
                            }
                        },
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Value'
                            }
                        }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return `${context.dataset.label}: ${context.raw}`;
                                }
                            }
                        }
                    }
                }
            });
        }

        function updateDynamicComparisonChart() {
            console.log('Updating dynamic comparison chart...');
            
            const genericFilter = document.getElementById('genericFilter').value;
            const payorFilter = document.getElementById('payorFilter').value;
            const conversionFilter = document.getElementById('conversionFilter').value;

            if (!genericFilter || !payorFilter || !conversionFilter) {
                document.getElementById('chartFiltersInfo').textContent = 'Please select Generic Name Group, Payor, and Conversion Type to view chart';
                return;
            }

            const payorPreferences = <%= raw @payor_preferences.to_json %>;
            
            // Filter data based on selections
            const filteredData = payorPreferences.filter(p => 
                p.generic_name_group === genericFilter &&
                p.payor === payorFilter &&
                p.conversion_type === conversionFilter
            );

            console.log('Filtered data:', filteredData);

            // Group data by strength and brand
            const chartData = {};
            
            filteredData.forEach(p => {
                const strength = p.strength;
                const isQ3 = p.accounting_period_id.includes('Q3');
                const isQ4 = p.accounting_period_id.includes('Q4');
                
                if (p.values) {
                    Object.entries(p.values).forEach(([brand, value]) => {
                        const key = `${brand} (${strength})`;
                        
                        if (!chartData[key]) {
                            chartData[key] = { q3: null, q4: null };
                        }
                        
                        if (isQ3) {
                            chartData[key].q3 = value;
                        } else if (isQ4) {
                            chartData[key].q4 = value;
                        }
                    });
                }
            });

            console.log('Chart data:', chartData);

            // Prepare chart data
            const labels = Object.keys(chartData);
            const q3Data = labels.map(label => chartData[label].q3);
            const q4Data = labels.map(label => chartData[label].q4);

            // Update chart
            if (dynamicComparisonChart) {
                dynamicComparisonChart.data.labels = labels.length > 0 ? labels : ['No data available'];
                dynamicComparisonChart.data.datasets[0].data = labels.length > 0 ? q3Data : [0];
                dynamicComparisonChart.data.datasets[1].data = labels.length > 0 ? q4Data : [0];
                dynamicComparisonChart.update();
            }

            // Update chart info
            const hasData = labels.length > 0;
            if (hasData) {
                document.getElementById('chartFiltersInfo').textContent = 
                    `Showing ${labels.length} brand-strength combinations for ${genericFilter}, ${payorFilter}, ${conversionFilter}`;
            } else {
                document.getElementById('chartFiltersInfo').textContent = 
                    'No data available for the selected filters';
            }
        }

        function setupEventListeners() {
            console.log('Setting up event listeners...');
            
            // Search and filter functionality
            document.getElementById('searchInput').addEventListener('input', applyFilters);
            document.getElementById('genericFilter').addEventListener('change', applyFilters);
            document.getElementById('payorFilter').addEventListener('change', applyFilters);
            document.getElementById('conversionFilter').addEventListener('change', applyFilters);
            document.getElementById('periodFilter').addEventListener('change', applyFilters);

            // Chart update functionality
            const updateChartBtn = document.getElementById('updateChartBtn');
            if (updateChartBtn) {
                updateChartBtn.addEventListener('click', updateDynamicComparisonChart);
            }
            
            // Auto-update chart when filters change
            document.getElementById('genericFilter').addEventListener('change', updateDynamicComparisonChart);
            document.getElementById('payorFilter').addEventListener('change', updateDynamicComparisonChart);
            document.getElementById('conversionFilter').addEventListener('change', updateDynamicComparisonChart);
        }

        function applyFilters() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const genericFilter = document.getElementById('genericFilter').value;
            const payorFilter = document.getElementById('payorFilter').value;
            const conversionFilter = document.getElementById('conversionFilter').value;
            const periodFilter = document.getElementById('periodFilter').value;

            const rows = document.querySelectorAll('#payorTableBody tr');
            let visibleCount = 0;

            rows.forEach(row => {
                const period = row.getAttribute('data-period');
                const payor = row.getAttribute('data-payor');
                const generic = row.getAttribute('data-generic');
                const conversion = row.getAttribute('data-conversion');
                const searchText = row.getAttribute('data-search').toLowerCase();

                const matchesSearch = !searchTerm || searchText.includes(searchTerm);
                const matchesGeneric = !genericFilter || generic === genericFilter;
                const matchesPayor = !payorFilter || payor === payorFilter;
                const matchesConversion = !conversionFilter || conversion === conversionFilter;
                const matchesPeriod = !periodFilter || period === periodFilter;

                if (matchesSearch && matchesGeneric && matchesPayor && matchesConversion && matchesPeriod) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            // Show/hide empty state
            const emptyState = document.getElementById('emptyState');
            if (visibleCount === 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');
            }

            updateVisibleCount(visibleCount);
        }

        function updateVisibleCount(count) {
            const totalCount = <%= @payor_preferences.count %>;
            const visibleCount = count !== undefined ? count : totalCount;
            document.getElementById('visibleCount').textContent = visibleCount;
        }
    </script>
</body>
</html>