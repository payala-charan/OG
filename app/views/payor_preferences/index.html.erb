<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payor Preferences Dashboard</title>
    <!-- Chart.js for visualizations -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --primary: #4361ee;
            --primary-light: #6c8aff;
            --primary-dark: #3a56d4;
            --secondary: #7209b7;
            --accent: #4cc9f0;
            --danger: #f72585;
            --warning: #ff9e00;
            --success: #06d6a0;
            --light: #f8f9fc;
            --dark: #2b2d42;
            --gray: #8d99ae;
            --border-radius: 16px;
            --shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            --transition: all 0.4s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', sans-serif;
            color: var(--dark);
            background: linear-gradient(135deg, #f5f7ff 0%, #f0f4ff 100%);
            min-height: 100vh;
            line-height: 1.6;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
        }

        /* Header Styles */
        .header {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: var(--border-radius);
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: var(--shadow);
            border: 1px solid rgba(255, 255, 255, 0.8);
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .header-text h1 {
            font-weight: 800;
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .header-text p {
            color: var(--gray);
            font-size: 1.1rem;
        }

        .back-btn {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            color: white;
            border: none;
            border-radius: 50px;
            padding: 0.8rem 1.5rem;
            font-weight: 600;
            text-decoration: none;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 6px 20px rgba(67, 97, 238, 0.3);
        }

        .back-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(67, 97, 238, 0.4);
            color: white;
            text-decoration: none;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: white;
            border-radius: var(--border-radius);
            padding: 2rem;
            box-shadow: var(--shadow);
            transition: var(--transition);
            border-top: 4px solid transparent;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
        }

        .stat-card.periods { border-top-color: var(--primary); }
        .stat-card.payors { border-top-color: var(--secondary); }
        .stat-card.groups { border-top-color: var(--accent); }
        .stat-card.records { border-top-color: var(--success); }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
            font-size: 1.5rem;
            color: white;
        }

        .stat-icon.periods { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%); }
        .stat-icon.payors { background: linear-gradient(135deg, var(--secondary) 0%, #8a2be2 100%); }
        .stat-icon.groups { background: linear-gradient(135deg, var(--accent) 0%, #2dd4bf 100%); }
        .stat-icon.records { background: linear-gradient(135deg, var(--success) 0%, #05c291 100%); }

        .stat-number {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            text-align: center;
        }

        .stat-card.periods .stat-number { color: var(--primary); }
        .stat-card.payors .stat-number { color: var(--secondary); }
        .stat-card.groups .stat-number { color: var(--accent); }
        .stat-card.records .stat-number { color: var(--success); }

        .stat-label {
            color: var(--gray);
            font-weight: 600;
            font-size: 0.9rem;
            text-align: center;
        }

        /* Filters Section */
        .filters-section {
            background: white;
            border-radius: var(--border-radius);
            padding: 2.5rem;
            margin-bottom: 2rem;
            box-shadow: var(--shadow);
            border-top: 4px solid var(--primary);
        }

        .filters-header {
            margin-bottom: 2rem;
        }

        .filters-header h2 {
            font-weight: 700;
            font-size: 1.5rem;
            color: var(--dark);
            margin-bottom: 0.5rem;
        }

        .filters-header p {
            color: var(--gray);
        }

        .filters-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
        }

        .filter-label {
            font-weight: 600;
            color: var(--dark);
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
        }

        .filter-select {
            padding: 0.8rem 1rem;
            border: 2px solid var(--primary-light);
            border-radius: var(--border-radius);
            background: white;
            color: var(--dark);
            font-size: 0.9rem;
            transition: var(--transition);
        }

        .filter-select:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
        }

        .search-controls {
            display: flex;
            gap: 1rem;
            align-items: flex-end;
        }

        .search-box {
            position: relative;
            flex: 1;
        }

        .search-input {
            width: 100%;
            padding: 0.8rem 1rem 0.8rem 3rem;
            border: 2px solid var(--primary-light);
            border-radius: var(--border-radius);
            background: white;
            transition: var(--transition);
            font-size: 0.9rem;
        }

        .search-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
        }

        .search-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--primary);
        }

        .update-chart-btn {
            background: linear-gradient(135deg, var(--success) 0%, #05c291 100%);
            color: white;
            border: none;
            border-radius: 50px;
            padding: 0.8rem 2rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 6px 20px rgba(6, 214, 160, 0.3);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            white-space: nowrap;
        }

        .update-chart-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(6, 214, 160, 0.4);
        }

        /* Charts Section */
        .charts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .chart-card {
            background: white;
            border-radius: var(--border-radius);
            padding: 2rem;
            box-shadow: var(--shadow);
            transition: var(--transition);
            border-top: 4px solid transparent;
        }

        .chart-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
        }

        .chart-card.distribution { border-top-color: var(--primary); }
        .chart-card.comparison { border-top-color: var(--secondary); }

        .chart-header {
            margin-bottom: 1.5rem;
        }

        .chart-header h2 {
            font-weight: 700;
            font-size: 1.3rem;
            color: var(--dark);
            margin-bottom: 0.5rem;
        }

        .chart-header p {
            color: var(--gray);
            font-size: 0.9rem;
        }

        .chart-container {
            height: 300px;
            position: relative;
        }

        .chart-legend {
            display: flex;
            gap: 1rem;
            margin-top: 1rem;
            flex-wrap: wrap;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.8rem;
            color: var(--gray);
        }

        .legend-color {
            width: 12px;
            height: 12px;
            border-radius: 50%;
        }

        .legend-color.q3 { background: var(--primary); }
        .legend-color.q4 { background: var(--success); }

        .chart-info {
            font-size: 0.8rem;
            color: var(--gray);
            font-style: italic;
            margin-top: 0.5rem;
        }

        /* Table Section */
        .table-section {
            background: white;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .table-header {
            padding: 2rem;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        .table-header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .table-header h2 {
            font-weight: 700;
            font-size: 1.3rem;
            color: var(--dark);
            margin-bottom: 0.5rem;
        }

        .table-header p {
            color: var(--gray);
        }

        .results-info {
            color: var(--gray);
            font-weight: 600;
            font-size: 0.9rem;
        }

        .table-wrapper {
            overflow: auto;
            max-height: 600px;
        }

        .payor-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }

        .payor-table thead {
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .payor-table th {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            color: white;
            padding: 1rem;
            text-align: left;
            font-weight: 600;
            position: sticky;
            top: 0;
        }

        .payor-table td {
            padding: 1rem;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        .payor-table tbody tr {
            transition: var(--transition);
        }

        .payor-table tbody tr:hover {
            background: rgba(67, 97, 238, 0.03);
            transform: translateX(5px);
        }

        .payor-table tbody tr:nth-child(even) {
            background: rgba(67, 97, 238, 0.01);
        }

        .payor-table tbody tr:nth-child(even):hover {
            background: rgba(67, 97, 238, 0.05);
        }

        /* Table Cell Styles */
        .period-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.3rem 0.8rem;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 600;
            background: rgba(67, 97, 238, 0.1);
            color: var(--primary);
        }

        .payor-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.3rem 0.8rem;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 600;
            color: white;
        }

        .payor-medipro { background: var(--primary); }
        .payor-medicare { background: #d90429; }
        .payor-medicaid { background: var(--success); }
        .payor-private { background: var(--secondary); }
        .payor-anthem { background: var(--danger); }
        .payor-united { background: var(--warning); }
        .payor-cigna { background: var(--accent); }
        .payor-aetna { background: #84CC16; }
        .payor-humana { background: #EC4899; }
        .payor-bluecross { background: #1E40AF; }

        .insurance-tag {
            display: inline-block;
            background: var(--light);
            border-radius: 12px;
            padding: 0.2rem 0.6rem;
            font-size: 0.7rem;
            font-weight: 500;
            color: var(--dark);
            margin: 0.1rem;
        }

        .factor-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.3rem 0.8rem;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 600;
            gap: 0.3rem;
        }

        .factor-max {
            background: rgba(6, 214, 160, 0.1);
            color: var(--success);
        }

        .factor-min {
            background: rgba(247, 37, 133, 0.1);
            color: var(--danger);
        }

        .values-cell {
            min-width: 120px;
        }

        .value-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.3rem;
        }

        .brand-name {
            font-weight: 600;
            color: var(--dark);
            font-size: 0.75rem;
        }

        .brand-value {
            color: var(--primary);
            font-weight: 700;
            font-size: 0.8rem;
        }

        .result-cell {
            text-align: center;
        }

        .result-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.5rem 1rem;
            border-radius: var(--border-radius);
            font-weight: 700;
            gap: 0.5rem;
        }

        .result-max {
            background: rgba(6, 214, 160, 0.1);
            color: var(--success);
            border: 2px solid rgba(6, 214, 160, 0.3);
        }

        .result-min {
            background: rgba(247, 37, 133, 0.1);
            color: var(--danger);
            border: 2px solid rgba(247, 37, 133, 0.3);
        }

        .action-btn {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            color: white;
            border: none;
            border-radius: 50px;
            padding: 0.5rem 1rem;
            font-weight: 600;
            text-decoration: none;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.8rem;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(67, 97, 238, 0.3);
        }

        .action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(67, 97, 238, 0.4);
            color: white;
            text-decoration: none;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: var(--gray);
        }

        .empty-icon {
            font-size: 4rem;
            margin-bottom: 1rem;
            opacity: 0.5;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .container {
                padding: 1rem;
            }

            .header-content {
                flex-direction: column;
                gap: 1.5rem;
            }

            .header-text h1 {
                font-size: 2rem;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .filters-section {
                padding: 1.5rem;
            }

            .filters-grid {
                grid-template-columns: 1fr;
            }

            .search-controls {
                flex-direction: column;
            }

            .update-chart-btn {
                width: 100%;
                justify-content: center;
            }

            .charts-grid {
                grid-template-columns: 1fr;
            }

            .chart-container {
                height: 250px;
            }

            .table-header-content {
                flex-direction: column;
                align-items: stretch;
                gap: 1rem;
            }

            .payor-table {
                font-size: 0.75rem;
            }

            .payor-table th, .payor-table td {
                padding: 0.8rem 0.5rem;
            }
        }

        @media (max-width: 480px) {
            .chart-card {
                padding: 1.5rem;
            }

            .payor-table {
                font-size: 0.7rem;
            }

            .action-btn {
                padding: 0.4rem 0.8rem;
                font-size: 0.7rem;
            }
        }

        /* Custom scrollbar */
        .table-wrapper::-webkit-scrollbar {
            height: 8px;
            width: 8px;
        }

        .table-wrapper::-webkit-scrollbar-thumb {
            background: var(--primary-light);
            border-radius: 4px;
        }

        .table-wrapper::-webkit-scrollbar-track {
            background: var(--light);
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <header class="header">
            <div class="header-content">
                <div class="header-text">
                    <h1>Payor Preferences Analysis</h1>
                    <p>Advanced comparison dashboard for payor preferences across accounting periods</p>
                </div>
                <%= link_to features_path, class: "back-btn" do %>
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                <% end %>
            </div>
        </header>

        <!-- Summary Cards -->
        <section class="stats-grid">
            <div class="stat-card periods">
                <div class="stat-icon periods">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <div class="stat-number">
                    <%= @payor_preferences.map(&:accounting_period_id).uniq.count %>
                </div>
                <div class="stat-label">Accounting Periods</div>
            </div>

            <div class="stat-card payors">
                <div class="stat-icon payors">
                    <i class="fas fa-hand-holding-usd"></i>
                </div>
                <div class="stat-number">
                    <%= @payor_preferences.map(&:payor).uniq.count %>
                </div>
                <div class="stat-label">Total Payors</div>
            </div>

            <div class="stat-card groups">
                <div class="stat-icon groups">
                    <i class="fas fa-pills"></i>
                </div>
                <div class="stat-number">
                    <%= @payor_preferences.map(&:generic_name_group).uniq.count %>
                </div>
                <div class="stat-label">Generic Groups</div>
            </div>

            <div class="stat-card records">
                <div class="stat-icon records">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="stat-number">
                    <%= @payor_preferences.count %>
                </div>
                <div class="stat-label">Total Records</div>
            </div>
        </section>

        <!-- Advanced Filter Section -->
        <section class="filters-section">
            <div class="filters-header">
                <h2>Advanced Comparison Filters</h2>
                <p>Filter and analyze payor preferences data with precision</p>
            </div>

            <!-- Primary Filter Section -->
            <div class="primary-filter-container" style="margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px dashed var(--primary-light);">
                <div class="filter-group" style="max-width: 400px;">
                    <label class="filter-label" style="font-weight: 700; color: var(--primary); font-size: 1.05rem; display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
                        <i class="fas fa-users-cog"></i> Primary Filter: Select Team ID
                    </label>
                    <select id="teamFilter" class="filter-select" style="border-width: 2px; border-color: var(--primary); font-weight: 600;">
                        <option value="">All Teams</option>
                        <% @payor_preferences.map(&:team_id).compact.uniq.sort.each do |team_id| %>
                            <option value="<%= team_id %>">Team <%= team_id %></option>
                        <% end %>
                    </select>
                </div>
            </div>

            <div class="filters-grid">
                <div class="filter-group">
                    <label class="filter-label">Generic Name Group</label>
                    <select id="genericFilter" class="filter-select">
                        <option value="">All Groups</option>
                        <% @payor_preferences.map(&:generic_name_group).uniq.sort.each do |group| %>
                            <option value="<%= group %>"><%= group.capitalize %></option>
                        <% end %>
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-label">Payor</label>
                    <select id="payorFilter" class="filter-select">
                        <option value="">All Payors</option>
                        <% @payor_preferences.map(&:payor).uniq.sort.each do |payor| %>
                            <option value="<%= payor %>"><%= payor.capitalize %></option>
                        <% end %>
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-label">Conversion Type</label>
                    <select id="conversionFilter" class="filter-select">
                        <option value="">All Types</option>
                        <% @payor_preferences.map(&:conversion_type).uniq.compact.sort.each do |type| %>
                            <option value="<%= type %>"><%= type %></option>
                        <% end %>
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-label">Accounting Periods</label>
                    <select id="periodFilter" class="filter-select">
                        <option value="">All Periods</option>
                        <% @payor_preferences.map(&:accounting_period_id).uniq.sort.each do |period| %>
                            <option value="<%= period %>"><%= period %></option>
                        <% end %>
                    </select>
                </div>
            </div>

            <div class="search-controls">
                <div class="search-box">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="searchInput" placeholder="Search by brand, strength..." class="search-input">
                </div>
                <button id="updateChartBtn" class="update-chart-btn">
                    <i class="fas fa-sync-alt"></i> Update Chart
                </button>
            </div>
        </section>

        <!-- Charts Section -->
        <section class="charts-grid">
            <!-- Payor Distribution Chart -->
            <div class="chart-card distribution">
                <div class="chart-header">
                    <h2>Payor Distribution</h2>
                    <p>Visual breakdown of payor preferences across all data</p>
                </div>
                <div class="chart-container">
                    <canvas id="payorChart"></canvas>
                </div>
            </div>

            <!-- Dynamic Comparison Chart -->
            <div class="chart-card comparison">
                <div class="chart-header">
                    <h2>Brand Comparison by Strength & Quarter</h2>
                    <p>Compare values across different accounting periods</p>
                </div>
                <div class="chart-legend">
                    <div class="legend-item">
                        <div class="legend-color q3"></div>
                        <span>Q3 Results</span>
                    </div>
                    <div class="legend-item">
                        <div class="legend-color q4"></div>
                        <span>Q4 Results</span>
                    </div>
                </div>
                <div id="chartFiltersInfo" class="chart-info">
                    Select Generic Name Group, Payor, and Conversion Type to view comparison
                </div>
                <div class="chart-container">
                    <canvas id="dynamicComparisonChart"></canvas>
                </div>
            </div>
        </section>

        <!-- Data Table Section -->
        <section class="table-section">
            <div class="table-header">
                <div class="table-header-content">
                    <div>
                        <h2>Payor Preferences Data</h2>
                        <p>Detailed view of all payor preference records with filtering capabilities</p>
                    </div>
                    <div class="results-info">
                        Showing <span id="visibleCount"><%= @payor_preferences.count %></span> of <%= @payor_preferences.count %> records
                    </div>
                </div>
            </div>

            <div class="table-wrapper">
                <table class="payor-table">
                    <thead>
                        <tr>
                            <th>Accounting Period</th>
                            <th>Generic Name Group</th>
                            <th>Payor</th>
                            <th>Insurances</th>
                            <th>Strength</th>
                            <th>Conversion Type</th>
                            <th>Target Column</th>
                            <th>Factor</th>
                            <th>Values</th>
                            <th class="text-center">Result</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="payorTableBody">
                        <% if @payor_preferences.any? %>
                            <% @payor_preferences.each_with_index do |p, index| %>
                                <tr data-team-id="<%= p.team_id %>"
                                    data-period="<%= p.accounting_period_id %>" 
                                    data-payor="<%= p.payor %>" 
                                    data-generic="<%= p.generic_name_group %>"
                                    data-conversion="<%= p.conversion_type %>"
                                    data-search="<%= "#{p.generic_name_group} #{p.payor} #{p.conversion_type} #{p.strength} #{p.values&.keys&.join(' ')}" %>">
                                    
                                    <td>
                                        <span class="period-badge">
                                            <%= p.accounting_period_id %>
                                        </span>
                                    </td>
                                    <td><%= p.generic_name_group.capitalize %></td>
                                    <td>
                                        <span class="payor-badge <%= get_payor_color_class(p.payor) %>">
                                            <%= p.payor.capitalize %>
                                        </span>
                                    </td>
                                    
                                    <td>
                                        <% if p.insurances.present? %>
                                            <% begin %>
                                                <% ins = JSON.parse(p.insurances) rescue p.insurances %>
                                                <% if ins.is_a?(Array) %>
                                                    <% ins.each do |insurance| %>
                                                        <span class="insurance-tag"><%= insurance %></span>
                                                    <% end %>
                                                <% else %>
                                                    <span class="insurance-tag"><%= ins %></span>
                                                <% end %>
                                            <% rescue %>
                                                <span class="insurance-tag"><%= p.insurances %></span>
                                            <% end %>
                                        <% else %>
                                            <span class="no-file">None specified</span>
                                        <% end %>
                                    </td>
                                    
                                    <td><%= p.strength %></td>
                                    <td><%= p.conversion_type %></td>
                                    <td><%= p.conversion_target_col %></td>
                                    
                                    <td>
                                        <% if p.factor.to_s.capitalize == 'Max' %>
                                            <span class="factor-badge factor-max">
                                                <i class="fas fa-arrow-up"></i> <%= p.factor.to_s.capitalize %>
                                            </span>
                                        <% else %>
                                            <span class="factor-badge factor-min">
                                                <i class="fas fa-arrow-down"></i> <%= p.factor.to_s.capitalize %>
                                            </span>
                                        <% end %>
                                    </td>
                                    
                                    <td class="values-cell">
                                        <% if p.values.present? %>
                                            <% p.values.each do |brand, val| %>
                                                <div class="value-item">
                                                    <span class="brand-name"><%= brand %>:</span>
                                                    <span class="brand-value"><%= val %></span>
                                                </div>
                                            <% end %>
                                        <% end %>
                                    </td>
                                    
                                    <td class="result-cell">
                                        <div class="result-badge <%= p.factor.to_s.capitalize == 'Max' ? 'result-max' : 'result-min' %>">
                                            <span class="text-lg leading-none"><%= p.factor.to_s.capitalize == 'Max' ? '↗' : '↘' %></span>
                                            <strong class="text-lg"><%= p.result %></strong>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <%= link_to payor_preference_path(p), class: "action-btn" do %>
                                            <i class="fas fa-eye"></i> View
                                        <% end %>
                                    </td>
                                </tr>
                            <% end %>
                        <% else %>
                            <tr>
                                <td colspan="11">
                                    <div class="empty-state">
                                        <div class="empty-icon">
                                            <i class="fas fa-inbox"></i>
                                        </div>
                                        <h3>No Payor Preferences Data</h3>
                                        <p>Upload payor preference data to get started</p>
                                    </div>
                                </td>
                            </tr>
                        <% end %>
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <script>
        // Payor color mapping using your theme
        const payorColors = {
            'medicare': '#d90429',
            'medicaid': '#06d6a0', 
            'private': '#7209b7',
            'anthem': '#f72585',
            'united': '#ff9e00',
            'cigna': '#4cc9f0',
            'aetna': '#84CC16',
            'humana': '#EC4899',
            'bluecross': '#1E40AF'
        };

        // Helper to get color for a payor based on keyword matching
        function getPayorColor(payorName) {
            const name = payorName.toLowerCase();
            for (const [key, color] of Object.entries(payorColors)) {
                if (name.includes(key)) {
                    return color;
                }
            }
            return '#8d99ae'; // default gray
        }

        let dynamicComparisonChart = null;
        let payorChart = null;

        // Initialize dashboard when DOM is loaded
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Initializing dashboard...');
            initializeCharts();
            setupEventListeners();
            updateDropdownOptions();
            updateVisibleCount();
        });

        function initializeCharts() {
            console.log('Initializing charts...');
            const payorPreferences = <%= raw @payor_preferences.to_json %>;

            // Initialize Payor Distribution Chart
            initializePayorChart(payorPreferences);
            
            // Initialize Dynamic Comparison Chart
            initializeDynamicComparisonChart();
            
            console.log('Charts initialized successfully');
        }

        function initializePayorChart(payorPreferences) {
            const ctx = document.getElementById('payorChart');
            if (!ctx) {
                console.error('Payor chart canvas element not found!');
                return;
            }

            // Payor Distribution Chart with theme colors
            const payorCounts = {};
            payorPreferences.forEach(p => {
                payorCounts[p.payor] = (payorCounts[p.payor] || 0) + 1;
            });

            const payorLabels = Object.keys(payorCounts);
            const payorBackgroundColors = payorLabels.map(payor => getPayorColor(payor));

            payorChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: payorLabels.map(p => p.charAt(0).toUpperCase() + p.slice(1)),
                    datasets: [{
                        data: Object.values(payorCounts),
                        backgroundColor: payorBackgroundColors,
                        borderWidth: 2,
                        borderColor: '#FFFFFF'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                boxWidth: 12,
                                padding: 15,
                                usePointStyle: true,
                            }
                        }
                    }
                }
            });
        }

        function updatePayorChart() {
            const teamFilterValue = document.getElementById('teamFilter').value;
            const payorPreferences = <%= raw @payor_preferences.to_json %>;

            // Filter data based on selected team_id
            const filteredData = teamFilterValue 
                ? payorPreferences.filter(p => String(p.team_id) === teamFilterValue)
                : payorPreferences;

            const payorCounts = {};
            filteredData.forEach(p => {
                payorCounts[p.payor] = (payorCounts[p.payor] || 0) + 1;
            });

            const payorLabels = Object.keys(payorCounts);
            const payorBackgroundColors = payorLabels.map(payor => getPayorColor(payor));

            if (payorChart) {
                payorChart.data.labels = payorLabels.map(p => p.charAt(0).toUpperCase() + p.slice(1));
                payorChart.data.datasets[0].data = Object.values(payorCounts);
                payorChart.data.datasets[0].backgroundColor = payorBackgroundColors;
                payorChart.update();
            }
        }

        function initializeDynamicComparisonChart() {
            const ctx = document.getElementById('dynamicComparisonChart');
            if (!ctx) {
                console.error('Dynamic comparison chart canvas element not found!');
                return;
            }

            dynamicComparisonChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Select filters to view data'],
                    datasets: [
                        {
                            label: 'Q4 2024',
                            backgroundColor: 'rgba(67, 97, 238, 0.7)',
                            borderColor: 'rgba(67, 97, 238, 1)',
                            borderWidth: 1,
                            data: [0]
                        },
                        {
                            label: 'Q1 2025',
                            backgroundColor: 'rgba(6, 214, 160, 0.7)',
                            borderColor: 'rgba(6, 214, 160, 1)',
                            borderWidth: 1,
                            data: [0]
                        },
                        {
                            label: 'Q2 2025',
                            backgroundColor: 'rgba(255, 195, 0, 0.7)',
                            borderColor: 'rgba(255, 195, 0, 1)',
                            borderWidth: 1,
                            data: [0]
                        },
                        {
                            label: 'Q3 2025',
                            backgroundColor: 'rgba(255, 87, 87, 0.7)',
                            borderColor: 'rgba(255, 87, 87, 1)',
                            borderWidth: 1,
                            data: [0]
                        },
                        {
                            label: 'Q4 2025',
                            backgroundColor: 'rgba(155, 93, 229, 0.7)',
                            borderColor: 'rgba(155, 93, 229, 1)',
                            borderWidth: 1,
                            data: [0]
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            title: {
                                display: true,
                                text: 'Brand & Strength Combinations'
                            }
                        },
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Value'
                            }
                        }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return `${context.dataset.label}: ${context.raw}`;
                                }
                            }
                        }
                    }
                }
            });
        }

        function updateDynamicComparisonChart() {
            console.log('Updating dynamic comparison chart...');

            const teamFilter = document.getElementById('teamFilter').value;
            const genericFilter = document.getElementById('genericFilter').value;
            const payorFilter = document.getElementById('payorFilter').value;
            const conversionFilter = document.getElementById('conversionFilter').value;

            if (!genericFilter || !payorFilter || !conversionFilter) {
                document.getElementById('chartFiltersInfo').textContent = 
                    'Please select Generic Name Group, Payor, and Conversion Type to view chart';
                return;
            }

            const payorPreferences = <%= raw @payor_preferences.to_json %>;

            // Filter selections
            const filteredData = payorPreferences.filter(p =>
                (!teamFilter || String(p.team_id) === teamFilter) &&
                p.generic_name_group === genericFilter &&
                p.payor === payorFilter &&
                p.conversion_type === conversionFilter
            );

            console.log('Filtered data for comparison chart:', filteredData);

            const chartData = {};

            // Period label mapping
            const periodMap = {
                1: 'q4_2024',
                2: 'q1_2025',
                3: 'q2_2025',
                4: 'q3_2025',
                5: 'q4_2025'
            };

            filteredData.forEach(p => {
                const strength = p.strength;
                const periodKey = periodMap[p.accounting_period_id];

                if (p.values) {
                    Object.entries(p.values).forEach(([brand, value]) => {
                        const key = `${brand} (${strength})`;

                        if (!chartData[key]) {
                            chartData[key] = {
                                q4_2024: null,
                                q1_2025: null,
                                q2_2025: null,
                                q3_2025: null,
                                q4_2025: null
                            };
                        }

                        chartData[key][periodKey] = value;
                    });
                }
            });

            console.log('Comparison chart data:', chartData);

            const labels = Object.keys(chartData);

            const q4_2024 = labels.map(l => chartData[l].q4_2024);
            const q1_2025 = labels.map(l => chartData[l].q1_2025);
            const q2_2025 = labels.map(l => chartData[l].q2_2025);
            const q3_2025 = labels.map(l => chartData[l].q3_2025);
            const q4_2025 = labels.map(l => chartData[l].q4_2025);
            if (dynamicComparisonChart) {
                dynamicComparisonChart.data.labels = labels.length > 0 ? labels : ['No data available'];
                dynamicComparisonChart.data.datasets[0].data = labels.length ? q4_2024 : [0];
                dynamicComparisonChart.data.datasets[1].data = labels.length ? q1_2025 : [0];
                dynamicComparisonChart.data.datasets[2].data = labels.length ? q2_2025 : [0];
                dynamicComparisonChart.data.datasets[3].data = labels.length ? q3_2025 : [0];
                dynamicComparisonChart.data.datasets[4].data = labels.length ? q4_2025 : [0];
                dynamicComparisonChart.update();
            }

            document.getElementById('chartFiltersInfo').textContent = 
                labels.length
                ? `Showing ${labels.length} brand-strength combinations for ${genericFilter}, ${payorFilter}, ${conversionFilter}`
                : 'No data available for the selected filters';
        }

        function updateDropdownOptions() {
            const teamFilterValue = document.getElementById('teamFilter').value;
            const payorPreferences = <%= raw @payor_preferences.to_json %>;

            // Filter data based on selected team_id
            const filteredData = teamFilterValue 
                ? payorPreferences.filter(p => String(p.team_id) === teamFilterValue)
                : payorPreferences;

            // Get unique values for each category
            const uniqueGenerics = [...new Set(filteredData.map(p => p.generic_name_group).filter(Boolean))].sort();
            const uniquePayors = [...new Set(filteredData.map(p => p.payor).filter(Boolean))].sort();
            const uniqueConversions = [...new Set(filteredData.map(p => p.conversion_type).filter(Boolean))].sort();
            const uniquePeriods = [...new Set(filteredData.map(p => p.accounting_period_id).filter(Boolean))].sort((a, b) => a - b);

            // Update Generic Name Group dropdown
            updateSelectOptions('genericFilter', uniqueGenerics, 'All Groups', (val) => val.charAt(0).toUpperCase() + val.slice(1));
            // Update Payor dropdown
            updateSelectOptions('payorFilter', uniquePayors, 'All Payors', (val) => val.charAt(0).toUpperCase() + val.slice(1));
            // Update Conversion Type dropdown
            updateSelectOptions('conversionFilter', uniqueConversions, 'All Types');
            // Update Accounting Periods dropdown
            updateSelectOptions('periodFilter', uniquePeriods, 'All Periods');
        }

        function updateSelectOptions(elementId, values, defaultText, formatFn = (val) => val) {
            const selectEl = document.getElementById(elementId);
            if (!selectEl) return;

            const currentValue = selectEl.value;
            
            // Clear existing options except the default one
            selectEl.innerHTML = `<option value="">${defaultText}</option>`;

            values.forEach(val => {
                const opt = document.createElement('option');
                opt.value = val;
                opt.textContent = formatFn(val);
                if (String(val) === currentValue) {
                    opt.selected = true;
                }
                selectEl.appendChild(opt);
            });
        }

        function setupEventListeners() {
            console.log('Setting up event listeners...');
            
            // Primary team filter functionality
            const teamFilter = document.getElementById('teamFilter');
            if (teamFilter) {
                teamFilter.addEventListener('change', function() {
                    updateDropdownOptions();
                    applyFilters();
                    updatePayorChart();
                    updateDynamicComparisonChart();
                });
            }

            // Search and filter functionality
            document.getElementById('searchInput').addEventListener('input', applyFilters);
            document.getElementById('genericFilter').addEventListener('change', applyFilters);
            document.getElementById('payorFilter').addEventListener('change', applyFilters);
            document.getElementById('conversionFilter').addEventListener('change', applyFilters);
            document.getElementById('periodFilter').addEventListener('change', applyFilters);

            // Chart update functionality
            const updateChartBtn = document.getElementById('updateChartBtn');
            if (updateChartBtn) {
                updateChartBtn.addEventListener('click', updateDynamicComparisonChart);
            }
            
            // Auto-update chart when filters change
            document.getElementById('genericFilter').addEventListener('change', updateDynamicComparisonChart);
            document.getElementById('payorFilter').addEventListener('change', updateDynamicComparisonChart);
            document.getElementById('conversionFilter').addEventListener('change', updateDynamicComparisonChart);
        }

        function applyFilters() {
            const teamFilterValue = document.getElementById('teamFilter').value;
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const genericFilter = document.getElementById('genericFilter').value;
            const payorFilter = document.getElementById('payorFilter').value;
            const conversionFilter = document.getElementById('conversionFilter').value;
            const periodFilter = document.getElementById('periodFilter').value;

            const rows = document.querySelectorAll('#payorTableBody tr');
            let visibleCount = 0;

            rows.forEach(row => {
                if (row.cells.length > 1) { // Skip empty state row
                    const team = row.getAttribute('data-team-id');
                    const period = row.getAttribute('data-period');
                    const payor = row.getAttribute('data-payor');
                    const generic = row.getAttribute('data-generic');
                    const conversion = row.getAttribute('data-conversion');
                    const searchText = row.getAttribute('data-search').toLowerCase();

                    const matchesTeam = !teamFilterValue || team === teamFilterValue;
                    const matchesSearch = !searchTerm || searchText.includes(searchTerm);
                    const matchesGeneric = !genericFilter || generic === genericFilter;
                    const matchesPayor = !payorFilter || payor === payorFilter;
                    const matchesConversion = !conversionFilter || conversion === conversionFilter;
                    const matchesPeriod = !periodFilter || period === periodFilter;

                    if (matchesTeam && matchesSearch && matchesGeneric && matchesPayor && matchesConversion && matchesPeriod) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                }
            });

            updateVisibleCount(visibleCount);
        }

        function updateVisibleCount(count) {
            const totalCount = <%= @payor_preferences.count %>;
            const visibleCount = count !== undefined ? count : totalCount;
            document.getElementById('visibleCount').textContent = visibleCount;
        }
    </script>
</body>
</html>