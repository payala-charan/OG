<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Auto Ranking Results — Modern UI</title>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    :root {
      --primary: #4361ee;
      --primary-light: #6c8aff;
      --primary-dark: #3a56d4;
      --secondary: #7209b7;
      --accent: #4cc9f0;
      --danger: #f72585;
      --warning: #ff9e00;
      --success: #06d6a0;
      --light: #f8f9fc;
      --dark: #2b2d42;
      --gray: #8d99ae;
      --border-radius: 16px;
      --shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      --transition: all 0.4s ease;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', 'Segoe UI', sans-serif; color: var(--dark); background: linear-gradient(135deg, #f5f7ff 0%, #f0f4ff 100%); min-height: 100vh; line-height: 1.6; }
    
    .container { max-width: 1400px; margin: 0 auto; padding: 2rem; }

    .header { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border-radius: var(--border-radius); padding: 2rem; margin-bottom: 2rem; box-shadow: var(--shadow); border: 1px solid rgba(255, 255, 255, 0.8); }
    .header-content { display: flex; justify-content: space-between; align-items: flex-start; }
    .header-text h1 { font-weight: 800; font-size: 2.5rem; margin-bottom: 0.5rem; background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .header-text p { color: var(--gray); font-size: 1.1rem; }
    
    .header-meta { background: var(--light); padding: 1rem; border-radius: var(--border-radius); border-left: 4px solid var(--primary); margin-top: 1rem; }
    .header-meta p { margin-bottom: 0.5rem; font-size: 0.9rem; }
    .header-meta strong { color: var(--primary); }

    .file-history-section { background: rgba(255, 255, 255, 0.92); border-radius: var(--border-radius); padding: 1.75rem; margin-bottom: 2rem; box-shadow: var(--shadow); border: 1px solid rgba(67, 97, 238, 0.12); }
    .file-history-header { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem; }
    .file-history-header h2 { font-size: 1.4rem; margin: 0; }
    .file-history-header p { color: var(--gray); margin: 0; max-width: 720px; line-height: 1.5; }

    .file-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem; }
    .file-card { background: white; border-radius: var(--border-radius); border: 1px solid rgba(67, 97, 238, 0.12); padding: 1.25rem; text-decoration: none; color: inherit; display: flex; flex-direction: column; justify-content: space-between; transition: var(--transition); position: relative; min-height: 130px; }
    .file-card:hover { transform: translateY(-3px); box-shadow: 0 15px 35px rgba(67, 97, 238, 0.12); }
    .file-card.selected { border-color: var(--primary); box-shadow: 0 18px 40px rgba(67, 97, 238, 0.18); }
    .file-name { font-weight: 700; color: var(--dark); margin-bottom: 0.5rem; word-break: break-word; }
    .file-date { color: var(--gray); font-size: 0.9rem; margin-bottom: 1rem; }
    .file-card-meta { display: flex; justify-content: space-between; align-items: center; gap: 1rem; color: var(--dark); font-size: 0.9rem; font-weight: 600; }
    .file-card-meta i { color: var(--primary); }

    .back-btn { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%); color: white; border: none; border-radius: 50px; padding: 0.8rem 1.5rem; font-weight: 600; text-decoration: none; transition: var(--transition); display: inline-flex; align-items: center; gap: 0.5rem; box-shadow: 0 6px 20px rgba(67, 97, 238, 0.3); }
    .back-btn:hover { transform: translateY(-3px); box-shadow: 0 10px 25px rgba(67, 97, 238, 0.4); color: white; text-decoration: none; }

    .empty-state { text-align: center; padding: 4rem 2rem; color: var(--gray); background: white; border-radius: var(--border-radius); box-shadow: var(--shadow); }
    .empty-icon { font-size: 4rem; margin-bottom: 1rem; opacity: 0.5; }

    .rrk-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1.5rem; margin-bottom: 2rem; }
    .rrk-stat { background: #fff; border-radius: var(--border-radius); padding: 1.5rem; box-shadow: var(--shadow); border-top: 4px solid var(--primary); text-align: center; }
    .rrk-stat--ok { border-top-color: var(--success); }
    .rrk-stat--bad { border-top-color: var(--danger); }
    .rrk-stat-num { display: block; font-size: 2.5rem; font-weight: 800; color: var(--dark); line-height: 1.1; margin-bottom: 0.5rem; }
    .rrk-stat-label { font-size: 0.9rem; color: var(--gray); font-weight: 600; }

    .rrk-table-card { background: #fff; border-radius: var(--border-radius); padding: 1.5rem; margin-bottom: 2rem; box-shadow: var(--shadow); border-top: 4px solid var(--primary); }
    .rrk-sheet-title { margin: 0 0 1rem; font-size: 1.3rem; color: var(--dark); display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; }
    .rrk-sheet-title i { color: var(--primary); }
    .rrk-sheet-meta { font-size: 0.9rem; font-weight: 600; color: var(--gray); }
    .rrk-hint { margin: 0 0 1.5rem; font-size: 0.95rem; color: var(--gray); display: flex; align-items: flex-start; gap: 0.45rem; line-height: 1.45; }
    .rrk-hint i { color: var(--accent); margin-top: 0.12rem; }

    .rrk-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: 12px; border: 1px solid rgba(67, 97, 238, 0.12); max-height: min(70vh, 880px); overflow-y: auto; }
    .rrk-table { border-collapse: collapse; width: 100%; font-size: 0.85rem; min-width: 640px; }
    .rrk-table th { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%); color: #fff; padding: 0.8rem; font-weight: 700; text-align: center; border-bottom: 2px solid rgba(255, 255, 255, 0.25); border-right: 1px solid rgba(255, 255, 255, 0.2); position: sticky; top: 0; z-index: 2; white-space: normal; word-break: break-word; overflow-wrap: anywhere; line-height: 1.35; min-width: 6rem; box-sizing: border-box; }
    .rrk-th-sticky { left: 0; z-index: 4; text-align: left; min-width: 12rem; box-shadow: 4px 0 12px -6px rgba(0, 0, 0, 0.15); }
    
    .rrk-td-name { position: sticky; left: 0; z-index: 1; background: #fff; font-weight: 600; text-align: left; padding: 0.8rem; border: 1px solid rgba(142, 153, 175, 0.35); vertical-align: top; min-width: 12rem; max-width: 22rem; white-space: normal; word-break: break-word; overflow-wrap: break-word; box-shadow: 4px 0 12px -6px rgba(0, 0, 0, 0.08); }
    tbody tr:nth-child(even) .rrk-td-name { background: #f8f9fc; }
    
    .rrk-cell { border: 1px solid rgba(142, 153, 175, 0.35); padding: 0; text-align: center; vertical-align: top; min-width: 6rem; }
    .rrk-cell-link { display: block; text-decoration: none; color: inherit; padding: 0.6rem; height: 100%; box-sizing: border-box; }
    .rrk-cell-link:hover { background: rgba(0,0,0,0.05); }
    
    .rrk-cell--success { background: rgba(6, 214, 160, 0.16); border-color: rgba(5, 150, 105, 0.35); }
    .rrk-cell--failure { background: rgba(247, 37, 133, 0.12); border-color: rgba(247, 37, 133, 0.35); }
    .rrk-actual { display: block; font-weight: 700; font-size: 1.1rem; color: var(--dark); margin-bottom: 0.2rem; }
    .rrk-expected { display: block; font-size: 0.75rem; color: var(--gray); line-height: 1.3; }

    .rrk-clickable-row { cursor: pointer; }
    .rrk-clickable-row:hover td { background-color: rgba(67, 97, 238, 0.08) !important; }
    .rrk-trace-row:target td { background-color: #fff3cd !important; transition: background-color 0.5s ease; }

    .rrk-badge-success, .rrk-badge-failure { display: inline-block; border-radius: 999px; padding: 0.15rem 0.6rem; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }
    .rrk-badge-success { background: rgba(6, 214, 160, 0.18); color: #047857; }
    .rrk-badge-failure { background: rgba(247, 37, 133, 0.18); color: #9d174d; }

    .rrk-debug-table td { border: 1px solid rgba(142, 153, 175, 0.35); padding: 0.6rem; font-size: 0.8rem; vertical-align: top; background: #fff; white-space: normal; word-break: break-word; }
  </style>
</head>
<body>
  <div class="container">
    <header class="header">
      <div class="header-content">
        <div class="header-text">
          <h1>Auto Ranking Results</h1>
          <p><%= @selected_file.present? ? "Validation results for #{ @selected_file }" : "Choose a generated report below to display its results." %></p>
        </div>
        <%= link_to auto_ranking_path, class: "back-btn" do %>
          <i class="fas fa-arrow-left"></i> Run New Ranking
        <% end %>
      </div>

      <% if @latest_record %>
      <div class="header-meta">
        <p><strong>File:</strong> <%= @latest_record.file || 'Auto-generated report' %></p>
        <p><strong>Processed:</strong> <%= @latest_record.created_at.strftime('%B %d, %Y at %I:%M %p') %></p>
      </div>
      <% end %>
    </header>

    <section class="file-history-section">
      <div class="file-history-header">
        <div>
          <h2>Automated Ranking Reports</h2>
          <p>Select any recent auto ranking record to load the matching file results.</p>
        </div>
      </div>

      <div class="file-grid">
        <% @file_history.each do |history| %>
          <%= link_to auto_ranking_results_path(file: history.file), class: "file-card #{'selected' if history.file == @selected_file}" do %>
            <div>
              <div class="file-name"><%= history.file %></div>
              <div class="file-date"><%= history.latest_created_at.strftime('%B %d, %Y at %I:%M %p') %></div>
            </div>
          <% end %>
        <% end %>
      </div>
    </section>

    <% if @selected_file.blank? %>
      <section class="table-section">
        <div class="empty-state">
          <div class="empty-icon"><i class="fas fa-folder-open"></i></div>
          <h3>Select a file to view ranking results</h3>
          <p>Choose one of the recently ranked files above and the results will load below.</p>
        </div>
      </section>
    <% elsif @latest_record.present? %>
      <% 
        sheet_sections = @latest_record.sheet_sections 
        all_rows = sheet_sections.flat_map { |s| Array(s["rows"]) }
        failure_cells = all_rows.sum { |row| Array(row["cells"]).count { |c| c["status"].to_s == "failure" } }
        total_cells = all_rows.sum { |row| Array(row["cells"]).size }
        success_cells = [total_cells - failure_cells, 0].max
      %>

      <section class="rrk-stats" aria-label="Summary">
        <div class="rrk-stat">
          <span class="rrk-stat-num"><%= number_with_delimiter(sheet_sections.size) %></span>
          <span class="rrk-stat-label">Sheets</span>
        </div>
        <div class="rrk-stat">
          <span class="rrk-stat-num"><%= number_with_delimiter(all_rows.size) %></span>
          <span class="rrk-stat-label">Product rows</span>
        </div>
        <div class="rrk-stat rrk-stat--ok">
          <span class="rrk-stat-num"><%= number_with_delimiter(success_cells) %></span>
          <span class="rrk-stat-label">Matching cells</span>
        </div>
        <div class="rrk-stat <%= failure_cells.positive? ? 'rrk-stat--bad' : '' %>">
          <span class="rrk-stat-num"><%= number_with_delimiter(failure_cells) %></span>
          <span class="rrk-stat-label">Mismatches</span>
        </div>
      </section>

      <% sheet_sections.each_with_index do |section, idx| %>
        <% headers = Array(section["headers"]) %>
        <% rows = Array(section["rows"]) %>
        <section class="rrk-table-card">
          <h2 class="rrk-sheet-title">
            <i class="fas fa-table"></i>
            <%= section["sheet_name"].presence || "Sheet #{idx + 1}" %>
            <span class="rrk-sheet-meta"><%= number_with_delimiter(rows.size) %> rows · <%= number_with_delimiter(headers.size) %> payors</span>
          </h2>
          <p class="rrk-hint"><i class="fas fa-info-circle"></i> Expected <strong>✔</strong> means a numeric rank is allowed. Expected <strong>X</strong> means no rank. Green = Match, Red = Mismatch.</p>
          <div class="rrk-scroll">
            <table class="rrk-table">
              <thead>
                <tr>
                  <th class="rrk-th-sticky">Generic name</th>
                  <% headers.each do |payor| %>
                    <th><%= payor %></th>
                  <% end %>
                </tr>
              </thead>
              <tbody>
                <% rows.each do |row| %>
                  <tr>
                    <td class="rrk-td-name"><%= row["generic_name"] %></td>
                    <% Array(row["cells"]).each_with_index do |cell, col_idx| %>
                      <% payor_header = headers[col_idx].to_s %>
                      <% trace_id = "trace-#{Digest::MD5.hexdigest("#{section["sheet_name"]}-#{row["generic_name"]}-#{payor_header}")}" %>
                      <td class="rrk-cell rrk-cell--<%= cell["status"].presence || "failure" %>">
                        <a href="#<%= trace_id %>" class="rrk-cell-link" title="Click to see backend trace">
                          <span class="rrk-actual"><%= cell["actual"] %></span>
                          <span class="rrk-expected">Expected: <%= cell["expected"] %></span>
                        </a>
                      </td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>

      <% debug_mismatches = Array(@latest_record.data&.dig("debug_mismatches")) %>
      <% if debug_mismatches.present? %>
        <section class="rrk-table-card" style="border-top-color: var(--danger);">
          <h2 class="rrk-sheet-title">
            <i class="fas fa-bug" style="color: var(--danger);"></i> Validation Debug (Mismatches)
            <span class="rrk-sheet-meta"><%= number_with_delimiter(debug_mismatches.size) %> cells</span>
          </h2>
          <div class="rrk-scroll">
            <table class="rrk-table rrk-debug-table">
              <thead>
                <tr>
                  <th>Sheet</th>
                  <th>Row</th>
                  <th>Generic Name</th>
                  <th>Payor Header</th>
                  <th>Actual</th>
                  <th>Expected</th>
                  <th>Allowed Insurances</th>
                </tr>
              </thead>
              <tbody>
                <% debug_mismatches.each do |m| %>
                  <% trace_id = "trace-#{Digest::MD5.hexdigest("#{m["sheet_name"]}-#{m["generic_name"]}-#{m["payor_header"]}")}" %>
                  <tr id="<%= trace_id %>" class="rrk-clickable-row rrk-trace-row">
                    <td><%= m["sheet_name"] %></td>
                    <td><%= m["row_number"] %></td>
                    <td><%= m["generic_name"] %></td>
                    <td><%= m["payor_header"] %></td>
                    <td><b><%= m["actual"] %></b></td>
                    <td><%= m["expected"] %></td>
                    <td><%= Array(m["allowed_insurances"]).join(", ") %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>
    <% end %>
  </div>
</body>
</html>
