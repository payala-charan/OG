<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="description" content="Auto Ranking Workflow - Automated Excel ranking process">
  <meta name="theme-color" content="#4361ee">
  <title>Auto Ranking</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
  <div class="auto-validation-page">
    <header class="page-header" role="banner">
      <div class="container">
        <div class="header-content">
          <div class="back-link">
            <%= link_to features_path, class: "btn-back", aria_label: "Back to Features" do %>
              <i class="fas fa-arrow-left" aria-hidden="true"></i>
              <span>Back</span>
            <% end %>
          </div>
          <div class="page-title">
            <h1>Auto Ranking</h1>
            <p>Automated Excel Expanded Rankings in one click</p>
          </div>
          <nav class="page-actions">
            <%= link_to auto_ranking_results_path, class: "btn-secondary", aria_label: "View ranking results" do %>
              <i class="fas fa-chart-bar" aria-hidden="true"></i>
              <span>Results</span>
            <% end %>
          </nav>
        </div>
      </div>
    </header>

    <main class="main-content" role="main">
      <div class="container">
        <section class="validation-section" aria-labelledby="validation-title">
          <article class="validation-card">
            <div class="card-icon" aria-hidden="true">
              <i class="fas fa-list-ol"></i>
            </div>
            <div class="card-content">
              <h2 id="validation-title">Automated Workflow</h2>
              <p>Download the expanded rankings Excel sheet automatically, validate data against criteria, and store your results.</p>
              
              <div class="process-steps" role="list">
                <div class="step" role="listitem">
                  <i class="fas fa-download" aria-hidden="true"></i>
                  <span>Download</span>
                </div>
                <div class="step" role="listitem">
                  <i class="fas fa-check-circle" aria-hidden="true"></i>
                  <span>Rank</span>
                </div>
                <div class="step" role="listitem">
                  <i class="fas fa-database" aria-hidden="true"></i>
                  <span>Store</span>
                </div>
              </div>
            </div>

            <div class="filter-section">
              <h3>Filter Parameters</h3>
              <form id="validation-filters" class="filters-grid">
                <div class="form-group">
                  <label for="generic-name-group">
                    <i class="fas fa-tag" aria-hidden="true"></i>
                    Generic Name Group
                  </label>
                  <select id="generic-name-group" name="generic_name_group" required>
                    <option value="">Select Generic Name Group</option>
                    <option value="Bendamustine">Bendamustine</option>
                    <option value="Bevacizumab">Bevacizumab</option>
                    <option value="Filgrastim">Filgrastim</option>
                    <option value="Infliximab">Infliximab</option>
                    <option value="Pegfilgrastim">Pegfilgrastim</option>
                    <option value="Rituximab">Rituximab</option>
                    <option value="Trastuzumab">Trastuzumab</option>
                    <option value="Tocilizumab">Tocilizumab</option>
                    <option value="Leuprolide Acetate">Leuprolide Acetate</option>
                    <option value="Denosumab">Denosumab</option>
                  </select>
                </div>

                <div class="form-group">
                  <label for="team-id">
                    <i class="fas fa-users" aria-hidden="true"></i>
                    Team ID
                  </label>
                  <select id="team-id" name="team_id" required>
                    <option value="">Select Team ID</option>
                    <option value="198">198</option>
                    <option value="209">209</option>
                  </select>
                </div>

                <div class="form-group">
                  <label for="quarter">
                    <i class="fas fa-calendar" aria-hidden="true"></i>
                    Quarter
                  </label>
                  <select id="quarter" name="quarter" required>
                    <option value="">Select Quarter</option>
                    <option value="1">Quarter 4 2024</option>
                    <option value="2">Quarter 1 2025</option>
                    <option value="3">Quarter 2 2025</option>
                    <option value="4">Quarter 3 2025</option>
                    <option value="5">Quarter 4 2025</option>
                  </select>
                </div>
              </form>
            </div>

            <div class="card-actions">
              <button 
                id="trigger-validation" 
                class="btn-primary-large"
                type="button"
                aria-label="Start auto ranking workflow">
                <i class="fas fa-play-circle" aria-hidden="true"></i> 
                <span>Start Ranking</span>
              </button>
            </div>
          </article>

          <div id="loading-overlay" class="loading-overlay" style="display: none;" role="dialog" aria-hidden="true">
            <div class="loading-content">
              <div class="loading-spinner" aria-hidden="true">
                <i class="fas fa-spinner fa-spin"></i>
              </div>
              <h3>Processing Ranking</h3>
              <p>Please wait while we fetch and process your rankings...</p>
              <div class="progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-fill" id="progress-fill"></div>
              </div>
            </div>
          </div>

          <div id="result-message" class="result-message" style="display: none;" role="alert">
            <div class="result-content">
              <div class="result-icon" id="result-icon" aria-hidden="true"></div>
              <h3 id="result-title"></h3>
              <p id="result-text"></p>
            </div>
          </div>
        </section>
      </div>
    </main>
  </div>

  <style>
    * {
      box-sizing: border-box;
    }

    :root {
      --primary: #4361ee;
      --primary-light: #6c8aff;
      --primary-dark: #3a56d4;
      --secondary: #7209b7;
      --accent: #4cc9f0;
      --danger: #f72585;
      --warning: #ff9e00;
      --success: #06d6a0;
      --light: #f8f9fc;
      --dark: #2b2d42;
      --gray: #8d99ae;
      --border-radius: 16px;
      --shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      --transition: all 0.4s ease;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Inter', 'Segoe UI', sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1rem;
    }

    .auto-validation-page {
      min-height: 100vh;
      background: linear-gradient(135deg, #f5f7ff 0%, #f0f4ff 100%);
      font-family: 'Inter', 'Segoe UI', sans-serif;
      color: var(--dark);
    }

    .page-header {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      padding: 1rem 0;
      border-bottom: 1px solid rgba(0, 0, 0, 0.05);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .back-link {
      flex-shrink: 0;
      order: 1;
    }

    .page-title {
      flex: 1 1 100%;
      text-align: center;
      order: 3;
      min-width: 250px;
    }

    .page-actions {
      flex-shrink: 0;
      order: 2;
    }

    .btn-back, .btn-secondary {
      background: transparent;
      border: 2px solid;
      border-radius: 50px;
      padding: 0.6rem 1.5rem;
      font-weight: 600;
      text-decoration: none;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      white-space: nowrap;
      font-size: 0.9rem;
    }

    .btn-back {
      border-color: var(--primary);
      color: var(--primary);
    }

    .btn-back:hover {
      background: var(--primary);
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 6px 15px rgba(67, 97, 238, 0.3);
      text-decoration: none;
    }

    .btn-secondary {
      border-color: var(--secondary);
      color: var(--secondary);
    }

    .btn-secondary:hover {
      background: var(--secondary);
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 6px 15px rgba(114, 9, 183, 0.3);
      text-decoration: none;
    }

    .page-title h1 {
      font-weight: 800;
      font-size: clamp(1.75rem, 5vw, 2.5rem);
      margin-bottom: 0.25rem;
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-align: center;
    }

    .page-title p {
      color: var(--gray);
      font-size: clamp(0.9rem, 2vw, 1.1rem);
      text-align: center;
      margin: 0;
      line-height: 1.4;
    }

    .main-content {
      padding: 2rem 1rem;
    }

    .validation-section {
      max-width: 800px;
      margin: 0 auto;
    }

    .validation-card {
      background: white;
      border-radius: var(--border-radius);
      padding: 2rem 1.5rem;
      box-shadow: var(--shadow);
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .card-icon {
      width: clamp(80px, 15vw, 120px);
      height: clamp(80px, 15vw, 120px);
      border-radius: 50%;
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
      color: white;
      font-size: clamp(2rem, 5vw, 3rem);
    }

    .card-content h2 {
      font-weight: 700;
      font-size: clamp(1.5rem, 4vw, 2.5rem);
      margin-bottom: 1rem;
      color: var(--dark);
    }

    .card-content p {
      color: var(--gray);
      font-size: clamp(0.95rem, 2.5vw, 1.1rem);
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }

    .process-steps {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1rem;
      margin-bottom: 2rem;
      flex-wrap: wrap;
    }

    .step {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      flex: 0 1 auto;
    }

    .step i {
      font-size: clamp(1.2rem, 3vw, 1.8rem);
      color: var(--primary);
    }

    .step span {
      font-weight: 600;
      color: var(--dark);
      font-size: clamp(0.85rem, 1.5vw, 0.95rem);
      text-align: center;
      max-width: 80px;
    }

    .card-actions {
      margin-top: 1.5rem;
    }

    .btn-primary-large {
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      border: none;
      color: white;
      border-radius: 50px;
      padding: clamp(0.8rem, 2vw, 1.2rem) clamp(2rem, 5vw, 3rem);
      font-weight: 700;
      font-size: clamp(1rem, 2.5vw, 1.2rem);
      cursor: pointer;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      box-shadow: 0 6px 20px rgba(67, 97, 238, 0.3);
      width: 100%;
      max-width: 400px;
    }

    .btn-primary-large:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 30px rgba(67, 97, 238, 0.4);
    }

    .btn-primary-large:active {
      transform: translateY(-1px);
    }

    .btn-primary-large:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    .filter-section {
      background: linear-gradient(135deg, rgba(67, 97, 238, 0.05) 0%, rgba(114, 9, 183, 0.05) 100%);
      border: 2px solid rgba(67, 97, 238, 0.1);
      border-radius: 12px;
      padding: 2rem 1.5rem;
      margin: 2rem 0;
    }

    .filter-section h3 {
      font-weight: 700;
      font-size: 1.2rem;
      color: var(--dark);
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .filters-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
    }

    .form-group label {
      font-weight: 600;
      color: var(--dark);
      margin-bottom: 0.5rem;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .form-group label i {
      color: var(--primary);
      font-size: 1rem;
    }

    .form-group select {
      padding: 0.75rem 1rem;
      border: 2px solid #e0e0e0;
      border-radius: 8px;
      font-size: 0.95rem;
      font-family: inherit;
      color: var(--dark);
      background: white;
      cursor: pointer;
      transition: var(--transition);
    }

    .form-group select:hover {
      border-color: var(--primary);
    }

    .form-group select:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
      background: white;
    }

    .form-group.error select {
      border-color: var(--danger);
      box-shadow: 0 0 0 3px rgba(247, 37, 133, 0.1);
    }

    .form-group.success select {
      border-color: var(--success);
    }

    .loading-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.8);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      padding: 1rem;
    }

    .loading-content {
      background: white;
      border-radius: var(--border-radius);
      padding: clamp(2rem, 5vw, 3rem);
      text-align: center;
      max-width: 400px;
      width: 100%;
    }

    .loading-spinner {
      font-size: clamp(2.5rem, 8vw, 4rem);
      color: var(--primary);
      margin-bottom: 1rem;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .loading-content h3 {
      font-weight: 700;
      font-size: clamp(1.2rem, 3vw, 1.5rem);
      margin-bottom: 0.75rem;
      color: var(--dark);
    }

    .loading-content p {
      color: var(--gray);
      font-size: clamp(0.9rem, 2vw, 1rem);
      margin-bottom: 1.5rem;
      line-height: 1.5;
    }

    .progress-bar {
      width: 100%;
      height: 8px;
      background: #e0e0e0;
      border-radius: 4px;
      overflow: hidden;
      margin-top: 1rem;
    }

    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--primary) 0%, var(--secondary) 100%);
      width: 0%;
      transition: width 0.3s ease;
      border-radius: 4px;
    }

    .result-message {
      margin-top: 1.5rem;
      background: white;
      border-radius: var(--border-radius);
      padding: 2rem 1.5rem;
      box-shadow: var(--shadow);
      text-align: center;
      animation: slideUp 0.5s ease-out;
    }

    @keyframes slideUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .result-content h3 {
      font-weight: 700;
      font-size: clamp(1.2rem, 3vw, 1.5rem);
      margin-bottom: 0.75rem;
      color: var(--dark);
    }

    .result-content p {
      color: var(--gray);
      font-size: clamp(0.9rem, 2vw, 1rem);
      margin: 0;
      line-height: 1.5;
    }

    .result-icon {
      font-size: clamp(2.5rem, 8vw, 3.5rem);
      margin-bottom: 1rem;
    }

    .result-success .result-icon {
      color: var(--success);
    }

    .result-error .result-icon {
      color: var(--danger);
    }

    @media (min-width: 769px) {
      .header-content { flex-wrap: nowrap; }
      .page-title { order: 2; flex: 1; margin: 0; }
      .back-link { order: 1; }
      .page-actions { order: 3; }
      .main-content { padding: 4rem 1rem; }
      .validation-card { padding: 3rem 2rem; }
      .process-steps { gap: 2rem; margin-bottom: 3rem; }
      .btn-primary-large { width: auto; padding: 1rem 3rem; }
    }

    @media (max-width: 768px) {
      .page-title { order: 2; margin-top: 0; }
      .filters-grid { grid-template-columns: 1fr; }
    }
  </style>

  <script>
    $(document).ready(function() {
      const $button = $('#trigger-validation');
      const $overlay = $('#loading-overlay');
      const $resultMessage = $('#result-message');
      const $progressFill = $('#progress-fill');
      const $form = $('#validation-filters');
      
      let requestInProgress = false;

      $button.on('click', function(e) {
        e.preventDefault();
        if (requestInProgress) return;
        if (!validateForm()) return;
        
        requestInProgress = true;
        startValidation();
      });

      function validateForm() {
        let isValid = true;
        $form.find('select').each(function() {
          const $select = $(this);
          const $group = $select.closest('.form-group');
          if (!$select.val()) {
            $group.addClass('error');
            isValid = false;
          } else {
            $group.removeClass('error');
          }
        });

        if (!isValid) {
          showErrorMessage('Please fill in all filter fields');
        }
        return isValid;
      }

      function startValidation() {
        const originalHTML = $button.html();

        $button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Processing...');
        $overlay.fadeIn(300);
        $resultMessage.hide();
        $progressFill.css('width', '0%');

        const genericNameGroup = $('#generic-name-group').val();
        const teamId = $('#team-id').val();
        const quarter = $('#quarter').val();

        let progress = 0;
        const progressInterval = setInterval(function() {
          progress += Math.random() * 20;
          if (progress > 85) progress = 85;
          $progressFill.css('width', progress + '%');
        }, 600);

        const apiUrl = `/api/auto_rankings/validate?generic_name_group=${encodeURIComponent(genericNameGroup)}&team_id=${encodeURIComponent(teamId)}&quarter=${encodeURIComponent(quarter)}`;

        $.ajax({
          url: apiUrl,
          method: 'GET',
          timeout: 300000,
          dataType: 'json',
          success: function(response) {
            handleSuccess(progressInterval, originalHTML, response);
          },
          error: function(xhr, status, error) {
            handleError(progressInterval, originalHTML, xhr, status);
          },
          complete: function() {
            requestInProgress = false;
          }
        });
      }

      function handleSuccess(progressInterval, originalHTML, response) {
        clearInterval(progressInterval);
        $progressFill.css('width', '100%');

        setTimeout(function() {
          $overlay.fadeOut(300);
          $button.prop('disabled', false).html(originalHTML);

          $resultMessage.removeClass('result-error').addClass('result-success');
          $('#result-icon').html('<i class="fas fa-check-circle"></i>');
          $('#result-title').text('✓ Ranking Completed');
          $('#result-text').text(response.message || 'Excel file processed successfully. Redirecting to results...');
          $resultMessage.fadeIn(300);

          setTimeout(function() {
            window.location.href = '/auto_ranking/results';
          }, 2500);
        }, 800);
      }

      function handleError(progressInterval, originalHTML, xhr, status) {
        clearInterval(progressInterval);
        $progressFill.css('width', '0%');

        setTimeout(function() {
          $overlay.fadeOut(300);
          $button.prop('disabled', false).html(originalHTML);

          let errorMessage = 'An error occurred during ranking processing.';
          if (status === 'timeout') {
            errorMessage = 'Request timed out. Please try again.';
          } else if (xhr.responseJSON && xhr.responseJSON.error) {
            errorMessage = xhr.responseJSON.error;
          } else if (xhr.status === 0) {
            errorMessage = 'Network error. Please check your connection.';
          } else if (xhr.status >= 500) {
            errorMessage = 'Server error. Please try again later.';
          }

          $resultMessage.removeClass('result-success').addClass('result-error');
          $('#result-icon').html('<i class="fas fa-exclamation-triangle"></i>');
          $('#result-title').text('✗ Ranking Failed');
          $('#result-text').text(errorMessage);
          $resultMessage.fadeIn(300);
        }, 500);
      }

      function showErrorMessage(message) {
        $resultMessage.removeClass('result-success').addClass('result-error');
        $('#result-icon').html('<i class="fas fa-exclamation-circle"></i>');
        $('#result-title').text('⚠ Parameters Required');
        $('#result-text').text(message);
        $resultMessage.fadeIn(300);
        setTimeout(function() { $resultMessage.fadeOut(300); }, 4000);
      }

      $form.find('select').on('change', function() {
        $(this).closest('.form-group').removeClass('error');
      });
    });
  </script>
</body>
</html>
