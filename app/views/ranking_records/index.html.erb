<div class="upload-container rrk-page">
  <header class="header">
    <div class="header-content">
      <div class="header-text">
        <h1>Rankings validation</h1>
        <p>Upload a ranking sheet and compare it against payor preferences</p>
      </div>
      <%= link_to features_path, class: "back-btn" do %>
        <i class="fas fa-arrow-left"></i> Back to Dashboard
      <% end %>
    </div>
  </header>

  <% if flash[:alert] || flash[:notice] %>
    <div class="flash-messages">
      <% if flash[:alert] %>
        <div class="flash-message alert">
          <i class="fas fa-exclamation-triangle"></i>
          <%= flash[:alert] %>
        </div>
      <% end %>
      <% if flash[:notice] %>
        <div class="flash-message notice">
          <i class="fas fa-check-circle"></i>
          <%= flash[:notice] %>
        </div>
      <% end %>
    </div>
  <% end %>

  <section class="rrk-card rrk-card--cta">
    <div class="rrk-card-icon"><i class="fas fa-cloud-upload-alt"></i></div>
    <div class="rrk-card-body">
      <h2>New validation run</h2>
      <p>Each upload replaces your previous result for your account.</p>
      <%= link_to new_ranking_record_path, class: "rrk-btn rrk-btn--primary" do %>
        <i class="fas fa-file-excel"></i> Upload ranking sheet
      <% end %>
    </div>
  </section>

  <% if @record.present? %>
    <section class="rrk-card">
      <h2><i class="fas fa-clipboard-check"></i> Latest result</h2>
      <p class="rrk-meta">
        <i class="fas fa-clock"></i>
        <%= @record.created_at.strftime("%b %d, %Y at %l:%M %p") %>
        <% if @record.user_email.present? %>
          <span class="rrk-meta-sep">·</span>
          <%= @record.user_email %>
        <% end %>
      </p>
      <% row_count = @record.total_ranking_row_count %>
      <% payor_count = @record.max_ranking_payor_columns %>
      <div class="rrk-pills">
        <span class="rrk-pill"><%= number_with_delimiter(row_count) %> rows</span>
        <span class="rrk-pill"><%= number_with_delimiter(payor_count) %> payor columns</span>
      </div>
      <%= link_to ranking_record_path(@record), class: "rrk-btn rrk-btn--accent" do %>
        <i class="fas fa-table"></i> View validation grid
      <% end %>
    </section>
  <% else %>
    <section class="rrk-card rrk-card--empty">
      <div class="rrk-empty-icon"><i class="fas fa-inbox"></i></div>
      <h3>No validation yet</h3>
      <p>Upload your first insurance ranking file to see results here.</p>
    </section>
  <% end %>
</div>

<style>
  body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    font-family: "Inter", "Segoe UI", Roboto, sans-serif;
    background: radial-gradient(circle at top left, rgba(67, 97, 238, 0.14), transparent 28%),
                radial-gradient(circle at bottom right, rgba(114, 9, 183, 0.12), transparent 35%),
                linear-gradient(180deg, #edf2ff 0%, #f8fafc 100%);
    color: #2b2d42;
  }

  .upload-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 3rem;
    min-height: 100vh;
    box-sizing: border-box;
  }

  .rrk-page {
    --primary: #4361ee;
    --primary-light: #6c8aff;
    --secondary: #7209b7;
    --accent: #4cc9f0;
    --success: #06d6a0;
    --danger: #f72585;
    --light: #f8f9fc;
    --dark: #2b2d42;
    --gray: #8d99ae;
    --border-radius: 22px;
    --shadow: 0 28px 80px rgba(15, 23, 42, 0.12);
    --transition: all 0.3s ease;
    width: 100%;
    position: relative;
    background: rgba(255, 255, 255, 0.98);
    border-radius: 32px;
    padding: 2rem;
    box-shadow: var(--shadow);
    border: 1px solid rgba(226, 232, 240, 0.85);
    backdrop-filter: blur(16px);
    overflow: hidden;
  }

  .rrk-page::before {
    content: "";
    position: absolute;
    left: 50%;
    top: -80px;
    transform: translateX(-50%);
    width: 640px;
    height: 260px;
    background: radial-gradient(circle, rgba(67, 97, 238, 0.16), transparent 50%);
    pointer-events: none;
    filter: blur(32px);
  }

  .rrk-page .header {
    background: transparent;
    box-shadow: none;
    border-radius: 22px;
    padding: 1.75rem 1.5rem;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(226, 232, 240, 0.9);
    display: grid;
    gap: 1rem;
  }

  .rrk-page .header-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .rrk-page .header-text h1 {
    font-weight: 800;
    font-size: clamp(1.45rem, 4vw, 2rem);
    margin: 0 0 0.35rem;
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .rrk-page .header-text p {
    margin: 0;
    color: var(--gray);
    font-size: 1rem;
    line-height: 1.5;
  }

  .rrk-page .back-btn {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    color: white;
    border-radius: 50px;
    padding: 0.65rem 1.25rem;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 6px 20px rgba(67, 97, 238, 0.3);
    transition: var(--transition);
  }

  .rrk-page .back-btn:hover {
    transform: translateY(-2px);
    color: white;
    text-decoration: none;
  }

  .flash-messages { margin-bottom: 1.25rem; }

  .flash-message {
    padding: 1rem 1.25rem;
    border-radius: var(--border-radius);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .flash-message.alert {
    background: rgba(247, 37, 133, 0.1);
    border-left: 4px solid var(--danger);
    color: #9d174d;
  }

  .flash-message.notice {
    background: rgba(6, 214, 160, 0.1);
    border-left: 4px solid var(--success);
    color: #047857;
  }

  .rrk-card {
    background: white;
    border-radius: var(--border-radius);
    padding: 1.75rem;
    margin-bottom: 1.25rem;
    box-shadow: 0 20px 44px rgba(15, 23, 42, 0.08);
    border: 1px solid rgba(226, 232, 240, 0.85);
  }

  .rrk-card--cta {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    border-top-color: var(--success);
    padding: 1.75rem;
    flex-wrap: wrap;
  }

  .rrk-card-icon {
    width: 64px;
    height: 64px;
    border-radius: 20px;
    background: linear-gradient(135deg, var(--success), #05c291);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    flex-shrink: 0;
    box-shadow: 0 12px 30px rgba(6, 214, 160, 0.2);
  }

  .rrk-card-body {
    flex: 1;
    min-width: 220px;
  }

  .rrk-card-body h2 {
    margin: 0 0 0.35rem;
    font-size: 1.4rem;
    color: var(--dark);
  }

  .rrk-card-body p {
    margin: 0 0 1.25rem;
    color: var(--gray);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .rrk-card h2 {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
    color: var(--dark);
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .rrk-meta {
    margin: 0 0 1.2rem;
    color: var(--gray);
    font-size: 0.95rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .rrk-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .rrk-pill {
    background: rgba(67, 97, 238, 0.07);
    color: var(--dark);
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .rrk-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    border-radius: 999px;
    padding: 0.8rem 1.35rem;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: var(--transition);
  }

  .rrk-btn--primary {
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    color: #fff;
    box-shadow: 0 12px 28px rgba(67, 97, 238, 0.2);
  }

  .rrk-btn--accent {
    background: linear-gradient(135deg, var(--accent), #06b6d4);
    color: #fff;
    box-shadow: 0 12px 28px rgba(76, 201, 240, 0.2);
  }

  .rrk-btn:hover {
    transform: translateY(-2px);
    color: #fff;
    text-decoration: none;
  }

  .rrk-card--empty {
    text-align: center;
    border-top-color: var(--gray);
    padding: 2.5rem 1.5rem;
  }

  .rrk-empty-icon {
    width: 72px;
    height: 72px;
    margin: 0 auto 1rem;
    border-radius: 22px;
    background: rgba(67, 97, 238, 0.08);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
  }

  .rrk-card--empty h3 {
    margin: 0 0 0.75rem;
    color: var(--dark);
    font-size: 1.35rem;
  }

  .rrk-card--empty p {
    margin: 0;
    color: var(--gray);
    font-size: 1rem;
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .upload-container {
      padding: 1.5rem 1rem 2rem;
    }

    .rrk-page {
      padding: 1.5rem;
      border-radius: 24px;
    }

    .rrk-page::before {
      display: none;
    }

    .rrk-page .header {
      padding: 1.5rem 1.25rem;
    }

    .rrk-page .header-content {
      flex-direction: column;
      align-items: stretch;
    }

    .rrk-card--cta {
      flex-direction: column;
      align-items: stretch;
    }

    .rrk-card-body {
      min-width: auto;
    }

    .rrk-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
