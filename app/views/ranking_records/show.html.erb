<%
  all_rows = @sheet_sections.flat_map { |s| Array(s["rows"]) }
  failure_cells = all_rows.sum { |row| Array(row["cells"]).count { |c| c["status"].to_s == "failure" } }
  total_cells = all_rows.sum { |row| Array(row["cells"]).size }
  success_cells = [total_cells - failure_cells, 0].max
%>

<div class="upload-container rrk-show">
  <header class="header">
    <div class="header-content">
      <div class="header-text">
        <h1>Ranking validation results</h1>
        <p>Actual vs expected marks per payor column<% if @sheet_sections.size > 1 %> — <%= @sheet_sections.size %> sheets<% end %></p>
      </div>
      <div class="rrk-show-actions">
        <%= link_to ranking_records_path, class: "back-btn back-btn--ghost" do %>
          <i class="fas fa-list"></i> Summary
        <% end %>
        <%= link_to new_ranking_record_path, class: "back-btn" do %>
          <i class="fas fa-cloud-upload-alt"></i> New upload
        <% end %>
      </div>
    </div>
  </header>

  <% if flash[:notice] %>
    <div class="flash-messages">
      <div class="flash-message notice">
        <i class="fas fa-check-circle"></i>
        <%= flash[:notice] %>
      </div>
    </div>
  <% end %>

  <section class="rrk-stats" aria-label="Summary">
    <div class="rrk-stat">
      <span class="rrk-stat-num"><%= number_with_delimiter(@sheet_sections.size) %></span>
      <span class="rrk-stat-label">Sheets</span>
    </div>
    <div class="rrk-stat">
      <span class="rrk-stat-num"><%= number_with_delimiter(all_rows.size) %></span>
      <span class="rrk-stat-label">Product rows</span>
    </div>
    <div class="rrk-stat rrk-stat--ok">
      <span class="rrk-stat-num"><%= number_with_delimiter(success_cells) %></span>
      <span class="rrk-stat-label">Matching cells</span>
    </div>
    <div class="rrk-stat <%= failure_cells.positive? ? "rrk-stat--bad" : "" %>">
      <span class="rrk-stat-num"><%= number_with_delimiter(failure_cells) %></span>
      <span class="rrk-stat-label">Mismatches</span>
    </div>
  </section>

  <section class="rrk-table-card rrk-lookup-card">
    <h2 class="rrk-sheet-title">
      <i class="fas fa-search"></i>
      Insurance Lookup
      <span class="rrk-sheet-meta">Generic group + payor</span>
    </h2>
    <p class="rrk-hint">
      <i class="fas fa-info-circle"></i>
      Enter a generic name group and payor to fetch insurances from <code>PayorPreference</code>.
    </p>
    <form id="rrkLookupForm" class="rrk-lookup-form">
      <input id="rrkLookupGroup" class="rrk-lookup-input" placeholder="Generic group (e.g. BENDAMUSTINE)" required />
      <input id="rrkLookupPayor" class="rrk-lookup-input" placeholder="Payor (e.g. PACIFICSOURCE MEDICARE ADVANTAGE)" required />
      <button type="submit" id="rrkLookupBtn" class="rrk-lookup-btn">
        <i class="fas fa-database"></i> Get Insurances
      </button>
    </form>
    <div id="rrkLookupResult" class="rrk-lookup-result" style="display:none;"></div>
  </section>

  <% @sheet_sections.each_with_index do |section, idx| %>
    <% headers = Array(section["headers"]) %>
    <% rows = Array(section["rows"]) %>
    <section class="rrk-table-card rrk-sheet-block">
      <h2 class="rrk-sheet-title">
        <i class="fas fa-table"></i>
        <%= section["sheet_name"].presence || "Sheet #{idx + 1}" %>
        <span class="rrk-sheet-meta"><%= number_with_delimiter(rows.size) %> rows · <%= number_with_delimiter(headers.size) %> payors</span>
      </h2>
      <p class="rrk-hint">
        <i class="fas fa-info-circle"></i>
        Expected <strong>✔</strong> means a numeric rank is allowed (brand in parentheses is on the payor’s insurance list); expected <strong>X</strong> means the cell should be X (no rank). Green = matches that rule; red = mismatch. Scroll horizontally for all payors.
      </p>
      <div class="rrk-scroll">
        <table class="rrk-table">
          <thead>
            <tr>
              <th class="rrk-th-sticky">Generic name</th>
              <% headers.each do |payor| %>
                <th class="rrk-th-payor"><%= payor %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% rows.each do |row| %>
              <tr>
                <td class="rrk-td-name"><%= row["generic_name"] %></td>
                <% Array(row["cells"]).each_with_index do |cell, col_idx| %>
                  <% payor_header = headers[col_idx].to_s %>
                  <% trace_id = "trace-#{Digest::MD5.hexdigest("#{section["sheet_name"]}-#{row["generic_name"]}-#{payor_header}")}" %>
                  <td class="rrk-cell rrk-cell--<%= cell["status"].presence || "failure" %>">
                    <a href="#<%= trace_id %>" class="rrk-cell-link" title="Click to see backend trace">
                      <span class="rrk-actual"><%= cell["actual"] %></span>
                      <span class="rrk-expected">Expected: <%= cell["expected"] %></span>
                    </a>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <% if @debug_mismatches.present? %>
    <section class="rrk-table-card rrk-debug-card">
      <h2 class="rrk-sheet-title">
        <i class="fas fa-bug"></i>
        Validation Debug (Mismatches)
        <span class="rrk-sheet-meta"><%= number_with_delimiter(@debug_mismatches.size) %> cells</span>
      </h2>
      <div class="rrk-scroll">
        <table class="rrk-table rrk-debug-table">
          <thead>
            <tr>
              <th>Sheet</th>
              <th>Row</th>
              <th>Generic Name</th>
              <th>Payor Header</th>
              <th>Payor Lookup</th>
              <th>Brand Token</th>
              <th>Actual</th>
              <th>Expected</th>
              <th>Allowed Insurances</th>
            </tr>
          </thead>
          <tbody>
            <% @debug_mismatches.each do |m| %>
              <% trace_id = "trace-#{Digest::MD5.hexdigest("#{m["sheet_name"]}-#{m["generic_name"]}-#{m["payor_header"]}")}" %>
              <tr class="rrk-clickable-row" onclick="window.location.hash='<%= trace_id %>';" title="Click to see backend trace">
                <td><%= m["sheet_name"] %></td>
                <td><%= m["row_number"] %></td>
                <td><%= m["generic_name"] %></td>
                <td><%= m["payor_header"] %></td>
                <td><%= m["payor_lookup"] %></td>
                <td><%= m["brand_token"] || "—" %></td>
                <td><%= m["actual"] %></td>
                <td><%= m["expected"] %></td>
                <td><%= Array(m["allowed_insurances"]).join(", ") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <% if @debug_cells.present? %>
    <section class="rrk-table-card rrk-debug-card">
      <h2 class="rrk-sheet-title">
        <i class="fas fa-flask"></i>
        Full Backend Validation Trace
        <span class="rrk-sheet-meta"><%= number_with_delimiter(@debug_cells.size) %> cells</span>
      </h2>
      <p class="rrk-hint">
        <i class="fas fa-info-circle"></i>
        This is the direct backend decision per cell (status + reason + allowed insurances).
      </p>
      <div class="rrk-scroll">
        <table class="rrk-table rrk-debug-table">
          <thead>
            <tr>
              <th>Sheet</th>
              <th>Row</th>
              <th>Generic Name</th>
              <th>Payor Header</th>
              <th>Status</th>
              <th>Reason</th>
              <th>Actual</th>
              <th>Expected</th>
              <th>Brand Token</th>
              <th>Allowed Insurances</th>
            </tr>
          </thead>
          <tbody>
            <% @debug_cells.each do |m| %>
              <% trace_id = "trace-#{Digest::MD5.hexdigest("#{m["sheet_name"]}-#{m["generic_name"]}-#{m["payor_header"]}")}" %>
              <tr id="<%= trace_id %>" class="rrk-trace-row">
                <td><%= m["sheet_name"] %></td>
                <td><%= m["row_number"] %></td>
                <td><%= m["generic_name"] %></td>
                <td><%= m["payor_header"] %></td>
                <td>
                  <span class="<%= m["status"] == "success" ? "rrk-badge-success" : "rrk-badge-failure" %>">
                    <%= m["status"] %>
                  </span>
                </td>
                <td><%= m["reason"] %></td>
                <td><%= m["actual"] %></td>
                <td><%= m["expected"] %></td>
                <td><%= m["brand_token"] || "—" %></td>
                <td><%= Array(m["allowed_insurances"]).join(", ") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    var form = document.getElementById("rrkLookupForm");
    if (!form) return;

    var groupInput = document.getElementById("rrkLookupGroup");
    var payorInput = document.getElementById("rrkLookupPayor");
    var btn = document.getElementById("rrkLookupBtn");
    var result = document.getElementById("rrkLookupResult");

    form.addEventListener("submit", function (e) {
      e.preventDefault();

      var genericGroup = (groupInput.value || "").trim();
      var payor = (payorInput.value || "").trim();
      if (!genericGroup || !payor) return;

      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Fetching...';

      fetch("<%= lookup_insurances_ranking_records_path %>", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({
          generic_name_group: genericGroup,
          payor: payor,
          accounting_period_id: 6
        })
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var parsed = Array.isArray(data.parsed_insurances) ? data.parsed_insurances : [];
          var raw = Array.isArray(data.raw_insurances) ? data.raw_insurances : [];

          result.style.display = "block";
          result.innerHTML =
            "<h4>Lookup Result</h4>" +
            "<p><strong>Generic Group:</strong> " + data.generic_name_group + "</p>" +
            "<p><strong>Payor:</strong> " + data.payor + "</p>" +
            "<p><strong>Found Records:</strong> " + data.found_records + "</p>" +
            "<p><strong>Parsed Insurances:</strong> " + (parsed.length ? parsed.join(", ") : "None") + "</p>" +
            "<details><summary>Raw DB values</summary><pre>" + JSON.stringify(raw, null, 2) + "</pre></details>";
        })
        .catch(function () {
          result.style.display = "block";
          result.innerHTML = "<p class='rrk-lookup-error'>Lookup failed. Please try again.</p>";
        })
        .finally(function () {
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-database"></i> Get Insurances';
        });
    });
  });
</script>

<style>
  .rrk-show {
    --primary: #4361ee;
    --primary-light: #6c8aff;
    --secondary: #7209b7;
    --accent: #4cc9f0;
    --success: #06d6a0;
    --danger: #f72585;
    --light: #f8f9fc;
    --dark: #2b2d42;
    --gray: #8d99ae;
    --border-radius: 16px;
    --shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    --transition: all 0.3s ease;
    max-width: 100%;
    margin: 0 auto;
    padding: 2rem;
    font-family: "Inter", "Segoe UI", Roboto, sans-serif;
    color: var(--dark);
    background: linear-gradient(135deg, #f5f7ff 0%, #f0f4ff 100%);
    min-height: calc(100vh - 20px);
    box-sizing: border-box;
  }

  .rrk-show .header {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-radius: var(--border-radius);
    padding: 2rem;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow);
    border: 1px solid rgba(255, 255, 255, 0.8);
  }

  .rrk-show .header-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .rrk-show .header-text h1 {
    font-weight: 800;
    font-size: clamp(1.45rem, 4vw, 2rem);
    margin: 0 0 0.35rem;
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .rrk-show .header-text p {
    margin: 0;
    color: var(--gray);
    font-size: 1rem;
  }

  .rrk-show-actions {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    align-items: flex-end;
  }

  .rrk-show .back-btn {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    color: white;
    border-radius: 50px;
    padding: 0.6rem 1.2rem;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    box-shadow: 0 6px 20px rgba(67, 97, 238, 0.3);
    transition: var(--transition);
    font-size: 0.88rem;
    white-space: nowrap;
  }

  .rrk-show .back-btn--ghost {
    background: transparent;
    color: var(--primary);
    border: 2px solid var(--primary);
    box-shadow: none;
  }

  .rrk-show .back-btn--ghost:hover {
    background: var(--primary);
    color: #fff;
  }

  .rrk-show .back-btn:hover {
    transform: translateY(-2px);
    color: white;
    text-decoration: none;
  }

  .flash-messages { margin-bottom: 1.25rem; }

  .flash-message {
    padding: 1rem 1.25rem;
    border-radius: var(--border-radius);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(6, 214, 160, 0.1);
    border-left: 4px solid var(--success);
    color: #047857;
  }

  .rrk-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .rrk-stat {
    background: #fff;
    border-radius: var(--border-radius);
    padding: 1.25rem;
    box-shadow: var(--shadow);
    border-top: 3px solid var(--primary);
    text-align: center;
  }

  .rrk-stat--ok {
    border-top-color: var(--success);
  }

  .rrk-stat--bad {
    border-top-color: var(--danger);
  }

  .rrk-stat-num {
    display: block;
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--dark);
    line-height: 1.1;
  }

  .rrk-stat-label {
    font-size: 0.85rem;
    color: var(--gray);
    font-weight: 600;
  }

  .rrk-table-card {
    background: #fff;
    border-radius: var(--border-radius);
    padding: 1.5rem;
    box-shadow: var(--shadow);
    border-top: 4px solid var(--primary);
  }

  .rrk-lookup-card {
    border-top-color: var(--secondary);
    margin-bottom: 1.5rem;
  }

  .rrk-lookup-form {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 0.75rem;
    align-items: center;
  }

  .rrk-lookup-input {
    border: 1px solid rgba(142, 153, 175, 0.5);
    border-radius: 10px;
    padding: 0.7rem 0.9rem;
    font-size: 0.92rem;
    width: 100%;
  }

  .rrk-lookup-input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.12);
  }

  .rrk-lookup-btn {
    background: linear-gradient(135deg, var(--accent), #06b6d4);
    color: #fff;
    border: none;
    border-radius: 999px;
    padding: 0.7rem 1.15rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }

  .rrk-lookup-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .rrk-lookup-result {
    margin-top: 1rem;
    background: var(--light);
    border-left: 4px solid var(--primary);
    border-radius: 10px;
    padding: 0.9rem 1rem;
    font-size: 0.9rem;
    color: var(--dark);
  }

  .rrk-lookup-result h4 {
    margin: 0 0 0.5rem;
  }

  .rrk-lookup-result p {
    margin: 0.3rem 0;
  }

  .rrk-lookup-result pre {
    margin: 0.65rem 0 0;
    white-space: pre-wrap;
    background: #fff;
    border: 1px solid rgba(142, 153, 175, 0.35);
    border-radius: 8px;
    padding: 0.55rem;
    font-size: 0.78rem;
  }

  .rrk-lookup-error {
    color: #9d174d;
    margin: 0;
  }

  .rrk-sheet-block {
    margin-bottom: 1.5rem;
  }

  .rrk-sheet-block:last-child {
    margin-bottom: 0;
  }

  .rrk-debug-card {
    margin-top: 1.5rem;
    border-top-color: var(--danger);
  }

  .rrk-sheet-title {
    margin: 0 0 0.75rem;
    font-size: 1.1rem;
    color: var(--dark);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .rrk-sheet-title i {
    color: var(--primary);
  }

  .rrk-sheet-meta {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--gray);
  }

  .rrk-hint {
    margin: 0 0 1rem;
    font-size: 0.88rem;
    color: var(--gray);
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    line-height: 1.45;
  }

  .rrk-hint i {
    color: var(--accent);
    margin-top: 0.12rem;
  }

  .rrk-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: 12px;
    border: 1px solid rgba(67, 97, 238, 0.12);
    max-height: min(70vh, 880px);
    overflow-y: auto;
  }

  .rrk-table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.78rem;
    min-width: 640px;
  }

  .rrk-table th {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    color: #fff;
    padding: 0.65rem 0.6rem;
    font-weight: 700;
    text-align: center;
    border-bottom: 2px solid rgba(255, 255, 255, 0.25);
    border-right: 1px solid rgba(255, 255, 255, 0.2);
    position: sticky;
    top: 0;
    z-index: 2;
    vertical-align: bottom;
    /* Long payor names: wrap instead of clipping */
    white-space: normal;
    word-break: break-word;
    overflow-wrap: anywhere;
    line-height: 1.35;
    min-width: 5.5rem;
    max-width: none;
    box-sizing: border-box;
  }

  .rrk-table th:last-child {
    border-right: none;
  }

  .rrk-debug-table td {
    border: 1px solid rgba(142, 153, 175, 0.35);
    padding: 0.45rem 0.55rem;
    font-size: 0.76rem;
    vertical-align: top;
    background: #fff;
    white-space: normal;
    word-break: break-word;
  }

  .rrk-badge-success,
  .rrk-badge-failure {
    display: inline-block;
    border-radius: 999px;
    padding: 0.15rem 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .rrk-badge-success {
    background: rgba(6, 214, 160, 0.18);
    color: #047857;
  }

  .rrk-badge-failure {
    background: rgba(247, 37, 133, 0.18);
    color: #9d174d;
  }

  .rrk-th-sticky {
    left: 0;
    z-index: 4;
    text-align: left;
    min-width: 11rem;
    max-width: none;
    white-space: normal;
    word-break: break-word;
    overflow-wrap: break-word;
    box-shadow: 4px 0 12px -6px rgba(0, 0, 0, 0.15);
  }

  /* Payor columns: room for multi-line labels */
  .rrk-table thead th.rrk-th-payor {
    min-width: 6.5rem;
  }

  .rrk-td-name {
    position: sticky;
    left: 0;
    z-index: 1;
    background: #fff;
    font-weight: 600;
    text-align: left;
    padding: 0.55rem 0.6rem;
    border: 1px solid rgba(142, 153, 175, 0.35);
    vertical-align: top;
    min-width: 11rem;
    max-width: 22rem;
    white-space: normal;
    word-break: break-word;
    overflow-wrap: break-word;
    font-size: 0.76rem;
    line-height: 1.35;
    box-shadow: 4px 0 12px -6px rgba(0, 0, 0, 0.08);
  }

  tbody tr:nth-child(even) .rrk-td-name {
    background: #f8f9fc;
  }

  .rrk-cell {
    border: 1px solid rgba(142, 153, 175, 0.35);
    padding: 0;
    text-align: center;
    vertical-align: top;
    min-width: 5.5rem;
    max-width: none;
    white-space: normal;
    word-break: break-word;
  }

  .rrk-cell-link {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 0.45rem 0.5rem;
    height: 100%;
    box-sizing: border-box;
  }
  .rrk-cell-link:hover {
    background: rgba(0,0,0,0.05);
  }

  .rrk-clickable-row {
    cursor: pointer;
  }
  .rrk-clickable-row:hover td {
    background-color: rgba(67, 97, 238, 0.08) !important;
  }

  .rrk-trace-row:target td {
    background-color: #fff3cd !important;
    transition: background-color 0.5s ease;
  }

  .rrk-cell--success {
    background: rgba(6, 214, 160, 0.16);
    border-color: rgba(5, 150, 105, 0.35);
  }

  .rrk-cell--failure {
    background: rgba(247, 37, 133, 0.12);
    border-color: rgba(247, 37, 133, 0.35);
  }

  .rrk-actual {
    display: block;
    font-weight: 700;
    color: var(--dark);
    margin-bottom: 0.2rem;
  }

  .rrk-expected {
    display: block;
    font-size: 0.68rem;
    color: var(--gray);
    line-height: 1.3;
  }

  @media (max-width: 640px) {
    .rrk-show {
      padding: 1rem;
    }

    .rrk-show-actions {
      align-items: stretch;
      width: 100%;
    }

    .rrk-show .back-btn {
      justify-content: center;
    }

    .rrk-lookup-form {
      grid-template-columns: 1fr;
    }

    .rrk-lookup-btn {
      width: 100%;
    }
  }
</style>
