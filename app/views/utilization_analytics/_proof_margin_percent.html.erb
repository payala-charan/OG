<div class="ua-proof">
  <div class="ua-proof-banner">
    <h3>Calculation proof — Margin % of Cost</h3>
    <p>
      <strong>Margin % of Cost</strong> =
      <code>(Total Margin ÷ Total Product Cost) × 100</code>
      when product cost &gt; 0. Uses the same rounded margin and product cost values as the tables above.
    </p>
  </div>

  <div class="ua-table-wrap">
    <table class="ua-proof-table">
      <thead>
        <tr>
          <th rowspan="2" class="ua-proof-brand" scope="col">Brand</th>
          <th colspan="3" class="ua-proof-period" scope="colgroup"><%= period_1 %></th>
          <th colspan="3" class="ua-proof-period" scope="colgroup"><%= period_2 %></th>
        </tr>
        <tr>
          <% 2.times do %>
            <th class="ua-proof-split" scope="col">Total margin</th>
            <th class="ua-proof-split" scope="col">Total product cost</th>
            <th class="ua-proof-split ua-proof-highlight" scope="col">Margin % (in table)</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% rows.each do |brand, data| %>
          <tr>
            <td class="ua-proof-brand"><%= brand %></td>
            <% %w[q1 q2].each do |period| %>
              <% metrics = ua_proof_period(data, period) %>
              <% cost = metrics["total_product_cost"].to_f %>
              <td class="ua-proof-split"><%= ua_proof_money(metrics["total_margin"]) %></td>
              <td class="ua-proof-split"><%= ua_proof_money(metrics["total_product_cost"]) %></td>
              <td class="ua-proof-split ua-proof-highlight">
                <%= ua_proof_percent(metrics["percent_in_table"]) %>
                <% if cost.positive? %>
                  <span class="ua-proof-hint">
                    = (<%= ua_proof_money(metrics["total_margin"]) %> ÷ <%= ua_proof_money(cost) %>) × 100
                  </span>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
        <tr class="ua-proof-grand">
          <td class="ua-proof-brand">Grand Total <span class="ua-proof-match">(matches table above)</span></td>
          <% %w[q1 q2].each do |period| %>
            <% grand = ua_proof_grand(proof, period) %>
            <td class="ua-proof-split"><%= ua_proof_money(grand["total_margin"]) %></td>
            <td class="ua-proof-split"><%= ua_proof_money(grand["product_cost"]) %></td>
            <td class="ua-proof-split ua-proof-highlight">
              <%= ua_proof_percent(grand["margin_percent"]) %>
              <span class="ua-proof-hint">
                = (<%= ua_proof_money(grand["total_margin"]) %> ÷ <%= ua_proof_money(grand["product_cost"]) %>) × 100
              </span>
            </td>
          <% end %>
        </tr>
      </tbody>
    </table>
  </div>
</div>
