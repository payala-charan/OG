<div class="ua-proof">
  <div class="ua-proof-banner">
    <h3>Calculation proof — Margin Per Unit</h3>
    <p>
      <strong>Margin Per Unit</strong> =
      <code>Total Margin ÷ CMS Total Units</code>
      when CMS units &gt; 0. Uses rounded total margin from the Total Margin table and
      Σ <code>cms_total_units</code> from the CMS Total Units table (category nil, Outpatient + Emergency).
    </p>
  </div>

  <div class="ua-table-wrap">
    <table class="ua-proof-table">
      <thead>
        <tr>
          <th rowspan="2" class="ua-proof-brand" scope="col">Brand</th>
          <th colspan="3" class="ua-proof-period" scope="colgroup"><%= period_1 %></th>
          <th colspan="3" class="ua-proof-period" scope="colgroup"><%= period_2 %></th>
        </tr>
        <tr>
          <% 2.times do %>
            <th class="ua-proof-split" scope="col">Total margin</th>
            <th class="ua-proof-split" scope="col">CMS total units</th>
            <th class="ua-proof-split ua-proof-highlight" scope="col">Margin / unit (in table)</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% rows.each do |brand, data| %>
          <tr>
            <td class="ua-proof-brand"><%= brand %></td>
            <% %w[q1 q2].each do |period| %>
              <% metrics = ua_proof_period(data, period) %>
              <% units = metrics["cms_total_units"].to_f %>
              <td class="ua-proof-split"><%= ua_proof_money(metrics["total_margin"]) %></td>
              <td class="ua-proof-split"><%= ua_proof_number(metrics["cms_total_units"]) %></td>
              <td class="ua-proof-split ua-proof-highlight">
                <%= ua_proof_money(metrics["margin_per_unit_raw"]) %>
                <% if units.positive? %>
                  <span class="ua-proof-hint">
                    = <%= ua_proof_money(metrics["total_margin"]) %> ÷ <%= ua_proof_number(units) %>
                  </span>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
        <tr class="ua-proof-grand">
          <td class="ua-proof-brand">Grand Total <span class="ua-proof-match">(matches table above)</span></td>
          <% %w[q1 q2].each do |period| %>
            <% grand = ua_proof_grand(proof, period) %>
            <td class="ua-proof-split"><%= ua_proof_money(grand["total_margin"]) %></td>
            <td class="ua-proof-split"><%= ua_proof_number(grand["cms_units"]) %></td>
            <td class="ua-proof-split ua-proof-highlight">
              <%= ua_proof_money(grand["margin_per_unit"]) %>
              <span class="ua-proof-hint">
                = <%= ua_proof_money(grand["total_margin"]) %> ÷ <%= ua_proof_number(grand["cms_units"]) %>
              </span>
            </td>
          <% end %>
        </tr>
      </tbody>
    </table>
  </div>
</div>
