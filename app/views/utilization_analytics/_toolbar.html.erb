<div class="ua-toolbar">
  <div class="ua-toolbar-start">
  <div class="ua-menu-wrap">
    <button id="utilization-options-menu" type="button" class="ua-orange-btn ua-menu-btn" aria-expanded="false" aria-controls="utilization-dropdown-menu">
      Utilization Analytics
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
    </button>
    <div id="utilization-dropdown-menu" class="ua-menu" hidden>
      <%= link_to utilization_analytics_path(team_id: ua_team_id), class: "ua-menu-item" do %>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/></svg>
        Utilization Analytics
      <% end %>
      <span class="ua-menu-item">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3z"/></svg>
        Purchase Analytics
      </span>
      <span class="ua-menu-item">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/><path fill="currentColor" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5z"/></svg>
        Transactions
      </span>
    </div>
  </div>
  <%= form_with url: utilization_analytics_path, method: :get, id: "team-form", class: "ua-team-form" do %>
    <% if ua_applied? %>
      <%= render "context_fields", include_team: false %>
    <% end %>
    <%= label_tag "teamSelect", "Team" %>
    <%= select_tag :team_id, options_for_select(UtilizationAnalytics::TEAM_IDS, ua_team_id), id: "teamSelect" %>
  <% end %>
  </div>

  <div class="ua-toolbar-actions">
    <div class="ua-toggle" role="group" aria-label="Time period">
      <%= link_to "Monthly", utilization_analytics_path(analytics_request: "1", team_id: ua_team_id, period_kind: "month", charge_class: ua_selected_charge_class, hospital_names: ua_values("hospital_names"), payor_names: ua_values("payor_names")), id: "monthly-toggle", class: "ua-toggle-btn #{'is-active' if ua_toggle_period == 'month'}" %>
      <%= link_to "Quarterly", utilization_analytics_path(analytics_request: "1", team_id: ua_team_id, period_kind: "quarter", charge_class: ua_selected_charge_class, hospital_names: ua_values("hospital_names"), payor_names: ua_values("payor_names")), id: "quarterly-toggle", class: "ua-toggle-btn #{'is-active' if ua_toggle_period == 'quarter'}" %>
    </div>
    <button id="download-btn" type="button" class="ua-orange-btn" <%= "disabled" unless ua_downloadable? %>>Download</button>
  </div>
</div>
