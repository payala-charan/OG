<div class="ua-proof">
  <div class="ua-proof-banner">
    <h3>Calculation proof — Total Margin</h3>
    <p>
      Utilization scope: <code>category: nil</code>,
      <strong>Outpatient + Emergency</strong>.
      <strong>Total Margin</strong> =
      <code>Σ(actual_reimbursement) − Total Product Cost</code>.
      Total Product Cost = CMS Total Units × Product Cost Per Unit (from tables above).
    </p>
  </div>

  <div class="ua-table-wrap">
    <table class="ua-proof-table">
      <thead>
        <tr>
          <th rowspan="2" class="ua-proof-brand" scope="col">Brand</th>
          <th colspan="3" class="ua-proof-period" scope="colgroup"><%= period_1 %></th>
          <th colspan="3" class="ua-proof-period" scope="colgroup"><%= period_2 %></th>
        </tr>
        <tr>
          <% 2.times do %>
            <th class="ua-proof-split" scope="col">Actual reimbursement</th>
            <th class="ua-proof-split" scope="col">Total product cost</th>
            <th class="ua-proof-split ua-proof-highlight" scope="col">Total margin (in table)</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% rows.each do |brand, data| %>
          <tr>
            <td class="ua-proof-brand"><%= brand %></td>
            <% %w[q1 q2].each do |period| %>
              <% metrics = ua_proof_period(data, period) %>
              <td class="ua-proof-split"><%= ua_proof_money(metrics["actual_reimbursement"]) %></td>
              <td class="ua-proof-split"><%= ua_proof_money(metrics["total_product_cost"]) %></td>
              <td class="ua-proof-split ua-proof-highlight">
                <%= ua_proof_money(metrics["total_margin_raw"]) %>
                <span class="ua-proof-hint">
                  = <%= ua_proof_money(metrics["actual_reimbursement"]) %> − <%= ua_proof_money(metrics["total_product_cost"]) %>
                </span>
              </td>
            <% end %>
          </tr>
        <% end %>
        <tr class="ua-proof-grand">
          <td class="ua-proof-brand">Grand Total <span class="ua-proof-match">(matches table above)</span></td>
          <% %w[q1 q2].each do |period| %>
            <% grand = ua_proof_grand(proof, period) %>
            <td class="ua-proof-split"><%= ua_proof_money(grand["actual_reimbursement"]) %></td>
            <td class="ua-proof-split"><%= ua_proof_money(grand["product_cost"]) %></td>
            <td class="ua-proof-split ua-proof-highlight">
              <%= ua_proof_money(grand["total_margin"]) %>
              <span class="ua-proof-hint">Σ brand total margin</span>
            </td>
          <% end %>
        </tr>
      </tbody>
    </table>
  </div>
</div>
