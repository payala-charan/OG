<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OG - Create Account</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet">

  <style>
    :root {
      --primary: #4cc9f0;
      --secondary: #7209b7;
      --accent: #06ffa5;
      --glass: rgba(255, 255, 255, 0.13);
      --glass-border: rgba(255, 255, 255, 0.25);
      --text: #ffffff;
      --shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
      --glow: 0 0 40px rgba(76, 201, 240, 0.4);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body, html { height: 100%; font-family: 'Inter', sans-serif; overflow: hidden; }

    /* Background */
    .bg {
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: url('<%= asset_path "og10.jpeg" %>') center/cover no-repeat fixed;
      z-index: -2;
    }
    .overlay {
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: linear-gradient(135deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.7) 100%);
      z-index: -1;
    }

    .auth-container {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      position: relative;
      z-index: 10;
    }

    .glass-card {
      background: var(--glass);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1.5px solid var(--glass-border);
      border-radius: 32px;
      box-shadow: var(--shadow), var(--glow);
      width: 100%;
      max-width: 480px;
      overflow: hidden;
      animation: float 8s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-20px); }
    }

    .card-header {
      background: linear-gradient(135deg, rgba(76,201,240,0.3), rgba(114,9,183,0.4));
      padding: 50px 40px;
      text-align: center;
      border-bottom: 1px solid rgba(255,255,255,0.15);
    }
    .card-header h2 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 3rem;
      font-weight: 700;
      margin-bottom: 12px;
      background: linear-gradient(135deg, #4cc9f0, #06ffa5);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .card-header p {
      font-size: 1.1rem;
      opacity: 0.9;
      font-weight: 500;
    }

    .card-body {
      padding: 50px 40px;
    }

    .form-group {
      margin-bottom: 28px;
    }
    .form-group label {
      font-weight: 600;
      margin-bottom: 10px;
      display: block;
      font-size: 1rem;
      color: rgba(255,255,255,0.95);
    }

    .input-wrapper {
      position: relative;
    }
    .form-control {
      width: 100%;
      padding: 18px 56px 18px 20px;
      background: rgba(255, 255, 255, 0.12);
      border: 1.5px solid rgba(255, 255, 255, 0.3);
      border-radius: 18px;
      color: white;
      font-size: 1.05rem;
    }
    .form-control::placeholder { color: rgba(255,255,255,0.6); }
    .form-control:focus {
      background: rgba(255, 255, 255, 0.22);
      border-color: var(--primary);
      box-shadow: 0 0 0 5px rgba(76, 201, 240, 0.25);
      outline: none;
    }
    .input-wrapper i {
      position: absolute;
      right: 20px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--primary);
      font-size: 1.3rem;
      pointer-events: none;
    }

    .password-strength {
      height: 6px;
      background: rgba(255,255,255,0.2);
      border-radius: 10px;
      margin-top: 10px;
      overflow: hidden;
    }
    #password-strength-meter {
      height: 100%;
      width: 0;
      background: #e74c3c;
      transition: all 0.4s ease;
      border-radius: 10px;
    }

    .submit-btn {
      width: 100%;
      padding: 18px;
      background: linear-gradient(135deg, #4cc9f0, #06ffa5);
      border: none;
      border-radius: 18px;
      color: #000;
      font-size: 1.1rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      cursor: pointer;
      transition: all 0.4s ease;
      box-shadow: 0 10px 30px rgba(76, 201, 240, 0.4);
      margin: 15px 0;
    }
    .submit-btn:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 50px rgba(76, 201, 240, 0.6);
    }

    .divider {
      text-align: center;
      margin: 35px 0;
      position: relative;
      color: rgba(255,255,255,0.7);
      font-size: 0.95rem;
    }
    .divider::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 0;
      width: 100%;
      height: 1.5px;
      background: rgba(255,255,255,0.2);
    }
    .divider span {
      background: rgba(0,0,0,0.4);
      padding: 0 24px;
      font-weight: 500;
    }

    .social-login {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin: 30px 0;
    }
    .social-btn {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.15);
      border: 1.5px solid rgba(255, 255, 255, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      color: white;
      transition: all 0.4s ease;
      box-shadow: 0 8px 25px rgba(0,0,0,0.3);
    }
    .social-btn:hover {
      transform: translateY(-10px) scale(1.1);
      background: rgba(255, 255, 255, 0.25);
    }

    .toggle-form {
      text-align: center;
      margin: 30px 0;
      font-size: 1rem;
      font-weight: 500;
    }
    .toggle-form a {
      color: var(--primary);
      text-decoration: none;
      font-weight: 700;
    }
    .toggle-form a:hover { text-decoration: underline; }

    .back-home-btn {
      display: block;
      text-align: center;
      padding: 16px 30px;
      background: rgba(255, 255, 255, 0.18);
      backdrop-filter: blur(15px);
      border: 1.5px solid rgba(255, 255, 255, 0.3);
      border-radius: 18px;
      color: white;
      font-weight: 600;
      text-decoration: none;
      font-size: 1.05rem;
      transition: all 0.4s ease;
      box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    .back-home-btn:hover {
      background: rgba(255, 255, 255, 0.28);
      transform: translateY(-5px);
      box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    }
    .back-home-btn i { margin-right: 10px; font-size: 1.2rem; }

    .error-messages {
      background: rgba(255, 0, 0, 0.25);
      border: 1.5px solid #ff3333;
      color: #ff9999;
      padding: 18px;
      border-radius: 16px;
      margin-bottom: 25px;
      font-weight: 500;
    }
    .error-messages h3 { margin: 0 0 12px 0; font-size: 1rem; }
    .error-messages ul { margin: 10px 0 0 20px; padding: 0; }

    @media (max-width: 480px) {
      .card-header { padding: 40px 20px; }
      .card-header h2 { font-size: 2.4rem; }
      .card-body { padding: 40px 25px; }
    }
  </style>
</head>
<body>

  <div class="bg"></div>
  <div class="overlay"></div>

  <div class="auth-container">
    <div class="glass-card">
      <div class="card-header">
        <h2>Create Account</h2>
        <p>Join our community today</p>
        <%= link_to home_path, class: "back-home-btn" do %>
          Back to Home
        <% end %>
      </div>

      <div class="card-body">
        <%= form_with model: @user, url: signup_path, local: true do |form| %>
          <% if @user.errors.any? %>
            <div class="error-messages">
              <h3><%= pluralize(@user.errors.count, "error") %> prohibited this account from being created:</h3>
              <ul>
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="form-group">
            <%= form.label :email, "Email Address" %>
            <div class="input-wrapper">
              <%= form.email_field :email, class: "form-control", placeholder: "Enter your email", required: true %>
              <i class="fas fa-envelope"></i>
            </div>
          </div>

          <div class="form-group">
            <%= form.label :password %>
            <div class="input-wrapper">
              <%= form.password_field :password, class: "form-control", placeholder: "Create a password", required: true, id: "user_password" %>
              <i class="fas fa-lock"></i>
            </div>
            <div class="password-strength">
              <div class="strength-meter" id="password-strength-meter"></div>
            </div>
          </div>

          <div class="form-group">
            <%= form.label :password_confirmation, "Confirm Password" %>
            <div class="input-wrapper">
              <%= form.password_field :password_confirmation, class: "form-control", placeholder: "Confirm your password", required: true %>
              <i class="fas fa-lock"></i>
            </div>
          </div>

          <%= form.submit "Create Account", class: "submit-btn" %>
        <% end %>

        <div class="divider"><span>Or sign up with</span></div>

        <div class="social-login">
          <div class="social-btn google"><i class="fab fa-google"></i></div>
          <div class="social-btn facebook"><i class="fab fa-facebook-f"></i></div>
          <div class="social-btn twitter"><i class="fab fa-twitter"></i></div>
        </div>

        <div class="toggle-form">
          Already have an account? <%= link_to "Login", login_path %>
        </div>

        <!-- Bottom Back to Home Button -->
        <%= link_to home_path, class: "back-home-btn" do %>
          Back to Home
        <% end %>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const passwordInput = document.getElementById('user_password');
      const strengthMeter = document.getElementById('password-strength-meter');
      
      if (passwordInput && strengthMeter) {
        passwordInput.addEventListener('input', function() {
          const password = passwordInput.value;
          let strength = 0;
          
          if (password.length >= 8) strength += 25;
          if (/[A-Z]/.test(password)) strength += 25;
          if (/[0-9]/.test(password)) strength += 25;
          if (/[^A-Za-z0-9]/.test(password)) strength += 25;
          
          strengthMeter.style.width = strength + '%';
          
          if (strength < 50) {
            strengthMeter.style.backgroundColor = '#e74c3c';
          } else if (strength < 75) {
            strengthMeter.style.backgroundColor = '#f39c12';
          } else {
            strengthMeter.style.backgroundColor = '#2ecc71';
          }
        });
      }
    });
  </script>
</body>
</html>