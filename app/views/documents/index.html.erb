<h2>Uploaded Files</h2>

<%= link_to "Upload New File", new_document_path %>

<table border="1">
  <tr>
    <th>Name</th>
    <th>File</th>
    <th>Download</th>
  </tr>

  <% @documents.each do |doc| %>
    <tr>
      <td><%= doc.name %></td>
      <td><%= doc.file.filename if doc.file.attached? %></td>
      <td>
        <% if doc.file.attached? %>
          <%= link_to "Download", rails_blob_path(doc.file, disposition: "attachment") %>
        <% else %>
          No File
        <% end %>
      </td>
    </tr>
  <% end %>
</table>
