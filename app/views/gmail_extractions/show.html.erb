<% content_for :title, "Gmail import ##{@extraction.id}" %>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container py-4" style="max-width: 1000px;">
  <h1 class="h3 mb-1">Import <span class="text-secondary">#<%= @extraction.id %></span></h1>
  <p class="text-muted">
    <span class="badge bg-<%= @extraction.status == 'completed' ? 'success' : (@extraction.status == 'failed' ? 'danger' : 'secondary') %>"><%= @extraction.status %></span>
    &nbsp; to <strong><%= @extraction.recipient_email %></strong>
    &nbsp; <code><%= @extraction.start_on %></code> &ndash; <code><%= @extraction.end_on %></code>
    &middot; <strong><%= @extraction.total_fetched %></strong> message(s) stored
  </p>
  <% if @extraction.error_message.present? %>
    <div class="alert alert-danger small"><pre class="mb-0" style="white-space: pre-wrap;"><%= @extraction.error_message %></pre></div>
  <% end %>

  <div class="d-flex flex-wrap gap-2 mb-3">
    <%= link_to "Back to Gmail import", gmail_extractions_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <% if @emails.empty? && @extraction.status == "completed" %>
    <p class="text-muted">No messages matched this search in Sent. Try a wider range or a different address.</p>
  <% elsif @emails.empty? && @extraction.status != "completed" %>
    <p class="text-muted">Job is <strong><%= @extraction.status %></strong>. If it stays pending, ensure <code>bundle exec sidekiq</code> is running and Redis is up (<code>REDIS_URL</code>).</p>
  <% else %>
    <h2 class="h5 mb-3">Messages</h2>
    <div class="d-flex flex-column gap-3">
      <% @emails.each do |m| %>
        <article class="card">
          <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between gap-2">
              <strong class="card-title mb-0"><%= m.subject.presence || "(no subject)" %></strong>
              <time class="text-muted small" datetime="<%= m.sent_at&.iso8601 %>"><%= m.sent_at ? m.sent_at.in_time_zone.strftime("%B %d, %Y at %H:%M %Z") : "—" %></time>
            </div>
            <p class="text-muted small mb-1">Gmail id: <code class="user-select-all"><%= m.gmail_message_id %></code></p>
            <div class="border-top pt-2 mt-2 small" style="white-space: pre-wrap; max-height: 320px; overflow-y: auto;">
              <%= m.body_text.presence || "—" %>
            </div>
          </div>
        </article>
      <% end %>
    </div>

    <div class="mt-3">
      <% if @emails.respond_to?(:current_page) %>
        <%= paginate @emails %>
      <% end %>
    </div>
  <% end %>
</div>
