<% content_for :title, "Gmail — Sent mail import" %>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container py-4" style="max-width: 900px;">
  <h1 class="h3 mb-1">Gmail — sent messages</h1>
  <p class="text-secondary mb-4">Connect with Google (OAuth 2.0), then import messages you sent to a recipient over a date range. Processing runs in the background (Sidekiq + Redis).</p>

  <% if flash[:notice] %>
    <div class="alert alert-success"><%= flash[:notice] %></div>
  <% end %>
  <% if flash[:alert] %>
    <div class="alert alert-warning"><%= flash[:alert] %></div>
  <% end %>

  <div class="card mb-4">
    <div class="card-body">
      <h2 class="h5 card-title">1. Connect Gmail</h2>
      <% if @gmail_connection.present? && @gmail_connection.refresh_token.present? %>
        <p class="mb-2">Connected as <strong><%= @gmail_connection.google_email %></strong></p>
        <p class="text-muted small mb-0">Tokens are stored encrypted in the database; refresh is applied automatically when they expire.</p>
      <% else %>
        <p class="text-muted">You need a Google account with Gmail, and the app must be allowed the Gmail read scope.</p>
        <%= button_to "/auth/google_oauth2", method: :post, data: { turbo: false },
            class: "btn btn-primary" do %>
          <i class="fab fa-google me-1"></i> Connect Google (Gmail)
        <% end %>
        <p class="text-muted small mt-2 mb-0">Set redirect URI in Google Cloud Console: <code><%= request.base_url %>/auth/google_oauth2/callback</code></p>
      <% end %>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <h2 class="h5 card-title">2. Import from Sent</h2>
      <p class="text-muted small">Fetches only messages in <strong>Sent</strong> matching the recipient in the <code>to</code> field, within the date range (inclusive on both ends in this app; Gmail&rsquo;s <code>before</code> is applied as the day after your end date).</p>

      <%= form_with model: @gmail_extraction, url: gmail_extractions_path, local: true, class: "row g-3" do |f| %>
        <% if @gmail_extraction.errors.any? %>
          <div class="col-12">
            <div class="alert alert-danger">
              <ul class="mb-0">
                <% @gmail_extraction.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>

        <div class="col-12 col-md-6">
          <%= f.label :recipient_email, "Recipient email", class: "form-label" %>
          <%= f.email_field :recipient_email, class: "form-control", required: true, placeholder: "name@example.com" %>
        </div>
        <div class="col-6 col-md-3">
          <%= f.label :start_on, "Start date", class: "form-label" %>
          <%= f.date_field :start_on, class: "form-control", required: true, value: @gmail_extraction.start_on || Date.current.beginning_of_year %>
        </div>
        <div class="col-6 col-md-3">
          <%= f.label :end_on, "End date", class: "form-label" %>
          <%= f.date_field :end_on, class: "form-control", required: true, value: @gmail_extraction.end_on || Date.current %>
        </div>
        <div class="col-12">
          <%= f.submit "Queue import (Sidekiq)", class: "btn btn-success", disabled: @gmail_connection.nil? || @gmail_connection.refresh_token.blank? %>
        </div>
      <% end %>
    </div>
  </div>

  <h2 class="h5 mb-3">Recent imports</h2>
  <% if @extractions.empty? %>
    <p class="text-muted">No imports yet.</p>
  <% else %>
    <div class="table-responsive">
      <table class="table table-sm align-middle">
        <thead>
          <tr>
            <th>Status</th>
            <th>Recipient</th>
            <th>Range</th>
            <th>Count</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @extractions.each do |e| %>
            <tr>
              <td>
                <span class="badge bg-<%= e.status == 'completed' ? 'success' : (e.status == 'failed' ? 'danger' : (e.status == 'running' ? 'info' : 'secondary')) %>"><%= e.status %></span>
                <% if e.error_message.present? && e.status == 'failed' %>
                  <span class="text-danger d-block small text-truncate" style="max-width: 12rem" title="<%= e.error_message %>"><%= e.error_message %></span>
                <% end %>
              </td>
              <td><%= e.recipient_email %></td>
              <td><%= e.start_on %> &ndash; <%= e.end_on %></td>
              <td><%= e.total_fetched %></td>
              <td><%= link_to "View", gmail_extraction_path(e), class: "btn btn-sm btn-outline-primary" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <p class="mt-3 mb-0"><%= link_to "Back to home", home_path, class: "text-decoration-none" %></p>
</div>
