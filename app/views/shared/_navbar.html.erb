<% content_for :styles do %>
<style>
  :root {
    --primary: #6366f1;
    --secondary: #8b5cf6;
    --dark: #222;
    --transition: 0.3s ease;
  }

  /* =========================== */
  /* NAVBAR CONTAINER */
  /* =========================== */
  .navbar {
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 25px rgba(0, 0, 0, 0.08);
    padding: 0.8rem 0;
    transition: var(--transition);
    z-index: 10000;
  }

  /* =========================== */
  /* BRAND */
  /* =========================== */
  .navbar-brand {
    font-weight: 900;
    font-size: 1.9rem;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .navbar-brand i {
    font-size: 2rem;
  }

  /* =========================== */
  /* NAV LINKS */
  /* =========================== */
  .navbar-links {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav-link {
    font-weight: 600;
    color: var(--dark) !important;
    padding: 0.5rem 0.8rem;
    font-size: 1rem;
    text-decoration: none;
    transition: var(--transition);
    position: relative;
  }

  /* Hover effect */
  .nav-link:hover {
    color: var(--primary) !important;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -4px;
    height: 2px;
    width: 0%;
    background: var(--primary);
    transition: var(--transition);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* LOGOUT BUTTON */
  .logout-btn {
    background-color: #dc3545;
    border: none;
    color: white;
    padding: 8px 18px;
    border-radius: 6px;
    font-weight: 600;
    transition: var(--transition);
  }

  .logout-btn:hover {
    background-color: #bb2d3b;
  }

  /* =========================== */
  /* SCROLL EFFECT */
  /* =========================== */
  .navbar-scrolled {
    background: rgba(255, 255, 255, 0.96) !important;
    box-shadow: 0 6px 25px rgba(0, 0, 0, 0.12) !important;
  }
</style>

<% end %>

<!-- ============================= -->
<!-- NAVBAR (NO <li> used) -->
<!-- ============================= -->
<nav class="navbar navbar-expand-lg navbar-light fixed-top">
  <div class="container">

    <!-- Brand -->
    <a class="navbar-brand" href="/home">
      <i class="fas fa-bolt"></i> OG
    </a>

    <!-- Navbar Content -->
    <div class="collapse navbar-collapse" id="navbarNav">

      <div class="navbar-links ms-auto">

        <%= link_to "Excel Validation", validations_path, class: "nav-link" %>
        <%= link_to "Document Storage", uploaded_files_path, class: "nav-link" %>
        <%= link_to "Payor Analysis", payor_preferences_path, class: "nav-link" %>
        <%= link_to "Voice Assistant", voice_path, class: "nav-link" %>

        <% if current_user %>
          <%= button_to "Logout", logout_path,
              method: :delete,
              data: { turbo_confirm: "Are you sure?" },
              class: "logout-btn" %>
        <% else %>
          <%= link_to "Login", login_path, class: "nav-link" %>
          <%= link_to "Sign Up", signup_path, class: "nav-link" %>
        <% end %>

      </div>

    </div>
  </div>
</nav>


<!-- ============================= -->
<!-- SCROLL EFFECT JS -->
<!-- ============================= -->
<script>
  window.addEventListener('scroll', () => {
    const nav = document.querySelector('.navbar');

    if (window.scrollY > 40) {
      nav.classList.add('navbar-scrolled');
    } else {
      nav.classList.remove('navbar-scrolled');
    }
  });
</script>

