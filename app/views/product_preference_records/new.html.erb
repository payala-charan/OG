<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Product Preferences Validation — Upload</title>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    :root {
      --primary: #4361ee;
      --primary-light: #6c8aff;
      --primary-dark: #3a56d4;
      --secondary: #7209b7;
      --accent: #4cc9f0;
      --danger: #f72585;
      --warning: #ff9e00;
      --success: #06d6a0;
      --light: #f8f9fc;
      --dark: #2b2d42;
      --gray: #8d99ae;
      --border-radius: 16px;
      --shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      --transition: all 0.4s ease;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', 'Segoe UI', sans-serif;
      color: var(--dark);
      background: linear-gradient(135deg, #f5f7ff 0%, #f0f4ff 100%);
      min-height: 100vh;
      line-height: 1.6;
    }

    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 2rem;
    }

    /* Header Styles */
    .header {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border-radius: var(--border-radius);
      padding: 2rem;
      margin-bottom: 2rem;
      box-shadow: var(--shadow);
      border: 1px solid rgba(255, 255, 255, 0.8);
    }

    .header-content {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    .header-text h1 {
      font-weight: 800;
      font-size: 2.5rem;
      margin-bottom: 0.5rem;
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .header-text p {
      color: var(--gray);
      font-size: 1.1rem;
    }

    .back-btn {
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
      color: white;
      border: none;
      border-radius: 50px;
      padding: 0.8rem 1.5rem;
      font-weight: 600;
      text-decoration: none;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      box-shadow: 0 6px 20px rgba(67, 97, 238, 0.3);
    }

    .back-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(67, 97, 238, 0.4);
      color: white;
      text-decoration: none;
    }

    /* Upload Card */
    .upload-card {
      background: white;
      border-radius: var(--border-radius);
      padding: 2.5rem;
      margin-bottom: 2rem;
      box-shadow: var(--shadow);
      transition: var(--transition);
      border-top: 4px solid transparent;
    }

    .upload-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
      border-top: 4px solid var(--primary);
    }

    .upload-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
    }

    .upload-header h2 {
      font-weight: 700;
      font-size: 1.5rem;
      color: var(--dark);
    }

    .upload-header p {
      color: var(--gray);
      margin-top: 0.5rem;
    }

    .upload-area {
      border: 3px dashed var(--primary-light);
      border-radius: var(--border-radius);
      padding: 3rem 2rem;
      text-align: center;
      background: rgba(67, 97, 238, 0.02);
      transition: var(--transition);
      cursor: pointer;
      position: relative;
      overflow: hidden;
    }

    .upload-area:hover {
      border-color: var(--primary);
      background: rgba(67, 97, 238, 0.05);
    }

    .upload-area.dragover {
      border-color: var(--success);
      background: rgba(6, 214, 160, 0.05);
      transform: scale(1.02);
    }

    .upload-icon {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
      color: white;
      font-size: 2rem;
    }

    .upload-text h3 {
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: var(--dark);
    }

    .upload-text p {
      color: var(--gray);
      margin-bottom: 1.5rem;
    }

    .browse-btn {
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
      color: white;
      border: none;
      border-radius: 50px;
      padding: 0.8rem 2rem;
      font-weight: 600;
      cursor: pointer;
      transition: var(--transition);
      box-shadow: 0 6px 20px rgba(67, 97, 238, 0.3);
    }

    .browse-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(67, 97, 238, 0.4);
    }

    .file-info {
      margin-top: 1.5rem;
      padding: 1rem;
      background: var(--light);
      border-radius: var(--border-radius);
      border-left: 4px solid var(--success);
    }

    .file-name {
      font-weight: 600;
      color: var(--success);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .upload-controls {
      display: flex;
      gap: 1rem;
      align-items: center;
      justify-content: center;
      margin-top: 2rem;
      flex-wrap: wrap;
    }

    .upload-btn {
      background: linear-gradient(135deg, var(--success) 0%, #05c291 100%);
      color: white;
      border: none;
      border-radius: 50px;
      padding: 0.8rem 2.5rem;
      font-weight: 600;
      cursor: pointer;
      transition: var(--transition);
      box-shadow: 0 6px 20px rgba(6, 214, 160, 0.3);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .upload-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(6, 214, 160, 0.4);
    }

    .upload-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
      box-shadow: 0 2px 10px rgba(6, 214, 160, 0.2);
    }

    .view-uploads-btn {
      background: rgba(141, 153, 174, 0.1);
      color: var(--dark);
      border: 2px solid var(--gray);
      border-radius: 50px;
      padding: 0.8rem 2rem;
      font-weight: 600;
      text-decoration: none;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .view-uploads-btn:hover {
      background: var(--gray);
      color: white;
      text-decoration: none;
      transform: translateY(-2px);
    }

    /* Alert Messages */
    .alert {
      padding: 1rem 1.5rem;
      border-radius: var(--border-radius);
      margin-bottom: 2rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 500;
    }

    .alert-success {
      background: rgba(6, 214, 160, 0.1);
      color: var(--success);
      border: 1px solid rgba(6, 214, 160, 0.3);
    }

    .alert-danger {
      background: rgba(247, 37, 133, 0.1);
      color: var(--danger);
      border: 1px solid rgba(247, 37, 133, 0.3);
    }

    /* Hidden elements */
    .hidden {
      display: none !important;
    }

    /* Responsive Design */
    @media (max-width: 768px) {
      .container {
        padding: 1rem;
      }

      .header-content {
        flex-direction: column;
        gap: 1.5rem;
      }

      .header-text h1 {
        font-size: 2rem;
      }

      .upload-header {
        flex-direction: column;
        text-align: center;
        gap: 1rem;
      }

      .upload-controls {
        flex-direction: column;
        width: 100%;
      }

      .upload-btn, .view-uploads-btn {
        width: 100%;
        justify-content: center;
      }
    }

    @media (max-width: 480px) {
      .upload-card {
        padding: 1.5rem;
      }

      .upload-area {
        padding: 2rem 1rem;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <header class="header">
      <div class="header-content">
        <div class="header-text">
          <h1>Product Preferences Validation</h1>
          <p>Upload Excel files to validate product preferences against payor data</p>
        </div>
        <%= link_to features_path, class: "back-btn" do %>
          <i class="fas fa-arrow-left"></i> Back to Dashboard
        <% end %>
      </div>
    </header>

    <!-- Alert Messages -->
    <% if notice %>
      <div class="alert alert-success">
        <i class="fas fa-check-circle"></i>
        <%= notice %>
      </div>
    <% end %>

    <% if alert %>
      <div class="alert alert-danger">
        <i class="fas fa-exclamation-triangle"></i>
        <%= alert %>
      </div>
    <% end %>

    <!-- Upload Card -->
    <section class="upload-card">
      <div class="upload-header">
        <div>
          <h2>Upload & Validate</h2>
          <p>Drag & drop or choose an Excel file (.xlsx/.xls) to validate product preferences. The system will check each payor column against the database.</p>
        </div>
      </div>

      <%= form_with url: product_preference_records_path, local: true, multipart: true, html: { id: "uploadForm", class: "upload-form" } do |f| %>
        <div id="uploadArea" class="upload-area">
          <div class="upload-icon">
            <i class="fas fa-file-excel"></i>
          </div>
          <div class="upload-text">
            <h3>Upload Your Excel File</h3>
            <p>Supported formats: .xlsx, .xls (Max 10MB)</p>
          </div>

          <button type="button" id="browseBtn" class="browse-btn">
            <i class="fas fa-folder-open"></i> Browse Files
          </button>

          <div id="fileInfo" class="file-info hidden">
            <div class="file-name">
              <i class="fas fa-check-circle"></i>
              <span id="selectedFileName">No file selected</span>
            </div>
          </div>

          <%= f.file_field :file, id: "fileInput", accept: ".xlsx,.xls", class: "hidden" %>
        </div>

        <div class="upload-controls">
          <%= f.submit "Upload & Validate File", id: "uploadBtn", class: "upload-btn", disabled: true do %>
            <i class="fas fa-upload"></i> Upload & Validate File
          <% end %>

          <%= link_to product_preference_records_path, class: "view-uploads-btn" do %>
            <i class="fas fa-list"></i> View All Uploads
          <% end %>
        </div>
      <% end %>
    </section>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Upload area functionality
      const uploadArea = document.getElementById('uploadArea');
      const fileInput = document.getElementById('fileInput');
      const browseBtn = document.getElementById('browseBtn');
      const fileInfo = document.getElementById('fileInfo');
      const selectedFileName = document.getElementById('selectedFileName');
      const uploadBtn = document.getElementById('uploadBtn');

      // Browse button click
      browseBtn.addEventListener('click', (e) => {
        e.preventDefault();
        fileInput.click();
      });

      // Drag and drop functionality
      uploadArea.addEventListener('dragover', (e) => {
        e.preventDefault();
        uploadArea.classList.add('dragover');
      });

      uploadArea.addEventListener('dragleave', () => {
        uploadArea.classList.remove('dragover');
      });

      uploadArea.addEventListener('drop', (e) => {
        e.preventDefault();
        uploadArea.classList.remove('dragover');
        if (e.dataTransfer.files && e.dataTransfer.files.length) {
          fileInput.files = e.dataTransfer.files;
          handleFileSelection(e.dataTransfer.files[0]);
        }
      });

      // File input change
      fileInput.addEventListener('change', () => {
        if (fileInput.files.length) {
          handleFileSelection(fileInput.files[0]);
        }
      });

      function handleFileSelection(file) {
        selectedFileName.textContent = file.name;
        fileInfo.classList.remove('hidden');
        uploadBtn.disabled = false;

        // Add success animation
        fileInfo.animate([
          { transform: 'scale(0.95)', opacity: 0.8 },
          { transform: 'scale(1)', opacity: 1 }
        ], { duration: 300, easing: 'ease-out' });
      }
    });
  </script>
</body>
</html>