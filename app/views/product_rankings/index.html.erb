<!-- app/views/product_rankings/index.html.erb -->
<div class="product-rankings-dashboard" data-aos="fade-in">
  <div class="container">
    <div class="dashboard-header d-flex justify-content-between align-items-center">
      <div class="header-content">
        <h1>Product Rankings</h1>
        <p>Comprehensive overview of margin-based biosimilar product rankings</p>
      </div>
      <div class="dashboard-actions">
        <%= link_to features_path, class: "btn-outline-primary" do %>
          <i class="fas fa-arrow-left"></i> Back to Features
        <% end %>
      </div>
    </div>

    <!-- Filters Container -->
    <div class="filters-container fade-in-up" style="animation-delay: 0.1s;">
      <%= form_with url: product_rankings_path, method: :get, local: true, class: "filter-form", remote: false do |form| %>
        <div class="filter-group">
          <%= form.label :generic_name_group, "Generic Name" %>
          <%= form.select :generic_name_group, 
              options_for_select(@available_generic_names, params[:generic_name_group]), 
              { include_blank: "All Generic Names" }, 
              { class: "form-control custom-select", onchange: "this.form.submit();" } %>
        </div>
        
        <div class="filter-group">
          <%= form.label :team_id, "Team ID" %>
          <%= form.select :team_id, 
              options_for_select(@available_teams, params[:team_id]), 
              { include_blank: "All Teams" }, 
              { class: "form-control custom-select", onchange: "this.form.submit();" } %>
        </div>

        <div class="filter-group">
          <%= form.label :accounting_period_id, "Quarter" %>
          <%= form.select :accounting_period_id, 
              options_for_select(@available_periods.map { |p| ["Q#{p}", p] }, params[:accounting_period_id]), 
              { include_blank: "All Quarters" }, 
              { class: "form-control custom-select", onchange: "this.form.submit();" } %>
        </div>

        <div class="filter-group">
          <%= form.label :payor, "Payor" %>
          <%= form.select :payor, 
              options_for_select(@available_payors, params[:payor]), 
              { include_blank: "All Payors" }, 
              { class: "form-control custom-select", onchange: "this.form.submit();" } %>
        </div>
        
        <div class="filter-actions" style="margin-bottom: 0.2rem;">
          <%= link_to "Clear Filters", product_rankings_path, class: "btn-outline-primary" %>
        </div>
      <% end %>
    </div>

    <!-- Data Table -->
    <div class="table-container fade-in-up">
      <table class="premium-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Generic Name Group</th>
            <th>Team ID</th>
            <th>Period ID</th>
            <th>Payor</th>
            <th>Insurances</th>
            <th>Results</th>
            <th>Rankings</th>
          </tr>
        </thead>
        <tbody>
          <% if @product_rankings.present? %>
            <% @product_rankings.each do |ranking| %>
              <tr class="table-row">
                <td><span class="badge badge-light">#<%= ranking.id %></span></td>
                <td class="fw-bold text-primary"><%= ranking.generic_name_group %></td>
                <td><%= ranking.team_id %></td>
                <td><span class="badge badge-date"><i class="far fa-calendar-alt"></i> Q<%= ranking.accounting_period_id %></span></td>
                <td><%= ranking.payor %></td>
                <td>
                  <div class="tags-container">
                    <% rankings_insurances = ranking.insurances.is_a?(String) ? JSON.parse(ranking.insurances) : ranking.insurances %>
                    <% Array(rankings_insurances).each do |ins| %>
                      <span class="badge badge-info"><%= ins %></span>
                    <% end %>
                  </div>
                </td>
                <td>
                  <pre class="json-block"><%= JSON.pretty_generate(ranking.results.is_a?(String) ? JSON.parse(ranking.results) : ranking.results) rescue ranking.results %></pre>
                </td>
                <td>
                  <pre class="json-block ranking-block"><%= JSON.pretty_generate(ranking.rankings.is_a?(String) ? JSON.parse(ranking.rankings) : ranking.rankings) rescue ranking.rankings %></pre>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="8" class="text-center py-5">
                <div class="empty-state">
                  <i class="fas fa-chart-bar empty-icon"></i>
                  <h3>No Rankings Available</h3>
                  <p>Check back later or generate new rankings from the backend.</p>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  :root {
    --primary: #4361ee;
    --secondary: #7209b7;
    --success: #06d6a0;
    --info: #4cc9f0;
    --warning: #ffb703;
    --danger: #ef233c;
    --dark: #2b2d42;
    --gray: #8d99ae;
    --light: #f8f9fc;
    --white: #ffffff;
    --glass-bg: rgba(255, 255, 255, 0.95);
    --shadow-sm: 0 4px 6px rgba(0, 0, 0, 0.05);
    --shadow-md: 0 10px 30px rgba(0, 0, 0, 0.08);
    --border-radius: 12px;
    --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  body {
    background-color: var(--light);
    font-family: 'Inter', 'Segoe UI', Roboto, sans-serif;
  }

  .product-rankings-dashboard {
    padding: 3rem 0 5rem;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Header Styles */
  .dashboard-header {
    background: var(--white);
    padding: 2rem;
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-sm);
    margin-bottom: 2rem;
  }

  .header-content h1 {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--dark);
    margin: 0 0 0.5rem 0;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .header-content p {
    color: var(--gray);
    margin: 0;
    font-size: 1.1rem;
  }

  /* Buttons */
  .btn-outline-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border: 2px solid var(--primary);
    background: transparent;
    color: var(--primary);
    border-radius: 50px;
    font-weight: 600;
    text-decoration: none;
    transition: var(--transition);
  }

  .btn-outline-primary:hover {
    background: var(--primary);
    color: var(--white);
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(67, 97, 238, 0.2);
  }

  /* Filters Styles */
  .filters-container {
    background: var(--white);
    border-radius: var(--border-radius);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    margin-bottom: 2rem;
  }

  .filter-form {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-end;
  }

  .filter-group {
    flex: 1;
    min-width: 200px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .filter-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--gray);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .form-control {
    padding: 0.75rem 1rem;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-size: 0.95rem;
    color: var(--dark);
    transition: var(--transition);
  }

  .form-control:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.15);
  }

  .filter-actions {
    display: flex;
    gap: 1rem;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--primary) 0%, #6c8aff 100%);
    border: none;
    color: white;
    border-radius: 50px;
    padding: 0.75rem 1.5rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
    box-shadow: 0 4px 15px rgba(67, 97, 238, 0.2);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(67, 97, 238, 0.3);
  }

  /* Table Styles */
  .table-container {
    background: var(--white);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-md);
    overflow: auto;
    padding: 1rem;
  }

  .premium-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
  }

  .premium-table th {
    background: var(--light);
    color: var(--gray);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.5px;
    padding: 1rem 1.5rem;
    text-align: left;
    border-bottom: 2px solid #edf2f7;
    white-space: nowrap;
  }

  .premium-table th:first-child {
    border-top-left-radius: 8px;
  }

  .premium-table th:last-child {
    border-top-right-radius: 8px;
  }

  .premium-table td {
    padding: 1.25rem 1.5rem;
    vertical-align: top;
    border-bottom: 1px solid #edf2f7;
    color: var(--dark);
    font-size: 0.95rem;
  }

  .table-row {
    transition: var(--transition);
  }

  .table-row:hover {
    background-color: rgba(67, 97, 238, 0.02);
  }

  .table-row:last-child td {
    border-bottom: none;
  }

  /* Badges */
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .badge-light {
    background: #f1f5f9;
    color: #64748b;
  }

  .badge-date {
    background: rgba(76, 201, 240, 0.1);
    color: var(--info);
    gap: 0.4rem;
  }

  .badge-info {
    background: rgba(67, 97, 238, 0.1);
    color: var(--primary);
    margin-right: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    max-width: 200px;
  }

  /* Utilities */
  .fw-bold { font-weight: 700; }
  .text-primary { color: var(--primary); }
  .d-flex { display: flex; }
  .justify-content-between { justify-content: space-between; }
  .align-items-center { align-items: center; }

  /* JSON Blocks */
  .json-block {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1rem;
    font-family: 'Fira Code', 'Monaco', monospace;
    font-size: 0.8rem;
    color: #334155;
    max-width: 300px;
    max-height: 200px;
    overflow-y: auto;
    white-space: pre-wrap;
    word-break: break-all;
  }

  .ranking-block {
    background: rgba(114, 9, 183, 0.03);
    border-color: rgba(114, 9, 183, 0.1);
    color: var(--secondary);
  }

  /* Empty State */
  .empty-state {
    padding: 3rem 0;
  }
  .empty-icon {
    font-size: 4rem;
    color: #cbd5e1;
    margin-bottom: 1.5rem;
  }
  .empty-state h3 {
    color: var(--dark);
    margin-bottom: 0.5rem;
  }
  .empty-state p {
    color: var(--gray);
  }

  /* Animations */
  .fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
