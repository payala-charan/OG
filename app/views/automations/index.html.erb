<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Automations Hub</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --primary: #4361ee;
      --secondary: #7209b7;
      --accent: #4cc9f0;
      --dark: #2b2d42;
      --gray: #8d99ae;
      --light: #f8f9fc;
      --success: #06d6a0;
      --border-radius: 20px;
      --shadow: 0 10px 30px rgba(0,0,0,0.08);
      --transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    body {
      margin: 0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: linear-gradient(135deg, #f5f7ff 0%, #f0f4ff 100%);
      color: var(--dark);
      min-height: 100vh;
    }

    .automations-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem;
    }

    .page-header {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      padding: 1.5rem 2rem;
      border-radius: var(--border-radius);
      margin-bottom: 3rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border: 1px solid rgba(255,255,255,0.8);
    }

    .header-content {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .back-btn {
      background: transparent;
      border: 2px solid var(--primary);
      color: var(--primary);
      border-radius: 50px;
      padding: 0.6rem 1.5rem;
      font-weight: 600;
      text-decoration: none;
      transition: var(--transition);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .back-btn:hover {
      background: var(--primary);
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 6px 15px rgba(67, 97, 238, 0.3);
    }

    .page-title h1 {
      margin: 0;
      font-size: 2rem;
      font-weight: 800;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .page-title p {
      margin: 0.2rem 0 0 0;
      color: var(--gray);
      font-size: 1rem;
    }

    .automations-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 2.5rem;
      max-width: 1000px;
      margin: 0 auto;
    }

    .automation-card {
      background: white;
      border-radius: var(--border-radius);
      padding: 3rem 2rem;
      text-align: center;
      text-decoration: none;
      color: inherit;
      box-shadow: var(--shadow);
      transition: var(--transition);
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(67, 97, 238, 0.1);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 300px;
    }

    .automation-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: linear-gradient(90deg, var(--primary), var(--secondary));
      opacity: 0;
      transition: var(--transition);
    }

    .automation-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 20px 40px rgba(67, 97, 238, 0.15);
    }

    .automation-card:hover::before {
      opacity: 1;
    }

    .card-icon {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      background: linear-gradient(135deg, rgba(67, 97, 238, 0.1), rgba(114, 9, 183, 0.1));
      color: var(--primary);
      font-size: 2.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.5rem;
      transition: var(--transition);
    }

    .automation-card:hover .card-icon {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: white;
      transform: scale(1.1) rotate(5deg);
    }

    .card-content h2 {
      margin: 0 0 1rem 0;
      font-size: 1.8rem;
      font-weight: 700;
      color: var(--dark);
    }

    .card-content p {
      margin: 0;
      color: var(--gray);
      line-height: 1.6;
      font-size: 1.05rem;
    }

    .card-badge {
      position: absolute;
      top: 1.5rem;
      right: 1.5rem;
      background: rgba(6, 214, 160, 0.1);
      color: #047857;
      padding: 0.4rem 1rem;
      border-radius: 50px;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* Conversions Specific Colors */
    .card-conversions:hover .card-icon {
      background: linear-gradient(135deg, #4cc9f0, #4361ee);
    }
    .card-conversions::before {
      background: linear-gradient(90deg, #4cc9f0, #4361ee);
    }

    /* Rankings Specific Colors */
    .card-rankings:hover .card-icon {
      background: linear-gradient(135deg, #f72585, #7209b7);
    }
    .card-rankings::before {
      background: linear-gradient(90deg, #f72585, #7209b7);
    }
    
    @media (max-width: 768px) {
      .automations-container { padding: 1rem; }
      .page-header { flex-direction: column; text-align: center; gap: 1rem; }
      .header-content { flex-direction: column; }
    }
  </style>
</head>
<body>
  <div class="automations-container">
    <header class="page-header">
      <div class="header-content">
        <%= link_to features_path, class: "back-btn" do %>
          <i class="fas fa-arrow-left"></i>
          <span>Features</span>
        <% end %>
        <div class="page-title">
          <h1>Automations Hub</h1>
          <p>Select an automated workflow to proceed</p>
        </div>
      </div>
    </header>

    <div class="automations-grid">
      <!-- Conversions Card -->
      <%= link_to auto_validation_path, class: "automation-card card-conversions" do %>
        <div class="card-badge">Available</div>
        <div class="card-icon">
          <i class="fas fa-file-excel"></i>
        </div>
        <div class="card-content">
          <h2>Conversions</h2>
          <p>Automate your utilization report parsing & validation using the automated downloading flow.</p>
        </div>
      <% end %>

      <!-- Rankings Card -->
      <%= link_to auto_ranking_path, class: "automation-card card-rankings" do %>
        <div class="card-badge">Available</div>
        <div class="card-icon">
          <i class="fas fa-list-ol"></i>
        </div>
        <div class="card-content">
          <h2>Rankings</h2>
          <p>Fetch your expanded rankings sheets and automatically calculate matching payor margins.</p>
        </div>
      <% end %>
    </div>
  </div>
</body>
</html>
