<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Brand Insurance Mapper — Modern UI</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <style>
    :root {
      --primary: #4361ee;
      --primary-light: #6c8aff;
      --primary-dark: #3a56d4;
      --secondary: #7209b7;
      --accent: #4cc9f0;
      --danger: #f72585;
      --warning: #ff9e00;
      --success: #06d6a0;
      --light: #f8f9fc;
      --dark: #2b2d42;
      --gray: #8d99ae;
      --border-radius: 16px;
      --shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      --transition: all 0.4s ease;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', 'Segoe UI', sans-serif;
      color: var(--dark);
      background: linear-gradient(135deg, #f5f7ff 0%, #f0f4ff 100%);
      min-height: 100vh;
      line-height: 1.6;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem;
    }

    /* Header Styles */
    .header {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border-radius: var(--border-radius);
      padding: 2rem;
      margin-bottom: 2rem;
      box-shadow: var(--shadow);
      border: 1px solid rgba(255, 255, 255, 0.8);
    }

    .header-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1.5rem;
    }

    .header-text h1 {
      font-weight: 800;
      font-size: 2.5rem;
      margin-bottom: 0.5rem;
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .header-text p {
      color: var(--gray);
      font-size: 1.1rem;
    }

    .header-actions {
      display: flex;
      gap: 1rem;
    }

    .back-btn {
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
      color: white;
      border: none;
      border-radius: 50px;
      padding: 0.8rem 1.5rem;
      font-weight: 600;
      text-decoration: none;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      box-shadow: 0 6px 20px rgba(67, 97, 238, 0.3);
    }

    .back-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(67, 97, 238, 0.4);
      color: white;
      text-decoration: none;
    }

    .clear-btn {
      background: linear-gradient(135deg, var(--danger) 0%, #f55f7c 100%);
      color: white;
      border: none;
      border-radius: 50px;
      padding: 0.8rem 1.5rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      box-shadow: 0 6px 20px rgba(247, 37, 133, 0.3);
    }

    .clear-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(247, 37, 133, 0.4);
      color: white;
    }

    /* Alert Banner */
    .alert-banner {
      padding: 1rem 1.5rem;
      border-radius: var(--border-radius);
      margin-bottom: 2rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      box-shadow: var(--shadow);
    }

    .alert-banner.notice {
      background-color: rgba(6, 214, 160, 0.1);
      border-left: 5px solid var(--success);
      color: #04926c;
    }

    .alert-banner.alert {
      background-color: rgba(247, 37, 133, 0.1);
      border-left: 5px solid var(--danger);
      color: #c51b65;
    }

    /* Grid Layout */
    .dashboard-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 2rem;
    }

    @media (max-width: 992px) {
      .dashboard-grid {
        grid-template-columns: 1fr;
      }
    }

    /* Uploader Section */
    .uploader-card {
      background: white;
      border-radius: var(--border-radius);
      padding: 2.5rem;
      box-shadow: var(--shadow);
      border: 1px solid rgba(255, 255, 255, 0.8);
      display: flex;
      flex-direction: column;
    }

    .uploader-card h2 {
      font-weight: 700;
      font-size: 1.5rem;
      color: var(--dark);
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .upload-zone {
      border: 3px dashed var(--primary-light);
      border-radius: var(--border-radius);
      padding: 3rem 1.5rem;
      text-align: center;
      background: rgba(67, 97, 238, 0.01);
      transition: var(--transition);
      cursor: pointer;
      margin-bottom: 1.5rem;
    }

    .upload-zone:hover {
      border-color: var(--primary);
      background: rgba(67, 97, 238, 0.03);
    }

    .upload-zone-icon {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.25rem;
      color: white;
      font-size: 2rem;
      box-shadow: 0 8px 15px rgba(67, 97, 238, 0.2);
    }

    .upload-zone h3 {
      font-weight: 700;
      font-size: 1.3rem;
      margin-bottom: 0.5rem;
      color: var(--dark);
    }

    .upload-zone p {
      color: var(--gray);
      font-size: 0.95rem;
      margin-bottom: 1rem;
    }

    .file-input {
      display: none;
    }

    .file-selected-info {
      margin-top: 1rem;
      padding: 0.75rem 1rem;
      background: var(--light);
      border-radius: 10px;
      display: none;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-weight: 600;
      color: var(--success);
      border: 1px solid rgba(6, 214, 160, 0.2);
    }

    .submit-btn {
      width: 100%;
      background: linear-gradient(135deg, var(--success) 0%, #05c291 100%);
      color: white;
      border: none;
      border-radius: 50px;
      padding: 1rem;
      font-weight: 700;
      font-size: 1.1rem;
      cursor: pointer;
      transition: var(--transition);
      box-shadow: 0 6px 20px rgba(6, 214, 160, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
    }

    .submit-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(6, 214, 160, 0.4);
    }

    /* History Card */
    .history-card {
      background: white;
      border-radius: var(--border-radius);
      padding: 2rem;
      box-shadow: var(--shadow);
      border: 1px solid rgba(255, 255, 255, 0.8);
      max-height: 500px;
      overflow-y: auto;
    }

    .history-card h2 {
      font-weight: 700;
      font-size: 1.3rem;
      color: var(--dark);
      margin-bottom: 1.25rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .history-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .history-item {
      border: 1px solid #f1f3f9;
      border-radius: 12px;
      padding: 1rem;
      transition: var(--transition);
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      background: #fcfdfe;
    }

    .history-item:hover {
      border-color: var(--primary-light);
      background: rgba(67, 97, 238, 0.01);
      transform: translateX(4px);
    }

    .history-item-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    .history-item-title {
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--dark);
      text-overflow: ellipsis;
      overflow: hidden;
      white-space: nowrap;
      max-width: 180px;
    }

    .history-item-date {
      font-size: 0.75rem;
      color: var(--gray);
    }

    .history-item-actions {
      display: flex;
      gap: 0.75rem;
      margin-top: 0.5rem;
    }

    .item-btn {
      flex: 1;
      text-align: center;
      padding: 0.5rem;
      font-size: 0.8rem;
      font-weight: 600;
      border-radius: 6px;
      text-decoration: none;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.35rem;
    }

    .item-btn.view {
      background: rgba(67, 97, 238, 0.08);
      color: var(--primary);
    }

    .item-btn.view:hover {
      background: var(--primary);
      color: white;
    }

    .item-btn.dl {
      background: rgba(6, 214, 160, 0.08);
      color: var(--success);
    }

    .item-btn.dl:hover {
      background: var(--success);
      color: white;
    }

    /* Explanation Area */
    .explanation-card {
      grid-column: span 2;
      background: linear-gradient(135deg, #2b2d42 0%, #1e2030 100%);
      color: white;
      border-radius: var(--border-radius);
      padding: 2rem;
      margin-top: 2rem;
      box-shadow: var(--shadow);
    }

    @media (max-width: 992px) {
      .explanation-card {
        grid-column: span 1;
      }
    }

    .explanation-card h2 {
      font-weight: 700;
      font-size: 1.5rem;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--accent);
    }

    .explanation-card p {
      color: #cbd5e1;
      margin-bottom: 1.5rem;
      line-height: 1.7;
    }

    .explanation-steps {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
    }

    .exp-step {
      background: rgba(255, 255, 255, 0.05);
      border-radius: 12px;
      padding: 1.25rem;
      border-left: 4px solid var(--accent);
    }

    .exp-step h3 {
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: white;
    }

    .exp-step p {
      font-size: 0.88rem;
      color: #94a3b8;
      margin-bottom: 0;
      line-height: 1.5;
    }

    /* Loading Overlay */
    .loading-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(5px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .loading-overlay.active {
      opacity: 1;
      pointer-events: all;
    }

    .loading-card {
      background: white;
      padding: 3rem;
      border-radius: var(--border-radius);
      text-align: center;
      box-shadow: 0 20px 50px rgba(0,0,0,0.3);
      max-width: 400px;
      width: 90%;
    }

    .spinner {
      font-size: 3.5rem;
      color: var(--primary);
      animation: spin 1s linear infinite;
      margin-bottom: 1.5rem;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .loading-card h3 {
      font-weight: 700;
      font-size: 1.4rem;
      margin-bottom: 0.5rem;
      color: var(--dark);
    }

    .loading-card p {
      color: var(--gray);
      font-size: 0.95rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <header class="header">
      <div class="header-content">
        <div class="header-text">
          <h1>Brand Insurance Mapper</h1>
          <p>Extract and cross-reference insurance details mapped across brand products</p>
        </div>
        <div class="header-actions">
          <%= link_to features_path, class: "back-btn" do %>
            <i class="fas fa-arrow-left"></i> Dashboard
          <% end %>
          <% if @records.any? %>
            <%= button_to clear_history_brand_insurance_mappings_path, method: :delete, class: "clear-btn", data: { confirm: "Are you sure you want to clear mapping run history?" } do %>
              <i class="fas fa-trash-alt"></i> Clear History
            <% end %>
          <% end %>
        </div>
      </div>
    </header>

    <!-- Flash Messages -->
    <% flash.each do |type, message| %>
      <div class="alert-banner <%= type %>">
        <i class="<%= type == 'notice' ? 'fas fa-check-circle' : 'fas fa-exclamation-triangle' %>"></i>
        <span><%= message %></span>
      </div>
    <% end %>

    <!-- Dashboard Content Grid -->
    <div class="dashboard-grid">
      <!-- File Upload Block -->
      <div class="uploader-card">
        <h2><i class="fas fa-file-upload text-primary"></i> Upload Mapping File</h2>
        <%= form_with url: brand_insurance_mappings_path, method: :post, local: true, multipart: true, id: "uploadForm" do |f| %>
          <div class="upload-zone" onclick="document.getElementById('fileInput').click()">
            <div class="upload-zone-icon">
              <i class="fas fa-file-excel"></i>
            </div>
            <h3>Drag & Drop Excel File</h3>
            <p>Or click to browse from your computer (supported: .xlsx, .xls)</p>
            <%= f.file_field :file, class: "file-input", id: "fileInput", onchange: "handleFileSelect(this)" %>
            <div class="file-selected-info" id="fileZoneInfo">
              <i class="fas fa-check-circle"></i> <span class="file-name-span">No file selected</span>
            </div>
          </div>

          <%= f.submit "Compile Brand Mappings", class: "submit-btn", id: "submitBtn" %>
        <% end %>
      </div>

      <!-- History Run logs -->
      <div class="history-card">
        <h2><i class="fas fa-history text-secondary"></i> Mapping Run History</h2>
        <% if @records.any? %>
          <div class="history-list">
            <% @records.each do |record| %>
              <div class="history-item">
                <div class="history-item-header">
                  <span class="history-item-title" title="<%= record.file_name %>"><%= record.file_name %></span>
                  <span class="history-item-date"><%= record.created_at.strftime('%b %d, %H:%M') %></span>
                </div>
                <div class="history-item-actions">
                  <%= link_to brand_insurance_mapping_path(record), class: "item-btn view" do %>
                    <i class="fas fa-eye"></i> View Results
                  <% end %>
                  <%= link_to download_brand_insurance_mapping_path(record), class: "item-btn dl" do %>
                    <i class="fas fa-download"></i> Download
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div style="text-align: center; padding: 3rem 1rem; color: var(--gray);">
            <i class="fas fa-folder-open" style="font-size: 2.5rem; opacity: 0.5; margin-bottom: 0.5rem; display: block;"></i>
            <span>No processed files found.</span>
          </div>
        <% end %>
      </div>

      <!-- Explanatory Instructions -->
      <div class="explanation-card">
        <h2><i class="fas fa-info-circle"></i> How the Brand Insurance Mapper Works</h2>
        <p>This utility parses complex cross-referenced pharmaceutical brand mappings from raw grids into cleanly structured data segments instantly. Upload grids that map insurance configurations onto generic or specific drugs.</p>
        
        <div class="explanation-steps">
          <div class="exp-step">
            <h3>1. Column structure</h3>
            <p>Ensure the first column A contains insurance configurations (split by commas). Column B onwards contain product or brand names.</p>
          </div>
          <div class="exp-step">
            <h3>2. Preference flags</h3>
            <p>Preference cells containing <strong>Y</strong> or <strong>X</strong> (case-insensitive) are mapped as active coverage links.</p>
          </div>
          <div class="exp-step">
            <h3>3. Download Formats</h3>
            <p>Export mappings either as compiled brand lists or detailed normalized line-by-line arrays ready for importing.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Loading Animation Overlay -->
  <div class="loading-overlay" id="loadingOverlay">
    <div class="loading-card">
      <i class="fas fa-circle-notch spinner"></i>
      <h3>Compiling Mappings...</h3>
      <p>Parsing grid structure and extracting unique insurance mappings. Please wait.</p>
    </div>
  </div>

  <script>
    function handleFileSelect(input) {
      const fileInfo = document.getElementById('fileZoneInfo');
      const nameSpan = fileInfo.querySelector('.file-name-span');
      
      if (input.files && input.files.length > 0) {
        nameSpan.textContent = input.files[0].name;
        fileInfo.style.display = 'inline-flex';
      } else {
        fileInfo.style.display = 'none';
      }
    }

    document.getElementById('uploadForm').addEventListener('submit', function() {
      const fileInput = document.getElementById('fileInput');
      if (fileInput.files.length > 0) {
        document.getElementById('loadingOverlay').classList.add('active');
      }
    });

    // Support drag and drop visual state
    const uploadZone = document.querySelector('.upload-zone');
    ['dragenter', 'dragover'].forEach(eventName => {
      uploadZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        uploadZone.style.borderColor = 'var(--success)';
        uploadZone.style.background = 'rgba(6, 214, 160, 0.02)';
      }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
      uploadZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        uploadZone.style.borderColor = 'var(--primary-light)';
        uploadZone.style.background = 'rgba(67, 97, 238, 0.01)';
      }, false);
    });

    uploadZone.addEventListener('drop', (e) => {
      const dt = e.dataTransfer;
      const files = dt.files;
      const fileInput = document.getElementById('fileInput');
      fileInput.files = files;
      handleFileSelect(fileInput);
    }, false);
  </script>
</body>
</html>
