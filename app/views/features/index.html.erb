<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Features Dashboard</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
 <!-- app/views/features/index.html.erb -->
  <div class="features-dashboard">
    <!-- Header -->
    <header class="dashboard-header">
      <div class="container">
        <div class="header-content">
          <div class="welcome-section">
            <h1>Welcome to Your Dashboard</h1>
            <p>Choose from our powerful features to manage your data efficiently</p>
          </div>
          <div class="user-actions">
            <%= link_to root_path, method: :delete, class: "btn-login" do %>
              <i class="fas fa-sign-out-alt"></i> Home
            <% end %>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Features Grid -->
    <main class="features-main">
      <div class="container">
        <div class="section-title">
          <h2>Our Features</h2>
          <p>Powerful tools to streamline your workflow and enhance productivity</p>
        </div>

        <div class="features-grid">
          <!-- Excel Validation Feature -->
          <div class="feature-card" data-aos="fade-up">
            <div class="feature-icon">
              <i class="fas fa-file-excel"></i>
            </div>
            <div class="feature-content">
              <h3>Excel Validation</h3>
              <p>Validate and process your Excel files with advanced data integrity checks and automated validation rules.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> Data integrity validation</li>
                <li><i class="fas fa-check-circle"></i> Format verification</li>
                <li><i class="fas fa-check-circle"></i> Automated error detection</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= link_to validations_path, class: "btn-primary" do %>
                <i class="fas fa-play-circle"></i> Start Validation
              <% end %>
              <button class="btn-outline-primary" onclick="showFeatureInfo('excel')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>

          <!-- Document Storage Feature -->
          <div class="feature-card" data-aos="fade-up" data-aos-delay="100">
            <div class="feature-icon">
              <i class="fas fa-cloud-upload-alt"></i>
            </div>
            <div class="feature-content">
              <h3>Document Storage</h3>
              <p>Securely store, manage, and organize your documents with advanced search and retrieval capabilities.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> Secure cloud storage</li>
                <li><i class="fas fa-check-circle"></i> Advanced search</li>
                <li><i class="fas fa-check-circle"></i> Version control</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= link_to uploaded_files_path, class: "btn-primary" do %>
                <i class="fas fa-folder-open"></i> Manage Files
              <% end %>
              <button class="btn-outline-primary" onclick="showFeatureInfo('storage')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>

          <!-- Screen Analysis Feature -->
          <div class="feature-card" data-aos="fade-up" data-aos-delay="150">
            <div class="feature-icon">
              <i class="fas fa-desktop"></i>
            </div>
            <div class="feature-content">
              <h3>Screen Analysis</h3>
              <p>Upload screen images, add summaries, copy text quickly, and adjust image/text layout dynamically.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> Image + text entry per screen</li>
                <li><i class="fas fa-check-circle"></i> 70/30 default split with manual resize</li>
                <li><i class="fas fa-check-circle"></i> Copy summary instantly</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= link_to screen_analyses_path, class: "btn-primary" do %>
                <i class="fas fa-eye"></i> Open Screen Analysis
              <% end %>
              <button class="btn-outline-primary" onclick="showFeatureInfo('screen')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>

          <!-- Payor Analysis Feature -->
          <div class="feature-card" data-aos="fade-up" data-aos-delay="200">
            <div class="feature-icon">
              <i class="fas fa-chart-line"></i>
            </div>
            <div class="feature-content">
              <h3>Payor Analysis</h3>
              <p>Analyze payor preferences and generate insights to optimize your revenue cycle management.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> Preference analysis</li>
                <li><i class="fas fa-check-circle"></i> Trend identification</li>
                <li><i class="fas fa-check-circle"></i> Revenue optimization</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= link_to payor_preferences_path, class: "btn-primary" do %>
                <i class="fas fa-chart-bar"></i> View Analysis
              <% end %>
              <button class="btn-outline-primary" onclick="showFeatureInfo('payor')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>

          <!-- Biosimilar Upload Feature -->
          <div class="feature-card" data-aos="fade-up">
            <div class="feature-icon">
              <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <div class="feature-content">
              <h3>Biosimilar Upload</h3>
              <p>Upload and validate biosimilar price data with our advanced validation tools.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> Data integrity validation</li>
                <li><i class="fas fa-check-circle"></i> Format verification</li>
                <li><i class="fas fa-check-circle"></i> Analysis and reporting</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= link_to new_biosimilar_prices_path, class: "btn-primary" do %>
                <i class="fas fa-play-circle"></i> Upload Data
              <% end %>
              <button class="btn-outline-primary" onclick="showFeatureInfo('biosimilar')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>

          <!-- Product Preference Analysis Feature -->
          <div class="feature-card" data-aos="fade-up" data-aos-delay="100">
            <div class="feature-icon">
              <i class="fas fa-search"></i>
            </div>
            <div class="feature-content">
              <h3>Product Preference Analysis</h3>
              <p>Analyze product preferences and generate insights to optimize your marketing and sales strategies.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> Preference analysis</li>
                <li><i class="fas fa-check-circle"></i> Trend identification</li>
                <li><i class="fas fa-check-circle"></i> Revenue optimization</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= link_to product_preference_records_path, class: "btn-primary" do %>
                <i class="fas fa-chart-bar"></i> View Analysis
              <% end %>
              <button class="btn-outline-primary" onclick="showFeatureInfo('preference')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>

          <!-- Rankings Validation Feature -->
          <div class="feature-card" data-aos="fade-up" data-aos-delay="200">
            <div class="feature-icon">
              <i class="fas fa-list-ol"></i>
            </div>
            <div class="feature-content">
              <h3>Rankings Validation</h3>
              <p>Validate and analyze rankings data to ensure accuracy and consistency.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> Reference analysis</li>
                <li><i class="fas fa-check-circle"></i> Data consistency checks</li>
                <li><i class="fas fa-check-circle"></i> Validation reports</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= link_to ranking_records_path, class: "btn-primary" do %>
                <i class="fas fa-chart-bar"></i> View Analysis
              <% end %>
              <button class="btn-outline-primary" onclick="showFeatureInfo('rankings')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>

          <!-- Screening Code Feature -->
          <div class="feature-card" data-aos="fade-up" data-aos-delay="300">
            <div class="feature-icon">
              <i class="fas fa-robot"></i>
            </div>
            <div class="feature-content">
              <h3>Voice Assistance</h3>
              <p>Interact with our AI assistant using voice commands and get instant voice responses for your queries.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> Voice command recognition</li>
                <li><i class="fas fa-check-circle"></i> Real-time voice responses</li>
                <li><i class="fas fa-check-circle"></i> Natural conversation flow</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= link_to voice_path, class: "btn-primary" do %>
                <i class="fas fa-microphone"></i> Start Voice Chat
              <% end %>
              <button class="btn-outline-primary" onclick="showFeatureInfo('voice')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>

          <!-- Schema Analysis Feature -->
          <div class="feature-card" data-aos="fade-up" data-aos-delay="400">
            <div class="feature-icon">
              <i class="fas fa-project-diagram"></i>
            </div>
            <div class="feature-content">
              <h3>Schema Mapping</h3>
              <p>Generate highly interactive relational database diagrams instantly from your application schema.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> Drag and Drop generation</li>
                <li><i class="fas fa-check-circle"></i> Inferred relational mapping</li>
                <li><i class="fas fa-check-circle"></i> Detailed interactive column view</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= link_to schema_visualizers_path, class: "btn-primary" do %>
                <i class="fas fa-sitemap"></i> Map Database
              <% end %>
              <button class="btn-outline-primary" onclick="showFeatureInfo('schema_mapping')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>

          <!-- GitHub Analytics Feature -->
          <div class="feature-card" data-aos="fade-up" data-aos-delay="500">
            <div class="feature-icon">
              <i class="fab fa-github"></i>
            </div>
            <div class="feature-content">
              <h3>GitHub Analytics</h3>
              <p>Connect your GitHub account to analyze organizational repositories, pull requests, and author contributions dynamically.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> Real-time PR Tracking</li>
                <li><i class="fas fa-check-circle"></i> Historical timelines</li>
                <li><i class="fas fa-check-circle"></i> Interactive data charts</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= link_to github_path, class: "btn-primary" do %>
                <i class="fas fa-chart-line"></i> View Analytics
              <% end %>
              <button class="btn-outline-primary" onclick="showFeatureInfo('github')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>

          <!-- Automations Feature -->
          <div class="feature-card" data-aos="fade-up" data-aos-delay="600">
            <div class="feature-icon">
              <i class="fas fa-magic"></i>
            </div>
            <div class="feature-content">
              <h3>Automations</h3>
              <p>Trigger automated workflows that download sheets, validate data, map rankings and store results instantly.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> One-click automation</li>
                <li><i class="fas fa-check-circle"></i> Support for conversions & rankings</li>
                <li><i class="fas fa-check-circle"></i> Instant results storage</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= link_to automations_path, class: "btn-primary" do %>
                <i class="fas fa-play-circle"></i> Start Automations
              <% end %>
              <button class="btn-outline-primary" onclick="showFeatureInfo('auto_validation')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>
          <!-- Browser Automation Feature -->
          <div class="feature-card" data-aos="fade-up" data-aos-delay="700">
            <div class="feature-icon">
              <i class="fas fa-vials"></i>
            </div>
            <div class="feature-content">
              <h3>Browser Tests</h3>
              <p>Trigger end-to-end Capybara browser tests natively through the background job runner.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> Visual UI Testing</li>
                <li><i class="fas fa-check-circle"></i> Headless support ready</li>
                <li><i class="fas fa-check-circle"></i> Non-blocking execution</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= button_to run_automation_path, method: :post, class: "btn-primary" do %>
                <i class="fas fa-play"></i> Run Tests
              <% end %>
              <br>
              <button class="btn-outline-primary" onclick="showFeatureInfo('browser_tests')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>
          <!-- Alert Notifications Feature -->
          <div class="feature-card" data-aos="fade-up" data-aos-delay="800">
            <div class="feature-icon">
              <i class="fas fa-bell"></i>
            </div>
            <div class="feature-content">
              <h3>Alert Hub</h3>
              <p>Manage email subscribers and automatically dispatch error notifications to the team when pipelines fail.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> Seamless EmailJS Integration</li>
                <li><i class="fas fa-check-circle"></i> Dynamic Error Parsing</li>
                <li><i class="fas fa-check-circle"></i> Automated Dispatching</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= link_to alert_emails_path, class: "btn-primary" do %>
                <i class="fas fa-envelope-open-text"></i> Open Alert Hub
              <% end %>
              <br>
              <button class="btn-outline-primary" onclick="showFeatureInfo('alerts')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>
          
          <!-- Auto Scheduler Feature -->
          <div class="feature-card" data-aos="fade-up" data-aos-delay="800">
            <div class="feature-icon">
              <i class="fas fa-calendar-alt"></i>
            </div>
            <div class="feature-content">
              <h3>Global Auto Scheduler</h3>
              <p>Execute exhaustive 100-combination validation pipeline routines via background Jobs.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> Batch Job Spawning</li>
                <li><i class="fas fa-check-circle"></i> Granular Live Tracking</li>
                <li><i class="fas fa-check-circle"></i> 100+ Network Permutations</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= link_to automation_schedules_path, class: "btn-primary" do %>
                <i class="fas fa-server"></i> Open Scheduler
              <% end %>
              <br>
              <button class="btn-outline-primary" onclick="showFeatureInfo('scheduler')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>

          <!-- Pricing Catalogs Feature -->
          <div class="feature-card" data-aos="fade-up" data-aos-delay="900">
            <div class="feature-icon">
              <i class="fas fa-file-excel"></i>
            </div>
            <div class="feature-content">
              <h3>Pricing Catalogs</h3>
              <p>Upload your massive Excel dataset and provide NDC codes to compute automated analytics.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> Dynamic Column Mapping</li>
                <li><i class="fas fa-check-circle"></i> Mathematical Operations</li>
                <li><i class="fas fa-check-circle"></i> Instant File Processing</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= link_to pricing_catalogs_path, class: "btn-primary" do %>
                <i class="fas fa-calculator"></i> Open Catalogs
              <% end %>
              <br>
              <button class="btn-outline-primary" onclick="showFeatureInfo('pricing_catalogs')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>

          <!-- Rails Console Feature -->
          <div class="feature-card" data-aos="fade-up" data-aos-delay="950">
            <div class="feature-icon">
              <i class="fas fa-terminal"></i>
            </div>
            <div class="feature-content">
              <h3>Rails Console</h3>
              <p>Execute Ruby/Rails queries safely across different projects with real-time results and data protection.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> Cross-project query execution</li>
                <li><i class="fas fa-check-circle"></i> Destructive operation blocking</li>
                <li><i class="fas fa-check-circle"></i> Real-time result display</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= link_to console_path, class: "btn-primary" do %>
                <i class="fas fa-code"></i> Open Console
              <% end %>
              <br>
              <button class="btn-outline-primary" onclick="showFeatureInfo('rails_console')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>

          <!-- Product Rankings Feature -->
          <div class="feature-card" data-aos="fade-up" data-aos-delay="1000">
            <div class="feature-icon">
              <i class="fas fa-trophy"></i>
            </div>
            <div class="feature-content">
              <h3>Product Rankings</h3>
              <p>Comprehensive overview of margin-based biosimilar product rankings matched across insurances.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> Best Margin Detection</li>
                <li><i class="fas fa-check-circle"></i> Dynamic Insurance Mapping</li>
                <li><i class="fas fa-check-circle"></i> Auto Rank Assignments</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= link_to product_rankings_path, class: "btn-primary" do %>
                <i class="fas fa-chart-bar"></i> View Rankings
              <% end %>
              <br>
              <button class="btn-outline-primary" onclick="showFeatureInfo('product_rankings')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>
          <!-- Universal File Conversion Feature -->
          <div class="feature-card" data-aos="fade-up" data-aos-delay="1050">
            <div class="feature-icon">
              <i class="fas fa-file-export"></i>
            </div>
            <div class="feature-content">
              <h3>Universal File Conversion</h3>
              <p>Convert various file formats (CSV, PDF, TXT, DOCX) to a clean Excel spreadsheet instantly.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> Multiple format support</li>
                <li><i class="fas fa-check-circle"></i> Automatic text extraction</li>
                <li><i class="fas fa-check-circle"></i> Instant download</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= link_to file_conversions_path, class: "btn-primary" do %>
                <i class="fas fa-exchange-alt"></i> Convert Files
              <% end %>
              <br>
              <button class="btn-outline-primary" onclick="showFeatureInfo('file_conversion')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>
          <!-- Excel Tally Validation Feature -->
          <div class="feature-card" data-aos="fade-up" data-aos-delay="1100">
            <div class="feature-icon" style="background: linear-gradient(135deg, var(--secondary) 0%, #a03cff 100%);">
              <i class="fas fa-balance-scale"></i>
            </div>
            <div class="feature-content">
              <h3>Excel Tally Validation</h3>
              <p>Reconcile Individual Records against Grouped spreadsheets side-by-side to identify data integrity variances.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> Double-file validation</li>
                <li><i class="fas fa-check-circle"></i> 15-column cell comparison</li>
                <li><i class="fas fa-check-circle"></i> Visual discrepancy reports</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= link_to tally_validations_path, class: "btn-primary" do %>
                <i class="fas fa-check-double"></i> Start Tally Check
              <% end %>
              <button class="btn-outline-primary" onclick="showFeatureInfo('tally_validation')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>
          <!-- Insurance Preference Validator Feature -->
          <div class="feature-card" data-aos="fade-up" data-aos-delay="1125">
            <div class="feature-icon" style="background: linear-gradient(135deg, var(--success) 0%, var(--primary) 100%);">
              <i class="fas fa-shield-alt"></i>
            </div>
            <div class="feature-content">
              <h3>Insurance Preference Validator</h3>
              <p>Compare Biosimilar insurance lists against the Master preference table, flag missing/extra plans, and download a color-coded workbook.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> Deterministic code validation</li>
                <li><i class="fas fa-check-circle"></i> Optional model second opinion</li>
                <li><i class="fas fa-check-circle"></i> Formula-safe Excel annotation</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= link_to insurance_preference_validations_path, class: "btn-primary" do %>
                <i class="fas fa-shield-alt"></i> Open Validator
              <% end %>
              <button class="btn-outline-primary" onclick="showFeatureInfo('insurance_pref')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>
          <!-- Brand Insurance Mapper Feature -->
          <div class="feature-card" data-aos="fade-up" data-aos-delay="1150">
            <div class="feature-icon" style="background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);">
              <i class="fas fa-project-diagram"></i>
            </div>
            <div class="feature-content">
              <h3>Brand Insurance Mapper</h3>
              <p>Extract unique insurance networks mapped to individual pharmaceutical brands from visual grid matrices.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> Grid matrix parsing</li>
                <li><i class="fas fa-check-circle"></i> Comma-separated splitting</li>
                <li><i class="fas fa-check-circle"></i> Normalized Excel downloads</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= link_to brand_insurance_mappings_path, class: "btn-primary" do %>
                <i class="fas fa-project-diagram"></i> Open Mapper
              <% end %>
              <button class="btn-outline-primary" onclick="showFeatureInfo('brand_mapping')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>

          <!-- Quarter Status Feature -->
          <div class="feature-card" data-aos="fade-up" data-aos-delay="1200">
            <div class="feature-icon" style="background: linear-gradient(135deg, var(--secondary) 0%, var(--danger) 100%);">
              <i class="fas fa-chart-pie"></i>
            </div>
            <div class="feature-content">
              <h3>Quarter Status Dashboard</h3>
              <p>Monitor existing data load status for teams and accounting periods across prices, payors, and preference models.</p>
              <ul class="feature-benefits">
                <li><i class="fas fa-check-circle"></i> Three-table data statuses</li>
                <li><i class="fas fa-check-circle"></i> Extract metrics summary</li>
                <li><i class="fas fa-check-circle"></i> Developer Note instructions</li>
              </ul>
            </div>
            <div class="feature-actions">
              <%= link_to quarter_statuses_path, class: "btn-primary" do %>
                <i class="fas fa-chart-pie"></i> View Statuses
              <% end %>
              <button class="btn-outline-primary" onclick="showFeatureInfo('quarter_status')">
                <i class="fas fa-info-circle"></i> Learn More
              </button>
            </div>
          </div>

