          description: 'Upload a Master insurance preference workbook and a Biosimilar sheet to validate covered plans per brand, then download an annotated copy with a color-coded Claude Insurances column.',
          features: [
            'Parses stacked Master category blocks and unions Y-marked plans per brand',
            'Fuzzy brand matching with Leuprolide family+month rules and explicit overrides',
            'Insurance comparison that avoids false substring matches',
            'Optional LLM second-opinion pass that never replaces the code result'
          ],
          benefits: [
            'Catch missing required plans before a sheet is published',
            'Keep live cost/margin formulas intact when inserting the output column',
            'Review spelling variants separately from truly missing coverage'
          ]
        },
        brand_mapping: {
          title: 'Brand Insurance Mapper',
          description: 'A dedicated utility designed to extract, compile, and clean brand preference matrices mapping coverage options dynamically.',
          features: [
            'Dynamic grid column mapping for drug names and rows for payor lines',
            'Robust splitting of comma-separated multiple insurance items',
            'Full support for Y and X mapping values',
            'Zebra-striped formatted multi-sheet Excel generation'
          ],
          benefits: [
            'Say goodbye to manually copy-pasting complex excel grid files',
            'Export dual reports: summary and normalized details simultaneously',
            'Seamlessly integrate output mappings into target billing systems'
          ]
        },
        quarter_status: {
          title: 'Quarter Status Dashboard',
          description: 'A read-only dashboard showing the data coverage status of team IDs and accounting periods across three primary tables, complete with developer instructions.',
          features: [
            'Dynamic counts compilation for NewBiosimilarPrice, Payor, and PayorPreference tables',
            'Granular extraction status for brand names, strengths, and insurance arrays',
            'Interactive copy-to-clipboard buttons for developer jobs & seed runners'
          ],
          benefits: [
            'Gain immediate visibility into data load completeness across teams',
            'Easily reference correct rails runner and console commands',
            'Zero model dependencies or risky file system write side-effects'
          ]
        }
      };

      const info = featureInfo[feature];
      content.innerHTML = `
        <h2 style="color: var(--primary); margin-bottom: 1rem;">${info.title}</h2>
        <p style="color: var(--gray); margin-bottom: 2rem; line-height: 1.6;">${info.description}</p>
        
        <h3 style="color: var(--dark); margin-bottom: 1rem;">Key Features:</h3>
        <ul class="feature-list">
          ${info.features.map(feature => `<li><i class="fas fa-check"></i> ${feature}</li>`).join('')}
        </ul>
        
        <h3 style="color: var(--dark); margin-bottom: 1rem; margin-top: 2rem;">Benefits:</h3>
        <ul class="benefits-list">
          ${info.benefits.map(benefit => `<li><i class="fas fa-star"></i> ${benefit}</li>`).join('')}
        </ul>
      `;

      modal.style.display = 'block';
    }

    function closeFeatureInfo() {
      document.getElementById('featureModal').style.display = 'none';
    }

    // Close modal when clicking outside
    window.onclick = function(event) {
      const modal = document.getElementById('featureModal');
      if (event.target === modal) {
        closeFeatureInfo();
      }
    }

    // Initialize when page loads
    document.addEventListener('DOMContentLoaded', function() {
      initAOS();
    });
  </script>
</body>
</html>