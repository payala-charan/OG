<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Global Automation Scheduler</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style data-theme-style="classic" media="<%= theme_media(:classic) %>">
    :root {
      --primary: #4361ee;
      --primary-light: #6c8aff;
      --primary-dark: #3a56d4;
      --secondary: #7209b7;
      --accent: #4cc9f0;
      --danger: #f72585;
      --warning: #ff9e00;
      --success: #06d6a0;
      --light: #f8f9fc;
      --light-alt: #ffffff;
      --dark: #2b2d42;
      --gray: #8d99ae;
      --border-radius: 16px;
      --shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      --transition: all 0.4s ease;
    }

    body {
      margin: 0;
      font-family: 'Inter', 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #f5f7ff 0%, #f0f4ff 100%);
      color: var(--dark);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .dashboard-header {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      padding: 1.5rem 0;
      border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .header-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .welcome-section h1 {
      font-weight: 800;
      font-size: 2.2rem;
      margin: 0 0 0.5rem 0;
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .welcome-section p {
      color: var(--gray);
      font-size: 1.1rem;
      margin: 0;
    }

    .btn-login {
      background: transparent;
      border: 2px solid var(--primary);
      color: var(--primary);
      border-radius: 50px;
      padding: 0.6rem 1.5rem;
      font-weight: 600;
      text-decoration: none;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-login:hover {
      background: var(--primary);
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 6px 15px rgba(67, 97, 238, 0.3);
    }

    .features-main {
      padding: 4rem 0;
      flex: 1;
    }

    .grid-layout {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 2.5rem;
    }

    .feature-card {
      background: var(--light-alt);
      border-radius: var(--border-radius);
      padding: 2.5rem 2rem;
      box-shadow: var(--shadow);
      transition: var(--transition);
      border-top: 4px solid transparent;
      position: relative;
    }

    .feature-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
      border-top: 4px solid var(--primary);
    }

    .feature-card h2 {
      font-weight: 700;
      margin-top: 0;
      margin-bottom: 1.5rem;
      color: var(--dark);
      font-size: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.8rem;
    }

    .feature-card h2 i {
      color: var(--primary);
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      margin-bottom: 1.5rem;
    }

    .form-group label {
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--dark);
    }

    .input-field {
      background: var(--light);
      border: 1px solid rgba(0, 0, 0, 0.1);
      color: var(--dark);
      padding: 0.8rem 1rem;
      border-radius: 8px;
      font-size: 1rem;
      transition: var(--transition);
      width: 100%;
      box-sizing: border-box;
    }

    .input-field:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.2);
    }

    .btn {
      padding: 0.8rem 1.8rem;
      border-radius: 50px;
      font-weight: 600;
      font-size: 1rem;
      cursor: pointer;
      border: none;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
      color: white;
      box-shadow: 0 6px 20px rgba(67, 97, 238, 0.3);
      width: 100%;
    }

    .btn-primary:hover {
      background: var(--primary-dark);
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(67, 97, 238, 0.4);
    }

    .btn-danger {
      background: transparent;
      color: var(--danger);
      padding: 0.4rem 0.8rem;
      font-size: 0.875rem;
      border-radius: 6px;
      border: 1px solid rgba(247, 37, 133, 0.2);
      transition: var(--transition);
    }

    .btn-danger:hover {
      background: var(--danger);
      color: white;
      border-color: var(--danger);
    }

    .batch-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      max-height: 600px;
      overflow-y: auto;
      padding-right: 10px;
    }

    .batch-item {
      padding: 1.5rem;
      background: var(--light);
      border-radius: 12px;
      border: 1px solid rgba(0,0,0,0.05);
      transition: var(--transition);
    }

    .batch-item:hover {
      border-color: rgba(67, 97, 238, 0.2);
      box-shadow: 0 4px 10px rgba(0,0,0,0.04);
      transform: translateX(5px);
    }

    .batch-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .batch-id {
      font-weight: 700;
      color: var(--dark);
      font-size: 1.1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .batch-status {
      font-size: 0.85rem;
      font-weight: 600;
      padding: 0.3rem 0.8rem;
      border-radius: 20px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .status-running {
      background: rgba(255, 158, 0, 0.1);
      color: var(--warning);
    }
    .status-completed {
      background: rgba(6, 214, 160, 0.1);
      color: var(--success);
    }
    .status-partially_failed {
      background: rgba(247, 37, 133, 0.1);
      color: var(--danger);
    }
    .status-pending {
      background: rgba(141, 153, 174, 0.1);
      color: var(--gray);
    }

    .progress-bar-container {
      width: 100%;
      height: 10px;
      background: #e0e0e0;
      border-radius: 5px;
      overflow: hidden;
      margin-bottom: 0.5rem;
      display: flex;
    }

    .progress-fill-success {
      height: 100%;
      background: var(--success);
      transition: width 0.5s ease;
    }
    .progress-fill-fail {
      height: 100%;
      background: var(--danger);
      transition: width 0.5s ease;
    }

    .progress-stats {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
      color: var(--gray);
      margin-bottom: 1rem;
    }

    .btn-link {
      background: transparent;
      color: var(--primary);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9rem;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
    .btn-link:hover {
      text-decoration: underline;
    }

    .stat-message {
      margin-bottom: 1.5rem;
      padding: 1rem;
      border-radius: 8px;
    }
    .stat-success {
      background: rgba(6, 214, 160, 0.1);
      color: #05b083;
      border: 1px solid rgba(6, 214, 160, 0.2);
    }
    .stat-error {
      background: rgba(247, 37, 133, 0.1);
      color: var(--danger);
      border: 1px solid rgba(247, 37, 133, 0.2);
    }

    .tab-btn {
      padding: 0.5rem 1.5rem;
      font-weight: 700;
      color: var(--gray);
      text-decoration: none;
      border-radius: 8px 8px 0 0;
      transition: var(--transition);
      border-bottom: 3px solid transparent;
    }
    .tab-btn:hover {
      color: var(--primary);
      background: rgba(67, 97, 238, 0.05);
    }
    .tab-btn.active {
      color: var(--primary);
      border-bottom: 3px solid var(--primary);
    }
  </style>
