<body>

  <header class="dashboard-header">
    <div class="container">
      <div class="header-content">
        <div class="welcome-section">
          <h1 class="og-title"><%= @active_portal.capitalize %> Automated Scheduler</h1>
          <span class="og-slash" aria-hidden="true"></span>
          <p>Schedule and Track 100-Combination Batch Validations for <%= @active_portal.capitalize %>.</p>
        </div>
        <div class="user-actions">
          <%= link_to features_path, class: "btn-login" do %>
            <i class="fas fa-arrow-left"></i> Back to Features
          <% end %>
        </div>
      </div>
      
      <div class="tabs-container og-asi1" style="margin-top: 2rem; display: flex; gap: 1rem; border-bottom: 2px solid rgba(0,0,0,0.05); padding-bottom: 0.5rem;">
        <%= link_to "Utilization Portal", automation_schedules_path(type: 'utilization'), class: "tab-btn #{@active_portal == 'utilization' ? 'active' : ''}" %>
        <%= link_to "Ranking Portal", automation_schedules_path(type: 'ranking'), class: "tab-btn #{@active_portal == 'ranking' ? 'active' : ''}" %>
      </div>
    </div>
  </header>

  <main class="features-main">
    <div class="container">
      <% if notice %>
        <div class="stat-message stat-success"><i class="fas fa-check-circle"></i> <%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="stat-message stat-error"><i class="fas fa-exclamation-circle"></i> <%= alert %></div>
      <% end %>

      <div class="grid-layout">
        
        <!-- Left Panel: Schedules -->
        <div style="display:flex; flex-direction: column; gap: 2.5rem;">
          <!-- Create Schedule -->
          <div class="feature-card">
            <h2><i class="fas fa-calendar-plus"></i> Configure Routine</h2>
            <p style="color: var(--gray); margin-bottom: 2rem;">Set the overarching automated validation loops dynamically.</p>
            
            <%= form_with(model: @schedule, local: true) do |form| %>
              <%= form.hidden_field :schedule_type, value: @active_portal %>
              <div class="form-group">
                <%= form.label :frequency, "Execution Frequency" %>
                <%= form.select :frequency, options_for_select(['Daily', 'Weekly', 'Monthly']), {}, { class: "input-field" } %>
              </div>
              <div class="form-group">
                <%= form.label :time_of_day, "Time Of Day" %>
                <%= form.time_field :time_of_day, class: "input-field", required: true %>
              </div>
              <%= button_tag type: 'submit', class: "btn btn-primary" do %>
                <i class="fas fa-satellite-dish"></i> Start Polling Rotation
              <% end %>
            <% end %>
          </div>

          <!-- Active Schedules -->
          <div class="feature-card">
            <h2><i class="fas fa-clock"></i> Active Automated Routines</h2>
            <% if @schedules.any? %>
              <ul class="batch-list" style="max-height: 300px;">
                <% @schedules.each do |schedule| %>
                  <li class="batch-item">
                    <div style="display:flex; justify-content: space-between; align-items: start; margin-bottom: 0.5rem;">
                      <div class="og-asi2" style="font-weight: 700; color: var(--primary);">
                        <i class="fas fa-redo-alt"></i> <%= schedule.frequency.capitalize %> at <%= schedule.time_of_day %>
                      </div>
                      <%= button_to automation_schedule_path(schedule), method: :delete, data: { confirm: 'Remove Routine?' }, class: "btn-danger", form: {style: 'margin:0;'} do %>
                        <i class="fas fa-trash-alt"></i>
                      <% end %>
                    </div>
                    <div style="font-size: 0.9rem; color: var(--gray);">
                      Next Loop: <%= schedule.next_run_at&.strftime("%B %d, %Y - %I:%M %p") %>
                    </div>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <div class="og-asi3" style="text-align: center; padding: 2rem 1rem; color: var(--gray); background: var(--light); border-radius: 12px; border: 2px dashed rgba(0,0,0,0.05);">
                <i class="fas fa-bed" style="font-size: 2rem; margin-bottom: 1rem; opacity: 0.5;"></i>
                <p style="margin: 0;">No active routines scheduled.</p>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Right Panel: Batches Tracker -->
        <div class="feature-card">
          <h2><i class="fas fa-server"></i> Global Batch Tracker</h2>
          <p style="color: var(--gray); margin-bottom: 1.5rem;">Live macroscopic tracking of all running exhaustive combination pipelines.</p>
          
          <meta http-equiv="refresh" content="10"> <!-- Auto refresh every 10 seconds to show live progress -->
          <p style="font-size: 0.8rem; color: var(--gray); text-align: right; margin-top: -3rem; margin-bottom: 2rem;"><i class="fas fa-sync fa-spin"></i> Live Tracking</p>

          <% if @batches.any? %>
            <ul class="batch-list">
              <% @batches.each do |batch| %>
                <li class="batch-item">
                  <div class="batch-header">
                    <div class="batch-id">
                      <i class="fas fa-layer-group" style="color: var(--gray);"></i> Batch #<%= batch.id %>
                    </div>
                    <div class="batch-status status-<%= batch.status %>">
                      <%= batch.status.tr('_', ' ') %>
                    </div>
                  </div>

                  <% success_pct = (batch.completed_jobs.to_f / batch.total_jobs.to_f * 100) rescue 0 %>
                  <% fail_pct = (batch.failed_jobs.to_f / batch.total_jobs.to_f * 100) rescue 0 %>
                  
                  <div class="progress-bar-container">
                    <div class="progress-fill-success" style="width: <%= success_pct %>%;"></div>
                    <div class="progress-fill-fail" style="width: <%= fail_pct %>%;"></div>
                  </div>
                  
                  <div class="progress-stats">
                    <span style="color: var(--success); font-weight: 600;"><%= batch.completed_jobs %> Successful</span>
                    <span style="color: var(--danger); font-weight: 600;"><%= batch.failed_jobs %> Failed</span>
                    <span>Total: <%= batch.total_jobs %> Combinations</span>
                  </div>

                  <div class="og-asi4" style="border-top: 1px solid rgba(0,0,0,0.05); padding-top: 1rem; text-align: right;">
                    <%= link_to automation_schedule_path(batch), class: "btn-link" do %>
                      View Granular Metrics <i class="fas fa-chevron-right"></i>
                    <% end %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <div class="og-asi5" style="text-align: center; padding: 4rem 1rem; color: var(--gray); background: var(--light); border-radius: 12px; border: 2px dashed rgba(0,0,0,0.05);">
              <i class="fas fa-box-open" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5;"></i>
              <p style="margin: 0;">No batches have been dispatched yet.</p>
            </div>
          <% end %>
        </div>

      </div>
    </div>
  </main>
</body>
</html>
