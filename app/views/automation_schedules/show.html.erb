<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Batch Metrics Drilldown</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style data-theme-style="classic" media="<%= theme_media(:classic) %>">
    /* Add previously established glassmorphism token styles */
    :root {
      --primary: #4361ee;
      --primary-light: #6c8aff;
      --secondary: #7209b7;
      --danger: #f72585;
      --warning: #ff9e00;
      --success: #06d6a0;
      --light: #f8f9fc;
      --light-alt: #ffffff;
      --dark: #2b2d42;
      --gray: #8d99ae;
      --border-radius: 16px;
      --shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      --transition: all 0.4s ease;
    }

    body {
      margin: 0;
      font-family: 'Inter', 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #f5f7ff 0%, #f0f4ff 100%);
      color: var(--dark);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .dashboard-header {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      padding: 1.5rem 0;
      border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .header-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .welcome-section h1 {
      font-weight: 800;
      font-size: 2rem;
      margin: 0 0 0.5rem 0;
      color: var(--dark);
    }

    .btn-login {
      background: transparent;
      border: 2px solid var(--primary);
      color: var(--primary);
      border-radius: 50px;
      padding: 0.6rem 1.5rem;
      font-weight: 600;
      text-decoration: none;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-login:hover {
      background: var(--primary);
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 6px 15px rgba(67, 97, 238, 0.3);
    }

    .features-main {
      padding: 4rem 0;
      flex: 1;
    }

    .feature-card {
      background: var(--light-alt);
      border-radius: var(--border-radius);
      padding: 2.5rem 2rem;
      box-shadow: var(--shadow);
      margin-bottom: 2.5rem;
      border-top: 4px solid var(--primary);
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .stat-box {
      background: var(--light);
      padding: 1.5rem;
      border-radius: 12px;
      text-align: center;
    }

    .stat-number {
      font-size: 2.5rem;
      font-weight: 800;
      margin-bottom: 0.5rem;
    }

    .stat-label {
      color: var(--gray);
      font-weight: 600;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .table-container {
      overflow-x: auto;
    }

    .metrics-table {
      width: 100%;
      border-collapse: collapse;
      background: white;
    }

    .metrics-table th, .metrics-table td {
      padding: 1rem;
      text-align: left;
      border-bottom: 1px solid rgba(0,0,0,0.05);
    }

    .metrics-table th {
      color: var(--gray);
      font-weight: 600;
      font-size: 0.9rem;
      text-transform: uppercase;
      background: var(--light);
    }

    .metrics-table tr:hover td {
      background: #f8f9fa;
    }

    .status-badge {
      display: inline-block;
      padding: 0.3rem 0.8rem;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 600;
      text-transform: capitalize;
    }

    .st-pending { background: rgba(141, 153, 174, 0.1); color: var(--gray); }
    .st-running { background: rgba(255, 158, 0, 0.1); color: var(--warning); }
    .st-completed { background: rgba(6, 214, 160, 0.1); color: var(--success); }
    .st-failed { background: rgba(247, 37, 133, 0.1); color: var(--danger); }
  </style>
<style data-theme-style="og" media="<%= theme_media(:og) %>">
    /* Add previously established glassmorphism token styles */
    :root {
      --primary: var(--og-red);
      --primary-light: var(--og-red-bright);
      --secondary: var(--og-ember);
      --danger: var(--og-danger);
      --warning: var(--og-warning);
      --success: var(--og-success);
      --light: var(--og-surface-2);
      --light-alt: var(--og-surface);
      --dark: var(--og-text);
      --gray: var(--og-muted);
      --border-radius: var(--og-radius);
      --shadow: var(--og-shadow);
      --transition: all 0.4s ease;
    }

    body {
      margin: 0;
      font-family: var(--og-font-body);
      background: transparent;
      color: var(--og-text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .dashboard-header {
      background: var(--og-glass);
      backdrop-filter: blur(10px);
      box-shadow: var(--og-shadow-sm);
      padding: 1.5rem 0;
      border-bottom: 1px solid var(--og-line);
      border-top: 3px solid var(--og-red);
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .header-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .welcome-section h1 {
      font-family: var(--og-font-display);
      font-weight: 400;
      letter-spacing: 0.05em;
      font-size: 2.6rem;
      line-height: 1.05;
      margin: 0 0 0.25rem 0;
      color: var(--og-text);
    }

    .welcome-section p {
      color: var(--og-text-soft);
    }

    .btn-login {
      background: transparent;
      border: 1px solid var(--og-line-strong);
      color: var(--og-text);
      border-radius: 50px;
      padding: 0.6rem 1.5rem;
      font-weight: 600;
      text-decoration: none;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-login:hover {
      border-color: var(--og-amber);
      color: var(--og-amber);
      transform: translateY(-2px);
    }

    .features-main {
      padding: 4rem 0;
      flex: 1;
    }

    .feature-card {
      background: var(--og-surface);
      border: 1px solid var(--og-line);
      border-radius: var(--border-radius);
      padding: 2.5rem 2rem;
      box-shadow: var(--shadow);
      margin-bottom: 2.5rem;
      border-top: 4px solid var(--og-red);
    }

    .feature-card h2 {
      color: var(--og-text);
      margin-top: 0;
    }

    .feature-card h2 i {
      color: var(--og-amber);
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .stat-box {
      background: var(--og-surface-2);
      border: 1px solid var(--og-line);
      padding: 1.5rem;
      border-radius: 12px;
      text-align: center;
      transition: var(--transition);
    }

    .stat-box:hover {
      box-shadow: var(--og-glow-red);
    }

    .stat-number {
      font-family: var(--og-font-display);
      font-size: 3rem;
      font-weight: 400;
      letter-spacing: 0.04em;
      line-height: 1.1;
      margin-bottom: 0.5rem;
    }

    .stat-label {
      color: var(--og-muted);
      font-weight: 600;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .table-container {
      overflow-x: auto;
      border: 1px solid var(--og-line);
      border-radius: 12px;
    }

    .metrics-table {
      width: 100%;
      border-collapse: collapse;
      background: var(--og-surface);
      color: var(--og-text-soft);
    }

    .metrics-table th, .metrics-table td {
      padding: 1rem;
      text-align: left;
      border-bottom: 1px solid var(--og-line);
    }

    .metrics-table th {
      color: var(--og-amber);
      font-weight: 600;
      font-size: 0.8rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      background: linear-gradient(180deg, #221a1a, #170f10);
      border-bottom: 1px solid rgba(224, 20, 30, 0.45);
    }

    .metrics-table tbody tr:nth-child(even) td {
      background: rgba(255, 255, 255, 0.02);
    }

    .metrics-table tr:hover td {
      background: rgba(224, 20, 30, 0.07);
    }

    .status-badge {
      display: inline-block;
      padding: 0.3rem 0.8rem;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 600;
      text-transform: capitalize;
      border: 1px solid transparent;
    }

    .st-pending { background: rgba(255, 255, 255, 0.05); color: var(--og-muted); border-color: var(--og-line-strong); }
    .st-running { background: rgba(255, 176, 32, 0.14); color: var(--og-warning); border-color: rgba(255, 176, 32, 0.35); }
    .st-completed { background: rgba(61, 220, 132, 0.14); color: var(--og-success); border-color: rgba(61, 220, 132, 0.35); }
    .st-failed { background: rgba(255, 59, 71, 0.14); color: var(--og-danger); border-color: rgba(255, 59, 71, 0.35); }
  </style>
</head>
<body>

  <header class="dashboard-header">
    <div class="container">
      <div class="header-content">
        <div class="welcome-section">
          <h1 class="og-title">Granular Run Metrics: Batch #<%= @batch.id %></h1>
          <span class="og-slash" aria-hidden="true"></span>
          <p style="color: var(--gray);">Triggered by routine scheduler initially at <%= @batch.created_at.strftime("%I:%M %p") %>.</p>
        </div>
        <div class="user-actions">
          <%= link_to automation_schedules_path, class: "btn-login" do %>
            <i class="fas fa-arrow-left"></i> Back to Dashboard
          <% end %>
        </div>
      </div>
    </div>
  </header>

  <main class="features-main">
    <div class="container">
      
      <!-- Global Stats -->
      <div class="feature-card">
        <h2>Global Snapshot</h2>
        <div class="stats-grid">
          <div class="stat-box" style="border-bottom: 4px solid var(--primary);">
            <div class="stat-number" style="color: var(--primary);"><%= @batch.total_jobs %></div>
            <div class="stat-label">Total Combinations</div>
          </div>
          <div class="stat-box" style="border-bottom: 4px solid var(--success);">
            <div class="stat-number" style="color: var(--success);"><%= @batch.completed_jobs %></div>
            <div class="stat-label">Successful Checks</div>
          </div>
          <div class="stat-box" style="border-bottom: 4px solid var(--danger);">
            <div class="stat-number" style="color: var(--danger);"><%= @batch.failed_jobs %></div>
            <div class="stat-label">Mismatched / Failed</div>
          </div>
        </div>
      </div>

      <!-- Specific Generic Names Tracker -->
      <div class="feature-card">
        <h2><i class="fas fa-tags"></i> Metrics by Generic Network</h2>
        <div class="table-container">
          <table class="metrics-table">
            <thead>
              <tr>
                <th>Generic Name Group</th>
                <th>Combinations</th>
                <th>Successful</th>
                <th>Failed</th>
                <th>Pending</th>
                <th>Network Status</th>
              </tr>
            </thead>
            <tbody>
              <% @metrics_by_group.each do |metric| %>
                <tr>
                  <td style="font-weight: 700; color: var(--dark);"><%= metric[:group] %></td>
                  <td><%= metric[:total] %> permutations</td>
                  <td style="color: var(--success); font-weight: 600;"><%= metric[:completed] %></td>
                  <td style="color: var(--danger); font-weight: 600;"><%= metric[:failed] %></td>
                  <td style="color: var(--warning); font-weight: 600;"><%= metric[:pending] %></td>
                  <td>
                    <% if metric[:pending] > 0 %>
                      <span class="status-badge st-running">Processing Array</span>
                    <% elsif metric[:failed] > 0 %>
                      <span class="status-badge st-failed">Exceptions Found</span>
                    <% else %>
                      <span class="status-badge st-completed">Fully Validated</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Live Errors Table (Optional) -->
      <% failed_items = @items.select { |i| i.status == 'failed' } %>
      <% if failed_items.any? %>
        <div class="feature-card" style="border-top-color: var(--danger);">
          <h2 style="color: var(--danger);"><i class="fas fa-exclamation-circle"></i> Granular Error Logs</h2>
          <div class="table-container" style="max-height: 400px; overflow-y: auto;">
            <table class="metrics-table">
              <thead>
                <tr>
                  <th>Target Configuration</th>
                  <th>Failed Message Constraint</th>
                </tr>
              </thead>
              <tbody>
                <% failed_items.each do |fi| %>
                  <tr>
                    <td style="white-space: nowrap;">
                      <span style="font-weight:600;"><%= fi.generic_name_group %></span><br>
                      <span style="font-size:0.8rem; color:var(--gray);">Team: <%= fi.team_id %> | Quarter <%= fi.quarter %></span>
                    </td>
                    <td style="color: var(--danger); font-family: monospace; font-size: 0.9rem;">
                      <%= fi.error_message || "Exception execution caught" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>

    </div>
  </main>
</body>
</html>
