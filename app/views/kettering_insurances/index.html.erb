<div class="kettering-page">
  <header class="kettering-header">
    <div>
      <p class="kettering-eyebrow">Kettering</p>
      <h1>Insurance rates</h1>
      <p>Manage payor plans, reimbursement rates, and prices.</p>
    </div>
    <div class="kettering-actions">
      <%= link_to "Add row / upload", new_kettering_insurance_path, class: "kettering-button kettering-button--primary" %>
    </div>
  </header>

  <% if flash[:notice] || flash[:alert] %>
    <div class="kettering-flash <%= flash[:alert] ? "kettering-flash--alert" : "" %>">
      <%= flash[:alert] || flash[:notice] %>
    </div>
  <% end %>

  <section class="kettering-table-card">
    <% if @kettering_insurances.any? %>
      <div class="kettering-table-wrap">
        <table>
          <thead>
            <tr>
              <th>Generic name group</th>
              <th>Brand name</th>
              <th>Primary payor</th>
              <th>Benefit plan</th>
              <th>HCPCS code</th>
              <th>Pay rate</th>
              <th>Price</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @kettering_insurances.each do |insurance| %>
              <tr>
                <td><%= insurance.generic_name_group %></td>
                <td><%= insurance.brand_name %></td>
                <td><%= insurance.primary_payor_name %></td>
                <td><%= insurance.benefit_plan_name %></td>
                <td><%= insurance.hcpcs_code %></td>
                <td><%= insurance.pay_rate %></td>
                <td><%= insurance.price %></td>
                <td class="kettering-row-actions">
                  <%= link_to "Show", insurance %>
                  <%= link_to "Edit", edit_kettering_insurance_path(insurance) %>
                  <%= link_to "Delete", insurance, data: { turbo_method: :delete, turbo_confirm: "Delete this record?" } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="kettering-empty">
        <h2>No Kettering insurance records yet</h2>
        <p>Upload an Excel sheet or add the first row manually.</p>
        <%= link_to "Add row / upload", new_kettering_insurance_path, class: "kettering-button kettering-button--primary" %>
      </div>
    <% end %>
  </section>
</div>

<style>
  .kettering-page { max-width: 1500px; margin: 0 auto; padding: 2rem; color: #243447; }
  .kettering-header { display: flex; justify-content: space-between; gap: 1.5rem; align-items: flex-start; margin-bottom: 1.5rem; }
  .kettering-eyebrow { color: #168aad; font-size: .75rem; font-weight: 800; letter-spacing: .12em; margin: 0 0 .35rem; text-transform: uppercase; }
  .kettering-header h1 { font-size: 2rem; margin: 0 0 .35rem; }
  .kettering-header p:last-child { color: #607080; margin: 0; }
  .kettering-actions { display: flex; gap: .75rem; }
  .kettering-button { border: 0; border-radius: 6px; display: inline-block; font-weight: 700; padding: .7rem 1rem; text-decoration: none; }
  .kettering-button--primary { background: #168aad; color: #fff; }
  .kettering-button--muted { background: #e9eef2; color: #243447; }
  .kettering-flash { background: #d8f3dc; border-left: 4px solid #2d6a4f; margin-bottom: 1rem; padding: .85rem 1rem; }
  .kettering-flash--alert { background: #fff1e6; border-left-color: #d1495b; }
  .kettering-table-card { background: #fff; border: 1px solid #dbe4ea; border-radius: 8px; overflow: hidden; }
  .kettering-table-wrap { overflow-x: auto; }
  .kettering-table-card table { border-collapse: collapse; min-width: 1050px; width: 100%; }
  .kettering-table-card th, .kettering-table-card td { border-bottom: 1px solid #e7edf1; padding: .85rem 1rem; text-align: left; white-space: nowrap; }
  .kettering-table-card th { background: #f4f8fa; color: #526575; font-size: .78rem; text-transform: uppercase; }
  .kettering-row-actions { display: flex; gap: .65rem; }
  .kettering-row-actions a { color: #168aad; font-weight: 700; }
  .kettering-empty { padding: 4rem 1rem; text-align: center; }
  .kettering-empty p { color: #607080; margin-bottom: 1.5rem; }
  @media (max-width: 700px) { .kettering-page { padding: 1rem; } .kettering-header { flex-direction: column; } }
</style>