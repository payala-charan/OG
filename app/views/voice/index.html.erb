<body>
  <div class="voice-recorder-container">
    <!-- Header -->
    <header class="header-card">
      <div class="header-content">
        <h1>Voice to Text Recorder</h1>
        <span class="og-slash" aria-hidden="true"></span>
        <p>Convert your speech to text using advanced Web Speech API</p>
      </div>
    </header>

    <!-- Main Recorder -->
    <main class="recorder-card">
      <!-- Status Indicator -->
      <div class="status-indicator">
        <div class="status-dot" id="statusDot"></div>
        <div class="status-text" id="statusText">Ready to record</div>
      </div>

      <!-- Controls -->
      <div class="controls-section">
        <button id="startBtn" class="control-btn start-btn">
          <i class="fas fa-microphone"></i>
          Start Recording
        </button>

        <button id="stopBtn" class="control-btn stop-btn" disabled>
          <i class="fas fa-stop"></i>
          Stop Recording
        </button>
      </div>

      <!-- Output Section -->
      <section class="output-section">
        <div class="output-header">
          <h2>Converted Text</h2>
          <div class="word-count" id="wordCount">0 words</div>
        </div>
        
        <textarea id="outputText"
                  class="output-textarea"
                  placeholder="Your speech will appear here... Speak clearly and naturally."></textarea>
      </section>

      <!-- Action Buttons -->
      <div class="action-buttons">
        <button id="copyBtn" class="action-btn copy-btn">
          <i class="fas fa-copy"></i>
          Copy Text
        </button>

        <button id="clearBtn" class="action-btn clear-btn">
          <i class="fas fa-broom"></i>
          Clear Text
        </button>
      </div>
    </main>

    <!-- Browser Support Alert -->
    <div id="browserAlert" class="browser-alert hidden">
      <div class="alert-header">
        <i class="fas fa-info-circle"></i>
        Browser Compatibility
      </div>
      <p>For best results, use Chrome, Edge, or Safari. Make sure your microphone is enabled and you're in a quiet environment.</p>
    </div>
  </div>

  <!-- Success Message -->
  <div id="successMessage" class="success-message">
    <i class="fas fa-check-circle"></i>
    <span id="successText">Text copied to clipboard!</span>
  </div>

  <script>
    let recognition;
    let isRecording = false;

    // DOM Elements
    const startBtn = document.getElementById('startBtn');
    const stopBtn = document.getElementById('stopBtn');
    const copyBtn = document.getElementById('copyBtn');
    const clearBtn = document.getElementById('clearBtn');
    const outputText = document.getElementById('outputText');
    const statusDot = document.getElementById('statusDot');
    const statusText = document.getElementById('statusText');
    const wordCount = document.getElementById('wordCount');
    const browserAlert = document.getElementById('browserAlert');
    const successMessage = document.getElementById('successMessage');
    const successText = document.getElementById('successText');

    // Initialize the app
    function initApp() {
      // Check browser support
      if (!("webkitSpeechRecognition" in window) && !("SpeechRecognition" in window)) {
        showBrowserAlert("Your browser does not support Speech Recognition. Please use Chrome, Edge, or Safari for the best experience.");
        disableControls();
        return;
      }

      // Show browser tips for supported browsers
      showBrowserAlert("For best results, use Chrome, Edge, or Safari. Make sure your microphone is enabled and you're in a quiet environment.");

      // Initialize speech recognition
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      recognition = new SpeechRecognition();

      recognition.continuous = true;
      recognition.interimResults = true;
      recognition.lang = "en-US";

      recognition.onresult = function(event) {
        let transcript = "";
        for (let i = event.resultIndex; i < event.results.length; i++) {
          if (event.results[i].isFinal) {
            transcript += event.results[i][0].transcript;
          } else {
            transcript += event.results[i][0].transcript;
          }
        }
        outputText.value = transcript;
        updateWordCount();
      };

      recognition.onstart = function() {
        updateStatus('recording', 'Recording in progress...');
      };

      recognition.onend = function() {
        if (isRecording) {
          // If recording was stopped unexpectedly, try to restart
          try {
            recognition.start();
          } catch (e) {
            stopRecording();
          }
        } else {
          updateStatus('ready', 'Recording stopped');
        }
      };

      recognition.onerror = function(event) {
        console.error("Speech recognition error:", event.error);
        if (event.error === 'not-allowed') {
          showError('Microphone access denied. Please allow microphone permissions.');
        } else if (event.error === 'audio-capture') {
          showError('No microphone found. Please check your audio device.');
        } else {
          showError('Speech recognition error: ' + event.error);
        }
        stopRecording();
      };
    }

    // Control functions
    function startRecording() {
      if (recognition && !isRecording) {
        try {
          recognition.start();
          isRecording = true;
          startBtn.disabled = true;
          stopBtn.disabled = false;
          updateStatus('recording', 'Recording in progress...');
        } catch (e) {
          showError('Failed to start recording: ' + e.message);
        }
      }
    }

    function stopRecording() {
      if (recognition && isRecording) {
        recognition.stop();
        isRecording = false;
        startBtn.disabled = false;
        stopBtn.disabled = true;
        updateStatus('ready', 'Recording completed');
      }
    }

    function copyToClipboard() {
      if (outputText.value.trim() === '') {
        showSuccess('No text to copy');
        return;
      }

      outputText.select();
      outputText.setSelectionRange(0, 99999); // For mobile devices

      try {
        navigator.clipboard.writeText(outputText.value).then(() => {
          showSuccess('Text copied to clipboard!');
        }).catch(() => {
          // Fallback for older browsers
          document.execCommand('copy');
          showSuccess('Text copied to clipboard!');
        });
      } catch (e) {
        showSuccess('Text copied to clipboard!');
      }
    }

    function clearText() {
      if (outputText.value.trim() === '') {
        showSuccess('Text area is already empty');
        return;
      }

      if (confirm('Are you sure you want to clear all text?')) {
        outputText.value = '';
        updateWordCount();
        showSuccess('Text cleared successfully');
      }
    }

    // UI Helper functions
    function updateStatus(status, message) {
      statusDot.className = 'status-dot';
      if (status === 'recording') {
        statusDot.classList.add('recording');
      }
      statusText.textContent = message;
    }

    function updateWordCount() {
      const text = outputText.value.trim();
      const words = text === '' ? 0 : text.split(/\s+/).length;
      wordCount.textContent = `${words} word${words !== 1 ? 's' : ''}`;
    }

    function showBrowserAlert(message) {
      browserAlert.querySelector('p').textContent = message;
      browserAlert.classList.remove('hidden');
    }

    function showError(message) {
      successText.textContent = message;
      successMessage.style.background = 'var(--danger)';
      successMessage.classList.add('show');
      setTimeout(() => {
        successMessage.classList.remove('show');
      }, 4000);
    }

    function showSuccess(message) {
      successText.textContent = message;
      successMessage.style.background = 'var(--success)';
      successMessage.classList.add('show');
      setTimeout(() => {
        successMessage.classList.remove('show');
      }, 3000);
    }

    function disableControls() {
      startBtn.disabled = true;
      stopBtn.disabled = true;
      copyBtn.disabled = true;
      clearBtn.disabled = true;
    }

    // Event Listeners
    startBtn.addEventListener('click', startRecording);
    stopBtn.addEventListener('click', stopRecording);
    copyBtn.addEventListener('click', copyToClipboard);
    clearBtn.addEventListener('click', clearText);

    // Update word count when typing manually
    outputText.addEventListener('input', updateWordCount);

    // Initialize the application
    document.addEventListener('DOMContentLoaded', initApp);
  </script>
</body>
</html>