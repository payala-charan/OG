<!DOCTYPE html>
<html>
<head>
  <title>Voice Recorder</title>
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <style data-theme-style="classic" media="<%= theme_media(:classic) %>">
    :root {
      --primary: #4361ee;
      --primary-light: #6c8aff;
      --primary-dark: #3a56d4;
      --secondary: #7209b7;
      --accent: #4cc9f0;
      --danger: #f72585;
      --warning: #ff9e00;
      --success: #06d6a0;
      --light: #f8f9fc;
      --dark: #2b2d42;
      --gray: #8d99ae;
      --border-radius: 16px;
      --shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      --transition: all 0.4s ease;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', 'Segoe UI', sans-serif;
      color: var(--dark);
      background: linear-gradient(135deg, #f5f7ff 0%, #f0f4ff 100%);
      min-height: 100vh;
      line-height: 1.6;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    .voice-recorder-container {
      max-width: 600px;
      width: 100%;
    }

    /* Header Card */
    .header-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border-radius: var(--border-radius);
      padding: 2rem;
      margin-bottom: 2rem;
      box-shadow: var(--shadow);
      border: 1px solid rgba(255, 255, 255, 0.8);
      text-align: center;
    }

    .header-content h1 {
      font-weight: 800;
      font-size: 2.2rem;
      margin-bottom: 0.5rem;
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .header-content p {
      color: var(--gray);
      font-size: 1.1rem;
    }

    /* Main Recorder Card */
    .recorder-card {
      background: white;
      border-radius: var(--border-radius);
      padding: 2.5rem;
      box-shadow: var(--shadow);
      transition: var(--transition);
      border-top: 4px solid var(--primary);
    }

    .recorder-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
    }

    /* Status Indicator */
    .status-indicator {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      margin-bottom: 2rem;
      padding: 1rem;
      background: var(--light);
      border-radius: var(--border-radius);
      border-left: 4px solid var(--primary-light);
    }

    .status-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--gray);
      transition: var(--transition);
    }

    .status-dot.recording {
      background: var(--danger);
      animation: pulse 2s infinite;
    }

    .status-text {
      font-weight: 600;
      color: var(--dark);
    }

    @keyframes pulse {
      0% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.2); opacity: 0.7; }
      100% { transform: scale(1); opacity: 1; }
    }

    /* Controls Section */
    .controls-section {
      display: flex;
      justify-content: center;
      gap: 1.5rem;
      margin-bottom: 2rem;
      flex-wrap: wrap;
    }

    .control-btn {
      padding: 1rem 2rem;
      border: none;
      border-radius: 50px;
      font-weight: 600;
      cursor: pointer;
      transition: var(--transition);
      display: flex;
      align-items: center;
      gap: 0.8rem;
      font-size: 1rem;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
      position: relative;
      overflow: hidden;
    }

    .control-btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
      transition: var(--transition);
    }

    .control-btn:hover::before {
      left: 100%;
    }

    .control-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none !important;
      box-shadow: none !important;
    }

    .control-btn:disabled:hover::before {
      left: -100%;
    }

    .start-btn {
      background: linear-gradient(135deg, var(--success) 0%, #05c291 100%);
      color: white;
    }

    .start-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(6, 214, 160, 0.4);
    }

    .stop-btn {
      background: linear-gradient(135deg, var(--danger) 0%, #f55f7c 100%);
      color: white;
    }

    .stop-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(247, 37, 133, 0.4);
    }

    /* Output Section */
    .output-section {
      margin-bottom: 2rem;
    }

    .output-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .output-header h2 {
      font-weight: 700;
      font-size: 1.2rem;
      color: var(--dark);
    }

    .word-count {
      background: var(--primary-light);
      color: white;
      padding: 0.3rem 0.8rem;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
    }

    .output-textarea {
      width: 100%;
      min-height: 200px;
      padding: 1.5rem;
      border: 2px solid var(--primary-light);
      border-radius: var(--border-radius);
      background: white;
      color: var(--dark);
      font-size: 1rem;
      line-height: 1.6;
      resize: vertical;
      transition: var(--transition);
      font-family: 'Inter', sans-serif;
    }

    .output-textarea:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
    }

    .output-textarea::placeholder {
      color: var(--gray);
    }

    /* Action Buttons */
    .action-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    .action-btn {
      padding: 0.8rem 1.5rem;
      border: 2px solid;
      border-radius: 50px;
      font-weight: 600;
      cursor: pointer;
      transition: var(--transition);
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.9rem;
    }

    .copy-btn {
      background: rgba(67, 97, 238, 0.1);
      border-color: var(--primary);
      color: var(--primary);
    }

    .copy-btn:hover {
      background: var(--primary);
      color: white;
    }

    .clear-btn {
      background: rgba(247, 37, 133, 0.1);
      border-color: var(--danger);
      color: var(--danger);
    }

    .clear-btn:hover {
      background: var(--danger);
      color: white;
    }

    /* Browser Support Alert */
    .browser-alert {
      background: rgba(255, 158, 0, 0.1);
      border: 1px solid rgba(255, 158, 0, 0.3);
      border-left: 4px solid var(--warning);
      color: var(--dark);
      padding: 1rem 1.5rem;
      border-radius: var(--border-radius);
      margin-top: 2rem;
      font-size: 0.9rem;
    }

    .browser-alert.hidden {
      display: none;
    }

    .alert-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
      font-weight: 600;
      color: var(--warning);
    }

    /* Success Message */
    .success-message {
      position: fixed;
      top: 2rem;
      right: 2rem;
      background: var(--success);
      color: white;
      padding: 1rem 1.5rem;
      border-radius: var(--border-radius);
      box-shadow: var(--shadow);
      display: flex;
      align-items: center;
      gap: 0.5rem;
      transform: translateX(400px);
      transition: transform 0.4s ease;
      z-index: 1000;
    }

    .success-message.show {
      transform: translateX(0);
    }

    /* Responsive Design */
    @media (max-width: 768px) {
      body {
        padding: 1rem;
      }

      .header-card {
        padding: 1.5rem;
      }

      .header-content h1 {
        font-size: 1.8rem;
      }

      .recorder-card {
        padding: 2rem;
      }

      .controls-section {
        flex-direction: column;
        align-items: center;
      }

      .control-btn {
        width: 100%;
        justify-content: center;
      }

      .action-buttons {
        flex-direction: column;
      }

      .action-btn {
        width: 100%;
        justify-content: center;
      }

      .success-message {
        top: 1rem;
        right: 1rem;
        left: 1rem;
        transform: translateY(-100px);
      }

      .success-message.show {
        transform: translateY(0);
      }
    }

    @media (max-width: 480px) {
      .header-content h1 {
        font-size: 1.5rem;
      }

      .recorder-card {
        padding: 1.5rem;
      }

      .output-textarea {
        min-height: 150px;
        padding: 1rem;
      }
    }
  </style>
