<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Rails Console - Execute Queries</title>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --primary: #4361ee;
      --primary-light: #6c8aff;
      --primary-dark: #3a56d4;
      --secondary: #7209b7;
      --accent: #4cc9f0;
      --danger: #f72585;
      --success: #06d6a0;
      --warning: #ffb703;
      --dark: #0f172a;
      --gray: #64748b;
      --light: #f8fafc;
      --transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', sans-serif;
      color: var(--dark);
      background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
      min-height: 100vh;
      line-height: 1.6;
    }

    .navbar {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(12px);
      box-shadow: 0 4px 30px rgba(0, 0, 0, 0.03);
      padding: 1rem 0;
      border-bottom: 1px solid rgba(0,0,0,0.05);
    }

    .navbar-brand {
      font-weight: 800;
      font-size: 1.8rem;
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: flex;
      align-items: center;
    }

    .navbar-brand i { margin-right: 0.5rem; font-size: 2rem; }

    .nav-link {
      font-weight: 600;
      color: #475569;
      margin: 0 0.8rem;
      position: relative;
      transition: var(--transition);
    }

    .nav-link:hover { color: var(--primary); }

    .btn-rounded {
      border-radius: 50px;
      font-weight: 600;
      padding: 0.6rem 1.8rem;
      transition: var(--transition);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-login {
      background: transparent;
      border: 2px solid #e2e8f0;
      color: #475569;
    }

    .btn-login:hover {
      border-color: var(--primary);
      color: var(--primary);
    }

    .console-container {
      max-width: 1200px;
      margin: 2rem auto;
      padding: 0 1rem;
    }

    .console-header {
      text-align: center;
      margin-bottom: 2rem;
    }

    .console-header h1 {
      font-weight: 800;
      font-size: 2.5rem;
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 0.5rem;
    }

    .console-header p {
      color: #64748b;
      font-size: 1.1rem;
      max-width: 600px;
      margin: 0 auto;
    }

    .console-form {
      background: white;
      border-radius: 16px;
      padding: 2rem;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
      margin-bottom: 2rem;
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-label {
      font-weight: 600;
      color: var(--dark);
      margin-bottom: 0.5rem;
      display: block;
    }

    .form-control {
      border: 2px solid #e2e8f0;
      border-radius: 12px;
      padding: 1rem;
      font-size: 1rem;
      transition: var(--transition);
      width: 100%;
    }

    .form-control:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
      outline: none;
    }

    .form-textarea {
      min-height: 200px;
      resize: vertical;
      font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
      font-size: 0.9rem;
    }

    .btn-primary-custom {
      background: linear-gradient(135deg, var(--primary), var(--primary-light));
      border: none;
      color: white;
      padding: 1rem 2rem;
      border-radius: 50px;
      font-weight: 600;
      font-size: 1.1rem;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      box-shadow: 0 6px 15px rgba(67, 97, 238, 0.25);
    }

    .btn-primary-custom:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(67, 97, 238, 0.35);
      color: white;
    }

    .result-container {
      background: white;
      border-radius: 16px;
      padding: 2rem;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
      margin-top: 2rem;
    }

    .result-warning {
      background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
      border: 1px solid #fecaca;
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 1rem;
      display: flex;
      align-items: flex-start;
      gap: 1rem;
    }

    .result-warning i {
      color: var(--danger);
      font-size: 1.5rem;
      margin-top: 0.2rem;
    }

    .result-warning h3 {
      color: var(--danger);
      margin-bottom: 0.5rem;
      font-weight: 600;
    }

    .result-warning p {
      color: #dc2626;
      margin: 0;
    }

    .result-success {
      background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
      border: 1px solid #bbf7d0;
      border-radius: 12px;
      padding: 1.5rem;
    }

    .result-success h3 {
      color: var(--success);
      margin-bottom: 1rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .result-success pre {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 1rem;
      overflow-x: auto;
      font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
      font-size: 0.9rem;
      line-height: 1.5;
      color: var(--dark);
      margin: 0;
      white-space: pre-wrap;
      word-wrap: break-word;
    }

    .loading {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--primary);
      font-weight: 500;
    }

    .loading i {
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    /* Mobile Responsiveness */
    @media (max-width: 768px) {
      .console-header h1 {
        font-size: 2rem;
      }

      .console-form {
        padding: 1.5rem;
      }

      .form-control {
        padding: 0.8rem;
      }

      .btn-primary-custom {
        width: 100%;
        justify-content: center;
      }

      .result-container {
        padding: 1.5rem;
      }

      .result-warning,
      .result-success {
        padding: 1rem;
      }
    }

    @media (max-width: 480px) {
      .console-container {
        padding: 0 0.5rem;
      }

      .console-header h1 {
        font-size: 1.8rem;
      }

      .console-form {
        padding: 1rem;
      }
    }
  </style>
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar">
    <div class="container">
      <a class="navbar-brand" href="/features">
        <i class="fas fa-terminal"></i>
        OG Platform
      </a>
      <a class="nav-link" href="/features">
        <i class="fas fa-th-large"></i> Dashboard
      </a>
    </div>
  </nav>

  <div class="container">
    <div class="header">
      <h1><i class="fas fa-terminal"></i> Rails Console</h1>
      <p>Execute Ruby/Rails queries safely across different projects. Destructive operations are blocked for data protection.</p>
    </div>

    <div class="console-card">
      <%= form_with url: console_execute_path, method: :post, local: true do |f| %>
        <div class="form-group">
          <%= f.label :project_path, "Rails Project Path (optional)", class: "form-label" %>
          <%= f.text_field :project_path, class: "form-control", placeholder: "/path/to/your/rails/project (leave blank for current app)" %>
          <div class="form-text">Enter the full path to any Rails project to execute queries in that environment</div>
        </div>

        <div class="form-group">
          <%= f.label :query, "Query", class: "form-label" %>
          <%= f.text_area :query, class: "form-control form-textarea", placeholder: "e.g., User.all.limit(5)\nBiosimilarPrice.where(accounting_period_id: 6).pluck(:cost_three_forty_b)" %>
          <div class="form-text">Enter Ruby/Rails code to execute. Results will be displayed below.</div>
        </div>

        <div style="text-align: center;">
          <%= f.submit 'Execute Query', class: "btn-primary-custom", disabled: false %>
        </div>
      <% end %>
    </div>

    <% if @warning %>
      <div class="result-container">
        <div class="result-warning">
          <i class="fas fa-exclamation-triangle"></i>
          <div>
            <h3>Query Blocked</h3>
            <p><%= @result %></p>
          </div>
        </div>
      </div>
    <% elsif @result %>
      <div class="result-container">
        <div class="result-success">
          <h3><i class="fas fa-check-circle"></i> Execution Result</h3>
          <pre><%= @result %></pre>
        </div>
      </div>
    <% end %>
  </div>
</body>
</html>