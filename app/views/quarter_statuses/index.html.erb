<div class="upload-container nbp-index">
  <header class="header">
    <div class="header-content">
      <div class="header-text">
        <h1>Quarter Status Dashboard</h1>
        <p>Review existing team and accounting period data status across models</p>
      </div>
      <div class="nbp-header-right">
        <%= link_to features_path, class: "back-btn" do %>
          <i class="fas fa-arrow-left"></i> Back to Dashboard
        <% end %>
      </div>
    </div>
  </header>

  <% if flash[:alert] || flash[:notice] %>
    <div class="flash-messages">
      <% if flash[:alert] %>
        <div class="flash-message alert">
          <i class="fas fa-exclamation-triangle"></i>
          <%= flash[:alert] %>
        </div>
      <% end %>
      <% if flash[:notice] %>
        <div class="flash-message notice">
          <i class="fas fa-check-circle"></i>
          <%= flash[:notice] %>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Developer Instructions Note Box -->
  <section class="nbp-card nbp-card--instructions">
    <h2><i class="fas fa-terminal"></i> Model Jobs & Seeds Runner Guide</h2>
    <p class="nbp-card-hint">Use these console commands and runner scripts to clean, map, and seed data in your environment.</p>
    
    <div class="instructions-grid">
      <div class="instruction-item">
        <div class="instruction-header">
          <span class="instruction-title">Brand & Strength Debug Job</span>
          <button class="copy-btn" onclick="copyText('NewBiosimilarPrice.extract_brand_and_strength_debug')">
            <i class="far fa-copy"></i> Copy
          </button>
        </div>
        <pre><code id="cmd-brand">NewBiosimilarPrice.extract_brand_and_strength_debug</code></pre>
      </div>

      <div class="instruction-item">
        <div class="instruction-header">
          <span class="instruction-title">Extracted Insurances Job</span>
          <button class="copy-btn" onclick="copyText('NewBiosimilarPrice.extract_all_insurances')">
            <i class="far fa-copy"></i> Copy
          </button>
        </div>
        <pre><code id="cmd-insurances">NewBiosimilarPrice.extract_all_insurances</code></pre>
      </div>

      <div class="instruction-item">
        <div class="instruction-header">
          <span class="instruction-title">Payor Insurance Mapping</span>
          <button class="copy-btn" onclick="copyText('NewBiosimilarPrice.build_payor_insurance_mapping')">
            <i class="far fa-copy"></i> Copy
          </button>
        </div>
        <pre><code id="cmd-mapping">NewBiosimilarPrice.build_payor_insurance_mapping</code></pre>
      </div>

      <div class="instruction-item">
        <div class="instruction-header">
          <span class="instruction-title">Seed Payor Preferences Command</span>
          <button class="copy-btn" onclick="copyText('rails runner db/seeds/payor_preferences.rb')">
            <i class="far fa-copy"></i> Copy
          </button>
        </div>
        <pre><code id="cmd-seed">rails runner db/seeds/payor_preferences.rb</code></pre>
      </div>
    </div>
  </section>

  <!-- Data Coverage Status Table -->
  <section class="nbp-card nbp-card--table">
    <h2><i class="fas fa-database"></i> Existing Data Coverage Status</h2>
    <p class="nbp-card-hint">Showing details of active combinations found across NewBiosimilarPrice, Payor, and PayorPreference tables.</p>
    
    <% if @quarter_statuses.any? %>
      <div class="nbp-table-wrap">
        <table class="nbp-table">
          <thead>
            <tr>
              <th>Team ID</th>
              <th>Accounting Period ID</th>
              <th>Quarter Name</th>
              <th>New Biosimilar Prices</th>
              <th>Payors</th>
              <th>Payor Preferences</th>
              <th>Status Coverage</th>
            </tr>
          </thead>
          <tbody>
            <% @quarter_statuses.each do |status| %>
              <tr>
                <td><strong><%= status[:team_id] %></strong></td>
                <td><span class="badge badge--neutral"><%= status[:accounting_period_id] %></span></td>
                <td><span class="badge badge--primary"><%= status[:quarter_name] %></span></td>
                <td>
                  <div class="status-detail">
                    <span class="main-count"><%= status[:biosimilar][:total] %> records</span>
                    <% if status[:biosimilar][:total] > 0 %>
                      <div class="sub-stats">
                        <span class="sub-stat" title="Brand extracted"><i class="fas fa-tag"></i> Brand: <%= status[:biosimilar][:with_brand] %>/<%= status[:biosimilar][:total] %></span>
                        <span class="sub-stat" title="Strength extracted"><i class="fas fa-mortar-pestle"></i> Strength: <%= status[:biosimilar][:with_strength] %>/<%= status[:biosimilar][:total] %></span>
                        <span class="sub-stat" title="Insurances extracted"><i class="fas fa-shield-alt"></i> Insurances: <%= status[:biosimilar][:with_insurances] %>/<%= status[:biosimilar][:total] %></span>
                      </div>
                    <% end %>
                  </div>
                </td>
                <td>
                  <span class="main-count"><%= status[:payor_count] %> records</span>
                </td>
                <td>
                  <span class="main-count"><%= status[:preference_count] %> records</span>
                </td>
                <td>
                  <% if status[:biosimilar][:total] > 0 && status[:payor_count] > 0 && status[:preference_count] > 0 %>
                    <span class="badge badge--success"><i class="fas fa-check-circle"></i> Fully Populated</span>
                  <% elsif status[:biosimilar][:total] > 0 || status[:payor_count] > 0 || status[:preference_count] > 0 %>
                    <span class="badge badge--warning"><i class="fas fa-exclamation-circle"></i> Partial Data</span>
                  <% else %>
                    <span class="badge badge--danger"><i class="fas fa-times-circle"></i> Empty</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="nbp-empty">
        <div class="nbp-empty-icon">
          <i class="fas fa-folder-open"></i>
        </div>
        <h3>No existing team quarter status configurations found</h3>
        <p>Ensure that data exists in your database tables.</p>
      </div>
    <% end %>
  </section>
</div>

<style>
  :root {
    --primary: #4361ee;
    --primary-light: #6c8aff;
    --primary-dark: #3a56d4;
    --secondary: #7209b7;
    --accent: #4cc9f0;
    --danger: #f72585;
    --success: #06d6a0;
    --warning: #ffb703;
    --dark: #0f172a;
    --gray: #64748b;
    --light: #f8fafc;
    --shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    --border-radius: 16px;
    --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .upload-container {
    max-width: 1280px;
    margin: 2rem auto;
    padding: 0 1.5rem;
    font-family: 'Inter', sans-serif;
  }

  .header {
    margin-bottom: 2rem;
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .header-text h1 {
    font-size: 2.2rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .header-text p {
    color: var(--gray);
    margin: 0;
    font-size: 1.05rem;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 50px;
    padding: 0.65rem 1.25rem;
    color: var(--dark);
    font-weight: 600;
    text-decoration: none;
    transition: var(--transition);
    box-shadow: 0 2px 8px rgba(0,0,0,0.02);
  }

  .back-btn:hover {
    transform: translateY(-2px);
    border-color: var(--primary);
    color: var(--primary);
    box-shadow: 0 4px 12px rgba(67, 97, 238, 0.1);
  }

  .nbp-card {
    background: #ffffff;
    border-radius: var(--border-radius);
    padding: 2rem;
    margin-bottom: 2rem;
    box-shadow: var(--shadow);
    border-top: 4px solid var(--primary);
  }

  .nbp-card--instructions {
    border-top-color: var(--secondary);
  }

  .nbp-card h2 {
    font-size: 1.3rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    color: var(--dark);
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .nbp-card-hint {
    margin: 0 0 1.5rem 0;
    color: var(--gray);
    font-size: 0.95rem;
  }

  .instructions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .instruction-item {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1rem 1.25rem;
    transition: var(--transition);
  }

  .instruction-item:hover {
    border-color: var(--primary-light);
    box-shadow: 0 4px 12px rgba(67, 97, 238, 0.05);
  }

  .instruction-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .instruction-title {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--dark);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .copy-btn {
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 6px;
    padding: 0.25rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    color: var(--gray);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: var(--transition);
  }

  .copy-btn:hover {
    color: var(--primary);
    border-color: var(--primary-light);
    background: rgba(67, 97, 238, 0.03);
  }

  pre {
    margin: 0;
    background: #0f172a;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    overflow-x: auto;
  }

  code {
    font-family: 'Fira Code', 'Courier New', Courier, monospace;
    font-size: 0.85rem;
    color: #38bdf8;
  }

  .nbp-table-wrap {
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
  }

  .nbp-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 900px;
  }

  .nbp-table th,
  .nbp-table td {
    padding: 1.25rem 1.5rem;
    text-align: left;
    border-bottom: 1px solid #e2e8f0;
  }

  .nbp-table th {
    background: #f8fafc;
    font-weight: 700;
    color: var(--dark);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .nbp-table tbody tr {
    transition: var(--transition);
  }

  .nbp-table tbody tr:hover {
    background: rgba(67, 97, 238, 0.02);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .badge--neutral {
    background: #f1f5f9;
    color: #475569;
  }

  .badge--primary {
    background: rgba(67, 97, 238, 0.1);
    color: var(--primary);
  }

  .badge--success {
    background: rgba(6, 214, 160, 0.1);
    color: #047857;
  }

  .badge--warning {
    background: rgba(255, 183, 3, 0.1);
    color: #b45309;
  }

  .badge--danger {
    background: rgba(247, 25, 133, 0.1);
    color: var(--danger);
  }

  .status-detail {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .main-count {
    font-weight: 600;
    color: var(--dark);
    font-size: 0.95rem;
  }

  .sub-stats {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .sub-stat {
    font-size: 0.78rem;
    color: var(--gray);
    background: #f1f5f9;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nbp-empty {
    text-align: center;
    padding: 3rem 1.5rem;
    color: var(--gray);
  }

  .nbp-empty-icon {
    width: 64px;
    height: 64px;
    background: rgba(67, 97, 238, 0.08);
    color: var(--primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    margin: 0 auto 1rem;
  }

  .nbp-empty h3 {
    color: var(--dark);
    margin: 0 0 0.5rem 0;
  }

  .flash-messages {
    margin-bottom: 1.5rem;
  }

  .flash-message {
    padding: 1rem 1.25rem;
    border-radius: 8px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .flash-message.alert {
    background: rgba(247, 25, 133, 0.1);
    border: 1px solid rgba(247, 25, 133, 0.2);
    color: var(--danger);
  }

  .flash-message.notice {
    background: rgba(6, 214, 160, 0.1);
    border: 1px solid rgba(6, 214, 160, 0.2);
    color: #047857;
  }
</style>

<script>
  function copyText(text) {
    navigator.clipboard.writeText(text).then(function() {
      // Find all buttons, restore text, set current to Copied
      const buttons = document.querySelectorAll('.copy-btn');
      buttons.forEach(btn => {
        if (btn.getAttribute('onclick').includes(text)) {
          btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
          btn.style.color = 'var(--success)';
          btn.style.borderColor = 'rgba(6, 214, 160, 0.3)';
          btn.style.background = 'rgba(6, 214, 160, 0.03)';
          
          setTimeout(() => {
            btn.innerHTML = '<i class="far fa-copy"></i> Copy';
            btn.style.color = '';
            btn.style.borderColor = '';
            btn.style.background = '';
          }, 2000);
        }
      });
    }, function(err) {
      console.error('Could not copy text: ', err);
    });
  }
</script>
