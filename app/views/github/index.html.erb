<div class="gh-portal-container">
  <header class="gh-header-clean">
    <div class="gh-title-row">
      <h1 class="og-title"><i class="fab fa-github"></i> GitHub Analytics Gateway</h1>
      <span class="og-slash" aria-hidden="true"></span>
      <p>Connect your account to synchronize repository metadata, PR stats, and track developer contributions in real-time.</p>
    </div>
    <div class="gh-actions">
      <%= link_to features_path, class: "gh-btn-outline" do %>
        <i class="fas fa-arrow-left"></i> Back to Dashboard
      <% end %>
    </div>
  </header>

  <div class="gh-card-center">
    <% if current_user.github_account.nil? %>
      <div class="gh-auth-box">
        <div class="gh-logo-wrapper">
          <i class="fab fa-github"></i>
        </div>
        <h2>Link your GitHub Account</h2>
        <p>Authorize access to automatically fetch your private organizational repositories and track PR metrics dynamically.</p>
        
        <%= button_to "/auth/github", method: :post, data: { turbo: false }, class: "gh-btn-primary gh-auth-btn" do %>
          <i class="fab fa-github"></i> Connect via GitHub
        <% end %>
      </div>
    <% else %>
      <div class="gh-auth-box success">
        <div class="gh-logo-wrapper connected">
          <i class="fas fa-check-circle"></i>
        </div>
        <h2>Account Connected!</h2>
        <p>Your GitHub token is securely stored. You can now access full repository analytical insights and PR graphs.</p>
        
        <%= link_to github_dashboard_path, class: "gh-btn-primary gh-auth-btn connected-btn" do %>
          <i class="fas fa-chart-line"></i> Launch Analytics Dashboard
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<style data-theme-style="classic" media="<%= theme_media(:classic) %>">
  .gh-portal-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
    font-family: "Inter", sans-serif;
  }
  .gh-header-clean {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #fff;
    padding: 1.5rem 2rem;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    margin-bottom: 3rem;
  }
  .gh-title-row h1 { margin: 0 0 0.5rem; font-size: 1.8rem; font-weight: 800; color: #0f172a; }
  .gh-title-row p { margin: 0; color: #64748b; font-size: 0.95rem; }

  .gh-btn-outline {
    background: transparent;
    color: #4361ee;
    text-decoration: none;
    padding: 0.8rem 1.5rem;
    border-radius: 12px;
    font-weight: 600;
    font-size: 0.95rem;
    border: 2px solid #4361ee;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .gh-btn-outline:hover { background: #4361ee; color: white; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(67, 97, 238, 0.2); }
  
  .gh-card-center {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 400px;
  }
  .gh-auth-box {
    background: #ffffff;
    border-radius: 20px;
    padding: 3rem 2.5rem;
    text-align: center;
    max-width: 450px;
    width: 100%;
    box-shadow: 0 10px 40px rgba(0,0,0,0.08);
    border: 1px solid #e2e8f0;
    transition: all 0.3s ease;
  }
  .gh-auth-box:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 50px rgba(0,0,0,0.12);
  }
  .gh-logo-wrapper {
    width: 80px;
    height: 80px;
    background: #f8fafc;
    border-radius: 50%;
    margin: 0 auto 1.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 3rem;
    color: #1e293b;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
  }
  .gh-logo-wrapper.connected {
    color: #10b981;
    background: #ecfdf5;
  }
  .gh-auth-box h2 {
    font-size: 1.5rem;
    color: #0f172a;
    margin-bottom: 0.75rem;
    font-weight: 700;
  }
  .gh-auth-box p {
    color: #64748b;
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 2rem;
  }
  .gh-btn-primary {
    background: #1e293b;
    color: white;
    padding: 1rem 2rem;
    border-radius: 12px;
    border: none;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    text-decoration: none;
  }
  .gh-btn-primary.connected-btn {
    background: #4361ee;
  }
  .gh-btn-primary.connected-btn:hover {
    background: #3730a3;
    box-shadow: 0 6px 15px rgba(67, 97, 238, 0.3);
  }
  .gh-btn-primary:hover {
    background: #0f172a;
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(15, 23, 42, 0.25);
    color: white;
  }
</style>
