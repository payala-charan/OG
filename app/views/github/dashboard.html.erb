<% 
  is_global = @selected_repo.blank?
  active_repo = @repositories.find { |r| r.id.to_s == @selected_repo.to_s }
  chart_mode = params[:author].present? ? 'single' : 'combined'
%>

<div class="gh-dashboard-container">
  <!-- Sidebar -->
  <aside class="gh-sidebar">
    <div class="gh-sidebar-header">
      <h2><i class="fab fa-github"></i> Repositories</h2>
      <span class="badge"><%= @repositories.count %></span>
    </div>
    
    <div class="gh-repo-list">
      <!-- Global Overview Button -->
      <%= link_to github_dashboard_path, class: "gh-repo-item #{is_global ? 'active' : ''}" do %>
        <div class="repo-icon"><i class="fas fa-globe"></i></div>
        <div class="repo-info">
          <span class="repo-name">Account Overview</span>
          <span class="repo-owner">All Repositories</span>
        </div>
      <% end %>

      <% @repositories.each do |repo| %>
        <% active_class = @selected_repo.to_s == repo.id.to_s ? 'active' : '' %>
        <%= link_to github_dashboard_path(repo_id: repo.id), class: "gh-repo-item #{active_class}" do %>
          <div class="repo-icon"><i class="fas fa-book"></i></div>
          <div class="repo-info">
            <span class="repo-name"><%= repo.name %></span>
            <span class="repo-owner"><%= repo.owner %></span>
          </div>
        <% end %>
      <% end %>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="gh-main">
    <header class="gh-topbar">
      <div class="topbar-title">
        <h1><%= is_global ? "Macroscopic Account Overview" : active_repo&.name %></h1>
        <p><%= is_global ? "Aggregated Organization View" : "Direct Repository Analytics Tracking" %></p>
      </div>

      <div class="topbar-actions">
        <%= link_to github_path, class: "gh-btn-outline icon-only", title: "Gateway" do %>
          <i class="fas fa-home"></i>
        <% end %>
        <%= button_to github_refresh_path, method: :post, form_class: "inline-form", class: "gh-btn-primary" do %>
          <i class="fas fa-sync-alt"></i> Sync GitHub
        <% end %>
      </div>
    </header>

    <!-- KPI Stats Active Everywhere -->
    <div class="gh-kpi-grid">
      <div class="kpi-card total">
        <div class="kpi-icon"><i class="fas fa-code-branch"></i></div>
        <div class="kpi-data">
          <h3>Total Aggregated PRs</h3>
          <span class="kpi-value"><%= @total_prs %></span>
        </div>
      </div>
      <div class="kpi-card open">
        <div class="kpi-icon"><i class="fas fa-exclamation-circle"></i></div>
        <div class="kpi-data">
          <h3>Open</h3>
          <span class="kpi-value"><%= @open_prs %></span>
        </div>
      </div>
      <div class="kpi-card closed">
        <div class="kpi-icon"><i class="fas fa-times-circle"></i></div>
        <div class="kpi-data">
          <h3>Closed</h3>
          <span class="kpi-value"><%= @closed_prs %></span>
        </div>
      </div>
      <div class="kpi-card merged">
        <div class="kpi-icon"><i class="fas fa-check-double"></i></div>
        <div class="kpi-data">
          <h3>Merged</h3>
          <span class="kpi-value"><%= @merged_prs %></span>
        </div>
      </div>
      <div class="kpi-card yearly">
        <div class="kpi-icon"><i class="fas fa-calendar-alt"></i></div>
        <div class="kpi-data">
          <h3>This Year (PRs)</h3>
          <span class="kpi-value"><%= @total_yearly_prs %></span>
        </div>
      </div>
      <div class="kpi-card monthly">
        <div class="kpi-icon"><i class="fas fa-calendar-day"></i></div>
        <div class="kpi-data">
          <h3>This Month (PRs)</h3>
          <span class="kpi-value"><%= @total_monthly_prs %></span>
        </div>
      </div>
      <div class="kpi-card commit-total">
        <div class="kpi-icon"><i class="fas fa-code"></i></div>
        <div class="kpi-data">
          <h3>Total Commit Contributions</h3>
          <span class="kpi-value"><%= @total_commit_contributions %></span>
        </div>
      </div>
    </div>

    <!-- Contribution heatmap -->
    <div class="gh-panel heatmap-panel">
      <div class="panel-header">
        <h3><%= @heatmap_data[:total] %> contributions in <%= @heatmap_data[:year] %></h3>
        <div class="heatmap-controls">
          <span>Year:</span>
          <% @available_years.each do |year| %>
            <%= link_to github_dashboard_path(repo_id: @selected_repo, author: params[:author], year: year), class: "heatmap-year-btn #{'active' if year == @heatmap_data[:year]}" do %>
              <%= year %>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="heatmap-grid" aria-label="Contribution heatmap for <%= @heatmap_data[:year] %>">
        <% if @heatmap_data[:weeks].present? %>
          <% @heatmap_data[:weeks].each do |week| %>
            <div class="heatmap-week">
              <% week["contributionDays"].each do |day| %>
                <span class="heatmap-cell" style="background-color: <%= day["color"] %>;" title="<%= day["date"] %>: <%= day["contributionCount"] %> contributions"></span>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <div class="empty-msg" style="width: 100%;">No contribution data available from GitHub API. Ensure your token has read:user scope.</div>
        <% end %>
      </div>

      <div class="heatmap-legend">
        <span style="color: #475569;">Learn how we count contributions</span>
        <div style="flex:1;"></div>
        <span>Less</span>
        <span class="legend-box" style="background-color: #ebedf0; border: 1px solid rgba(27,31,35,0.06);"></span>
        <span class="legend-box" style="background-color: #9be9a8; border: 1px solid rgba(27,31,35,0.06);"></span>
        <span class="legend-box" style="background-color: #40c463; border: 1px solid rgba(27,31,35,0.06);"></span>
        <span class="legend-box" style="background-color: #30a14e; border: 1px solid rgba(27,31,35,0.06);"></span>
        <span class="legend-box" style="background-color: #216e39; border: 1px solid rgba(27,31,35,0.06);"></span>
        <span>More</span>
      </div>
    </div>

    <!-- Active Chart and Authors -->
    <div class="gh-content-grid">
      <div class="gh-panel author-panel">
        <div class="panel-header">
          <h3>Top Overall Contributors</h3>
          <span class="badge"><%= @author_contributions&.count || 0 %> Accounts</span>
        </div>
        <div class="author-list">
          <% if @author_contributions.present? %>
            <% @author_contributions.sort_by { |_, count| -count }.each do |author, count| %>
              <% active_author = params[:author] == author ? 'active' : '' %>
              <% commit_count = @commit_contributions[author] || 0 %>
              <% yearly_pr = @yearly_pr_contributions[author] || 0 %>
              <% monthly_pr = @monthly_pr_contributions[author] || 0 %>
              <%= link_to github_dashboard_path(repo_id: @selected_repo, author: author), class: "author-item #{active_author}" do %>
                <div class="author-avatar"><i class="fas fa-user-astronaut"></i></div>
                <div class="author-meta">
                  <span class="author-name"><%= author %></span>
                  <span class="author-count"><%= count %> PRs Submitted</span>
                  <span class="author-count">Year: <%= yearly_pr %> • Month: <%= monthly_pr %></span>
                  <span class="author-count">Commits: <%= commit_count %></span>
                </div>
                <div class="author-go"><i class="fas fa-chevron-right"></i></div>
              <% end %>
            <% end %>
          <% else %>
            <div class="empty-msg">No contributors detected yet.</div>
          <% end %>
        </div>
      </div>

      <div class="gh-panel chart-panel">
        <div class="panel-header advanced-chart-header">
          <div class="chart-title-box">
            <h3>Contribution Metrics <span class="badge-sub"><%= chart_mode == 'single' ? "@#{params[:author]}" : "Combined Overlay" %></span></h3>
          </div>
          <div class="chart-toggles">
            <button class="toggle-btn" data-period="daily">Daily</button>
            <button class="toggle-btn active" data-period="monthly">Monthly</button>
            <button class="toggle-btn" data-period="yearly">Yearly</button>
          </div>
        </div>
        <div class="chart-container">
          <canvas id="contributionChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Maximum 15 Pull Requests Table -->
    <div class="gh-panel full-width">
      <div class="panel-header">
        <h3>Most Recent Pull Requests</h3>
        <span class="badge">Limiting to strict top 15 records</span>
      </div>
      <div class="table-container">
        <table class="gh-table">
          <thead>
            <tr>
              <th>PR #</th>
              <th>Titular Context</th>
              <th>Author</th>
              <th>Status Scope</th>
              <th>Merged Verification</th>
              <th>Timeline</th>
            </tr>
          </thead>
          <tbody>
            <% if @pull_requests.present? %>
              <% @pull_requests.order(created_at: :desc).limit(15).each do |pr| %>
                <tr>
                  <td><span class="pr-id">#<%= pr.pr_number %></span></td>
                  <td class="pr-title"><strong><%= pr.title %></strong></td>
                  <td>
                    <div class="td-author">
                      <div class="av"><i class="fas fa-user-circle"></i></div>
                      <%= pr.author %>
                    </div>
                  </td>
                  <td>
                    <% status_class = pr.merged ? 'merged' : (pr.state == 'open' ? 'open' : 'closed') %>
                    <span class="pr-badge <%= status_class %>"><%= pr.merged ? 'Merged' : pr.state.capitalize %></span>
                  </td>
                  <td><span class="merged-by"><%= pr.merged_by.presence || "—" %></span></td>
                  <td class="pr-date"><%= pr.created_at&.strftime("%b %d, %Y") %></td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="empty-list-row">No pull requests matched this query filter.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<!-- Scripts for Chart.js Advanced Engine -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  window.GH_CHART_MODE = "<%= chart_mode %>";
  
  window.GH_SINGLE_DATA = {
    daily: <%= raw (@daily_data || {}).to_json %>,
    monthly: <%= raw (@monthly_data || {}).to_json %>,
    yearly: <%= raw (@yearly_data || {}).to_json %>
  };

  window.GH_COMBINED_DATA = {
    daily: <%= raw (@combined_daily_data || {}).to_json %>,
    monthly: <%= raw (@combined_monthly_data || {}).to_json %>,
    yearly: <%= raw (@combined_yearly_data || {}).to_json %>
  };

  // Color Palette specifically designed for Multi-Stacked Bar charts
  const palette = [
    '#4361ee', '#f72585', '#4cc9f0', '#7209b7', '#fbc3bc',
    '#06d6a0', '#ff9e00', '#118ab2', '#073b4c', '#ef476f'
  ];

  document.addEventListener("DOMContentLoaded", function() {
    const ctx = document.getElementById('contributionChart');
    if (!ctx) return;
    const ttx = ctx.getContext('2d');
    
    let chartInstance = null;

    function renderChart(period) {
      if (chartInstance) chartInstance.destroy();

      let isSingle = window.GH_CHART_MODE === 'single';
      let chartType = isSingle ? 'line' : 'bar';
      
      let allLabels = new Set();
      let datasets = [];

      if (isSingle) {
        let rawData = window.GH_SINGLE_DATA[period];
        let keys = Object.keys(rawData).sort();
        keys.forEach(k => allLabels.add(k));
        
        let pointData = keys.map(k => rawData[k]);
        datasets.push({
          label: 'Authored PRs',
          data: pointData,
          borderColor: '#4361ee',
          backgroundColor: 'rgba(67, 97, 238, 0.15)',
          borderWidth: 3,
          tension: 0.4,
          fill: true,
          pointBackgroundColor: '#fff',
          pointBorderColor: '#4361ee',
          pointRadius: 5
        });
      } else {
        // Combined Stacked Bars Structure
        let masterData = window.GH_COMBINED_DATA[period];
        let authorKeys = Object.keys(masterData);

        // Map every date used across ALL authors
        authorKeys.forEach(auth => {
          Object.keys(masterData[auth]).forEach(dateKey => {
            allLabels.add(dateKey);
          });
        });

        let sortedLabels = Array.from(allLabels).sort();
        
        authorKeys.forEach((auth, idx) => {
          let authorDatapoints = sortedLabels.map(label => masterData[auth][label] || 0);
          let assignedColor = palette[idx % palette.length];

          datasets.push({
            label: auth,
            data: authorDatapoints,
            backgroundColor: assignedColor,
            borderColor: '#fff',
            borderWidth: 1,
            borderRadius: 4
          });
        });
      }

      let finalLabels = Array.from(allLabels).sort();

      chartInstance = new Chart(ttx, {
        type: chartType,
        data: {
          labels: finalLabels,
          datasets: datasets
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { 
              display: !isSingle, // Show legend only for combined authors overlay
              position: 'bottom',
              labels: { usePointStyle: true, boxWidth: 10, font: {family: 'Inter'} }
            },
            tooltip: {
              backgroundColor: '#1e293b',
              padding: 12,
              titleFont: { size: 13, family: 'Inter' },
              bodyFont: { size: 14, weight: 'bold', family: 'Inter' },
              displayColors: !isSingle,
              cornerRadius: 8,
              mode: 'index',
              intersect: false
            }
          },
          scales: {
            x: { 
              stacked: !isSingle,
              grid: { display: false },
              ticks: { color: '#64748b', font: {family: 'Inter'} }
            },
            y: { 
              stacked: !isSingle,
              beginAtZero: true, 
              grid: { borderDash: [4, 4], color: '#f1f5f9' }, 
              ticks: { stepSize: 1, color: '#64748b', font: {family: 'Inter'} }
            }
          }
        }
      });
    }

    // Default Initialization
    renderChart('monthly');

    // UI Tab Listeners securely mapping DOM updates to Chart renders without reload
    document.querySelectorAll('.toggle-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.toggle-btn').forEach(b => b.classList.remove('active'));
        e.target.classList.add('active');
        let selectedPeriod = e.target.dataset.period;
        renderChart(selectedPeriod);
      });
    });

  });
</script>

<style>
  .gh-dashboard-container {
    display: flex;
    height: calc(100vh - 40px);
    background: #f8fafc;
    border-radius: 20px;
    overflow: hidden;
    margin: 10px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.05);
    border: 1px solid #e2e8f0;
    font-family: 'Inter', sans-serif;
  }

  /* Sidebar */
  .gh-sidebar { width: 300px; background: #ffffff; border-right: 1px solid #e2e8f0; display: flex; flex-direction: column; z-index: 10; }
  .gh-sidebar-header { padding: 1.5rem; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; }
  .gh-sidebar-header h2 { font-size: 1.1rem; font-weight: 700; color: #0f172a; margin: 0; display: flex; align-items: center; gap: 0.5rem; }
  .badge { background: #f1f5f9; color: #475569; padding: 0.2rem 0.6rem; border-radius: 50px; font-size: 0.8rem; font-weight: 600; }
  .gh-repo-list { flex: 1; overflow-y: auto; padding: 1rem 0; }
  .gh-repo-item { display: flex; align-items: center; gap: 1rem; padding: 0.8rem 1.5rem; text-decoration: none; transition: all 0.2s; border-left: 3px solid transparent; }
  .gh-repo-item:hover { background: #f8fafc; }
  .gh-repo-item.active { background: #f0f4ff; border-left-color: #4361ee; }
  .repo-icon { width: 36px; height: 36px; border-radius: 8px; background: #f1f5f9; color: #475569; display: flex; justify-content: center; align-items: center; font-size: 0.9rem; }
  .gh-repo-item.active .repo-icon { background: #4361ee; color: white; }
  .repo-info { display: flex; flex-direction: column; gap: 0.2rem; }
  .repo-name { font-size: 0.9rem; font-weight: 600; color: #1e293b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 180px; }
  .repo-owner { font-size: 0.75rem; color: #64748b; }
  .gh-repo-item.active .repo-name { color: #4361ee; }

  /* Main Area */
  .gh-main { flex: 1; display: flex; flex-direction: column; overflow-y: auto; background: #f8fafc; }
  .gh-topbar { padding: 1.5rem 2.5rem; background: #ffffff; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; position: sticky; top: 0; z-index: 5; }
  .topbar-title h1 { font-size: 1.5rem; font-weight: 800; margin: 0 0 0.3rem; color: #0f172a; }
  .topbar-title p { font-size: 0.9rem; color: #64748b; margin: 0; }
  .topbar-actions { display: flex; gap: 1rem; align-items: center; }
  .inline-form { margin: 0; }
  .gh-btn-primary, .gh-btn-outline { padding: 0.6rem 1.2rem; border-radius: 10px; font-size: 0.9rem; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; transition: all 0.2s; }
  .gh-btn-primary { background: #4361ee; color: white; border: none; box-shadow: 0 4px 10px rgba(67, 97, 238, 0.2); }
  .gh-btn-primary:hover { background: #3730a3; transform: translateY(-2px); }
  .gh-btn-outline { background: transparent; color: #475569; border: 1px solid #cbd5e1; }
  .gh-btn-outline:hover { background: #f1f5f9; color: #0f172a; }
  .gh-btn-outline.icon-only { padding: 0.6rem; }

  /* KPIs */
  .gh-kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; padding: 2rem 2.5rem 1rem; }
  .kpi-card { background: white; padding: 1.5rem; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.02); border: 1px solid #e2e8f0; display: flex; align-items: center; gap: 1.2rem; transition: transform 0.2s; }
  .kpi-card:hover { transform: translateY(-3px); box-shadow: 0 10px 25px rgba(0,0,0,0.05); }
  .kpi-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; justify-content: center; align-items: center; font-size: 1.2rem; }
  .kpi-card.total .kpi-icon { background: #eff6ff; color: #3b82f6; }
  .kpi-card.open .kpi-icon { background: #fefce8; color: #eab308; }
  .kpi-card.closed .kpi-icon { background: #fef2f2; color: #ef4444; }
  .kpi-card.merged .kpi-icon { background: #ecfdf5; color: #10b981; }
  .kpi-data h3 { margin: 0 0 0.3rem; font-size: 0.85rem; color: #64748b; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;}
  .kpi-value { font-size: 1.8rem; font-weight: 800; color: #0f172a; }

  /* Chart & Authors Array Config */
  .gh-content-grid { display: grid; grid-template-columns: 350px 1fr; gap: 1.5rem; padding: 1rem 2.5rem; }
  .gh-panel { background: white; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.02); border: 1px solid #e2e8f0; display: flex; flex-direction: column; overflow: hidden; }
  .gh-panel.full-width { margin: 1rem 2.5rem 2.5rem; }
  .panel-header { padding: 1.2rem 1.5rem; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; }
  .panel-header h3 { margin: 0; font-size: 1rem; font-weight: 700; color: #0f172a; }
  .badge-sub { font-size: 0.8rem; background: #f1f5f9; padding: 0.2rem 0.5rem; border-radius: 6px; color: #4361ee; margin-left: 0.5rem; }

  /* Chart Layout Details */
  .advanced-chart-header { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
  .chart-toggles { display: flex; background: #f1f5f9; padding: 3px; border-radius: 8px; }
  .toggle-btn { background: transparent; border: none; padding: 0.4rem 0.8rem; font-size: 0.8rem; font-weight: 600; color: #64748b; border-radius: 6px; cursor: pointer; transition: all 0.2s; }
