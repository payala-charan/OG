  .chart-container { padding: 1.5rem; flex: 1; position: relative; min-height: 400px; }

  /* Author Sidebar */
  .author-list { flex: 1; overflow-y: auto; max-height: 430px; }
  .empty-msg { padding: 2rem; color: #94a3b8; text-align: center; font-size: 0.9rem; }
  .author-item { display: flex; align-items: center; padding: 1rem 1.5rem; text-decoration: none; border-bottom: 1px solid #f8fafc; transition: all 0.2s; }
  .author-item:hover { background: #f8fafc; }
  .author-item.active { background: #f0f4ff; }
  .author-avatar { width: 40px; height: 40px; background: #e2e8f0; border-radius: 50%; display: flex; justify-content: center; align-items: center; color: #64748b; margin-right: 1rem; }
  .author-item.active .author-avatar { background: #4361ee; color: white;}
  .author-meta { flex: 1; display: flex; flex-direction: column; gap: 0.2rem; }
  .author-name { font-weight: 600; color: #1e293b; font-size: 0.95rem; }
  .author-count { font-size: 0.8rem; color: #64748b; }
  .author-go { color: #cbd5e1; font-size: 0.9rem; }
  .author-item.active .author-go { color: #4361ee; }

  /* Table Grid Struct */
  .table-container { width: 100%; overflow-x: auto; }
  .gh-table { width: 100%; border-collapse: collapse; text-align: left; }
  .gh-table th { background: #f8fafc; color: #64748b; font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; padding: 1rem 1.5rem; border-bottom: 1px solid #e2e8f0; }
  .gh-table td { padding: 1rem 1.5rem; border-bottom: 1px solid #f1f5f9; color: #334155; font-size: 0.9rem; }
  .empty-list-row { text-align: center; padding: 2rem !important; color: #94a3b8 !important; }
  .gh-table tr:hover td { background: #f8fafc; }
  .pr-id { font-family: monospace; font-weight: 600; color: #64748b; }
  .pr-title { max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .td-author { display: flex; align-items: center; gap: 0.5rem; font-weight: 500; }
  .td-author .av { color: #94a3b8; }
  .pr-badge { padding: 0.3rem 0.8rem; border-radius: 50px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }
  .pr-badge.merged { background: #ecfdf5; color: #10b981; }
  .pr-badge.open { background: #fefce8; color: #eab308; }
  .pr-badge.closed { background: #fef2f2; color: #ef4444; }
  .pr-date { color: #64748b; font-size: 0.85rem; }
  .merged-by { font-weight: 500; color: #475569; }

  /* Contribution heatmap style */
