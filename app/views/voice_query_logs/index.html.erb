<div class="upload-container">
  <!-- Header -->
  <header class="header">
    <div class="header-content">
      <div class="header-text">
        <h1>Voice Query Logs</h1>
        <p>View the last 20 voice query interactions and their responses</p>
      </div>
      <%= link_to voice_path, class: "back-btn" do %>
        <i class="fas fa-arrow-left"></i> Back to Voice Assistant
      <% end %>
    </div>
  </header>

  <!-- Stats Cards -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon">
        <i class="fas fa-database"></i>
      </div>
      <div class="stat-content">
        <div class="stat-number"><%= @logs.count %></div>
        <div class="stat-label">Total Logs</div>
      </div>
    </div>
    
    <div class="stat-card">
      <div class="stat-icon success">
        <i class="fas fa-check-circle"></i>
      </div>
      <div class="stat-content">
        <div class="stat-number"><%= @logs.count { |log| log.result == "Pass" } %></div>
        <div class="stat-label">Successful</div>
      </div>
    </div>
    
    <div class="stat-card">
      <div class="stat-icon danger">
        <i class="fas fa-times-circle"></i>
      </div>
      <div class="stat-content">
        <div class="stat-number"><%= @logs.count { |log| log.result != "Pass" } %></div>
        <div class="stat-label">Failed</div>
      </div>
    </div>
  </div>

  <!-- Logs Table Section -->
  <section class="data-section">
    <div class="section-header">
      <h3>Recent Voice Queries</h3>
      <p class="section-subtitle">Showing last <%= @logs.count %> queries</p>
    </div>

    <% if @logs.any? %>
      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th class="table-header">
                <div class="header-content">
                  <i class="fas fa-hashtag"></i>
                  #
                </div>
              </th>
              <th class="table-header">
                <div class="header-content">
                  <i class="fas fa-question-circle"></i>
                  Query
                </div>
              </th>
              <th class="table-header">
                <div class="header-content">
                  <i class="fas fa-reply"></i>
                  Response
                </div>
              </th>
              <th class="table-header">
                <div class="header-content">
                  <i class="fas fa-flag"></i>
                  Result
                </div>
              </th>
              <th class="table-header">
                <div class="header-content">
                  <i class="fas fa-clock"></i>
                  Time
                </div>
              </th>
            </tr>
          </thead>
          <tbody>
            <% @logs.each_with_index do |log, index| %>
              <tr class="table-row">
                <td class="table-cell">
                  <div class="cell-content">
                    <span class="index-badge"><%= index + 1 %></span>
                  </div>
                </td>
                <td class="table-cell">
                  <div class="cell-content">
                    <i class="fas fa-microphone cell-icon"></i>
                    <span class="cell-text query-text" title="<%= log.query %>">
                      <%= truncate(log.query, length: 50) %>
                    </span>
                  </div>
                </td>
                <td class="table-cell">
                  <div class="cell-content">
                    <i class="fas fa-robot cell-icon"></i>
                    <div class="response-content">
                      <% if log.response.present? %>
                        <% begin %>
                          <% parsed_response = JSON.parse(log.response) %>
                          <div class="json-preview">
                            <%= truncate(JSON.pretty_generate(parsed_response), length: 80) %>
                          </div>
                          <div class="json-full hidden">
                            <pre><code><%= JSON.pretty_generate(parsed_response) %></code></pre>
                          </div>
                          <button class="toggle-json-btn" onclick="toggleJSON(this)">
                            <i class="fas fa-expand-alt"></i>
                          </button>
                        <% rescue %>
                          <span class="response-text"><%= truncate(log.response, length: 80) %></span>
                        <% end %>
                      <% else %>
                        <span class="text-gray-400">No response</span>
                      <% end %>
                    </div>
                  </div>
                </td>
                <td class="table-cell">
                  <div class="cell-content">
                    <span class="status-badge <%= log.result == "Pass" ? 'status-success' : 'status-danger' %>">
                      <i class="fas <%= log.result == "Pass" ? 'fa-check' : 'fa-times' %>"></i>
                      <%= log.result %>
                    </span>
                  </div>
                </td>
                <td class="table-cell">
                  <div class="cell-content">
                    <i class="fas fa-calendar cell-icon"></i>
                    <span class="cell-text time-text">
                      <%= log.created_at.strftime("%Y-%m-%d") %>
                      <br>
                      <small class="text-gray-400"><%= log.created_at.strftime("%H:%M:%S") %></small>
                    </span>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <div class="empty-icon">
          <i class="fas fa-history"></i>
        </div>
        <h4>No Voice Query Logs</h4>
        <p>Voice queries will appear here once you start using the voice assistant</p>
        <%= link_to voice_path, class: "btn-primary mt-4" do %>
          <i class="fas fa-microphone"></i>
          Start Voice Assistant
        <% end %>
      </div>
    <% end %>
  </section>
</div>

<style>
  /* Reuse all existing CSS variables from the upload component */
  :root {
    --primary: #4361ee;
    --primary-light: #6c8aff;
    --primary-dark: #3a56d4;
    --secondary: #7209b7;
    --accent: #4cc9f0;
    --danger: #f72585;
    --warning: #ff9e00;
    --success: #06d6a0;
    --light: #f8f9fc;
    --dark: #2b2d42;
    --gray: #8d99ae;
    --border-radius: 16px;
    --shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    --transition: all 0.4s ease;
  }

  .upload-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
  }

  /* Header Styles */
  .header {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-radius: var(--border-radius);
    padding: 2rem;
    margin-bottom: 2rem;
    box-shadow: var(--shadow);
    border: 1px solid rgba(255, 255, 255, 0.8);
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .header-text h1 {
    font-weight: 800;
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .header-text p {
    color: var(--gray);
    font-size: 1.1rem;
  }

  .back-btn {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    color: white;
    border: none;
    border-radius: 50px;
    padding: 0.8rem 1.5rem;
    font-weight: 600;
    text-decoration: none;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 6px 20px rgba(67, 97, 238, 0.3);
  }

  .back-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(67, 97, 238, 0.4);
    color: white;
    text-decoration: none;
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .stat-card {
    background: white;
    border-radius: var(--border-radius);
    padding: 1.5rem;
    box-shadow: var(--shadow);
    display: flex;
    align-items: center;
    gap: 1rem;
    transition: var(--transition);
    border-top: 4px solid var(--primary);
  }

  .stat-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
  }

  .stat-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.5rem;
  }

  .stat-icon.success {
    background: linear-gradient(135deg, var(--success) 0%, #05c291 100%);
  }

  .stat-icon.danger {
    background: linear-gradient(135deg, var(--danger) 0%, #f55a9e 100%);
  }

  .stat-number {
    font-size: 2rem;
    font-weight: 800;
    color: var(--dark);
    line-height: 1;
  }

  .stat-label {
    color: var(--gray);
    font-size: 0.9rem;
    font-weight: 500;
  }

  /* Data Section */
  .data-section {
    background: white;
    border-radius: var(--border-radius);
    padding: 2.5rem;
    box-shadow: var(--shadow);
    transition: var(--transition);
  }

  .data-section:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
  }

  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section-header h3 {
    font-weight: 700;
    font-size: 1.8rem;
    color: var(--dark);
    margin-bottom: 0.5rem;
  }

  .section-subtitle {
    color: var(--gray);
    font-size: 1rem;
  }

  /* Table Container */
  .table-container {
    overflow-x: auto;
    border-radius: var(--border-radius);
    background: var(--light);
    padding: 1px;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    background: white;
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  /* Table Header */
  .table-header {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    color: white;
    padding: 1.5rem;
    text-align: left;
    font-weight: 600;
    font-size: 1rem;
  }

  .header-content {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .table-header:first-child {
    border-top-left-radius: var(--border-radius);
  }

  .table-header:last-child {
    border-top-right-radius: var(--border-radius);
  }

  /* Table Rows */
  .table-row {
    border-bottom: 1px solid rgba(141, 153, 174, 0.1);
    transition: var(--transition);
  }

  .table-row:hover {
    background: rgba(67, 97, 238, 0.03);
    transform: scale(1.01);
  }

  .table-row:last-child {
    border-bottom: none;
  }

  .table-cell {
    padding: 1.5rem;
    color: var(--dark);
    vertical-align: top;
  }

  .cell-content {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .cell-icon {
    color: var(--primary);
    font-size: 1.1rem;
    width: 20px;
    text-align: center;
    margin-top: 0.2rem;
  }

  .cell-text {
    font-weight: 500;
    line-height: 1.4;
  }

  /* Index Badge */
  .index-badge {
    background: rgba(67, 97, 238, 0.1);
    color: var(--primary);
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    min-width: 30px;
    text-align: center;
    display: inline-block;
  }

  /* Query Text */
  .query-text {
    word-break: break-word;
    max-width: 200px;
  }

  /* Response Content */
  .response-content {
    position: relative;
    flex: 1;
  }

  .json-preview, .response-text {
    background: rgba(67, 97, 238, 0.05);
    padding: 0.8rem;
    border-radius: 8px;
    border-left: 3px solid var(--primary);
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
    font-size: 0.8rem;
    line-height: 1.4;
    margin-bottom: 0.5rem;
    word-break: break-all;
  }

  .json-full pre {
    background: rgba(67, 97, 238, 0.05);
    padding: 1rem;
    border-radius: 8px;
    border-left: 3px solid var(--primary);
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
    font-size: 0.8rem;
    line-height: 1.4;
    overflow-x: auto;
    margin: 0;
  }

  .toggle-json-btn {
    background: rgba(67, 97, 238, 0.1);
    border: 1px solid var(--primary-light);
    color: var(--primary);
    border-radius: 6px;
    padding: 0.3rem 0.6rem;
    font-size: 0.7rem;
    cursor: pointer;
    transition: var(--transition);
  }

  .toggle-json-btn:hover {
    background: var(--primary);
    color: white;
  }

  /* Status Badges */
  .status-badge {
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .status-success {
    background: rgba(6, 214, 160, 0.1);
    color: var(--success);
    border: 1px solid rgba(6, 214, 160, 0.2);
  }

  .status-danger {
    background: rgba(247, 37, 133, 0.1);
    color: var(--danger);
    border: 1px solid rgba(247, 37, 133, 0.2);
  }

  /* Time Text */
  .time-text {
    font-size: 0.9rem;
    line-height: 1.3;
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--gray);
  }

  .empty-icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: rgba(141, 153, 174, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    color: var(--gray);
    font-size: 2rem;
  }

  .empty-state h4 {
    font-weight: 600;
    color: var(--dark);
    margin-bottom: 0.5rem;
  }

  /* Buttons */
  .btn-primary {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    color: white;
    border: none;
    border-radius: 50px;
    padding: 0.8rem 1.5rem;
    font-weight: 600;
    text-decoration: none;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 6px 20px rgba(67, 97, 238, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(67, 97, 238, 0.4);
    color: white;
    text-decoration: none;
  }

  /* Hidden utility */
  .hidden {
    display: none;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .upload-container {
      padding: 1rem;
    }

    .header-content {
      flex-direction: column;
      gap: 1.5rem;
      text-align: center;
    }

    .header-text h1 {
      font-size: 2rem;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }

    .data-section {
      padding: 1.5rem;
    }

    .table-header {
      padding: 1rem;
      font-size: 0.9rem;
    }

    .table-cell {
      padding: 1rem;
    }

    .cell-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .query-text {
      max-width: 150px;
    }
  }

  @media (max-width: 480px) {
    .header-text h1 {
      font-size: 1.8rem;
    }

    .data-section {
      padding: 1rem;
    }

    .table-header {
      padding: 0.8rem;
    }

    .table-cell {
      padding: 0.8rem;
    }

    .json-preview, .response-text {
      font-size: 0.7rem;
    }
  }
</style>

<script>
  function toggleJSON(button) {
    const row = button.closest('.response-content');
    const preview = row.querySelector('.json-preview');
    const full = row.querySelector('.json-full');
    const icon = button.querySelector('i');

    if (preview.classList.contains('hidden')) {
      // Show preview, hide full
      preview.classList.remove('hidden');
      full.classList.add('hidden');
      icon.className = 'fas fa-expand-alt';
    } else {
      // Show full, hide preview
      preview.classList.add('hidden');
      full.classList.remove('hidden');
      icon.className = 'fas fa-compress-alt';
    }
  }

  // Auto-expand JSON on click for better UX
  document.addEventListener('DOMContentLoaded', function() {
    const jsonPreviews = document.querySelectorAll('.json-preview');
    jsonPreviews.forEach(preview => {
      preview.addEventListener('click', function() {
        const button = this.closest('.response-content').querySelector('.toggle-json-btn');
        toggleJSON(button);
      });
    });
  });
</script>