<div class="upload-container nbp-blended">
  <header class="header">
    <div class="header-content">
      <div class="header-text">
        <h1>Upload blended costs</h1>
        <p>Import blended cost columns to match existing biosimilar rows</p>
      </div>
      <div class="nbp-blended-header-actions">
        <%= link_to new_biosimilar_prices_path, class: "back-btn back-btn--ghost" do %>
          <i class="fas fa-list"></i> Back to list
        <% end %>
        <%= link_to features_path, class: "back-btn" do %>
          <i class="fas fa-arrow-left"></i> Dashboard
        <% end %>
      </div>
    </div>
  </header>

  <% if flash[:alert] || flash[:notice] %>
    <div class="flash-messages">
      <% if flash[:alert] %>
        <div class="flash-message alert">
          <i class="fas fa-exclamation-triangle"></i>
          <%= flash[:alert] %>
        </div>
      <% end %>
      <% if flash[:notice] %>
        <div class="flash-message notice">
          <i class="fas fa-check-circle"></i>
          <%= flash[:notice] %>
        </div>
      <% end %>
    </div>
  <% end %>

  <section class="upload-card">
    <div class="upload-header">
      <div class="upload-icon">
        <i class="fas fa-file-excel"></i>
      </div>
      <div class="upload-text">
        <h2>Blended costs file</h2>
        <p>Use the template your team expects — .xlsx or .xls recommended.</p>
      </div>
    </div>

    <%= form_with url: import_blended_costs_new_biosimilar_prices_path, local: true, multipart: true, class: "upload-form", id: "nbpBlendedForm" do %>
      <div class="upload-area" id="nbpBlendedArea">
        <div class="upload-placeholder">
          <i class="fas fa-cloud-upload-alt"></i>
          <h3>Drag and drop your file</h3>
          <p>or click to browse</p>
        </div>
        <%= file_field_tag :file, id: "nbpBlendedInput", class: "file-input", accept: ".xlsx,.xls" %>

        <div id="nbpBlendedFileInfo" class="file-info" style="display: none;">
          <div class="file-details">
            <i class="fas fa-file-excel"></i>
            <div class="file-meta">
              <div class="file-name" id="nbpBlendedFileName">No file selected</div>
              <div class="file-size" id="nbpBlendedFileSize">0 KB</div>
            </div>
            <button type="button" id="nbpBlendedRemove" class="remove-btn" aria-label="Remove file">
              <i class="fas fa-times"></i>
            </button>
          </div>
        </div>
      </div>

      <div class="upload-actions">
        <%= submit_tag "Upload and update records", class: "upload-btn", id: "nbpBlendedBtn", disabled: true %>

        <div class="upload-tips">
          <div class="tip-item">
            <i class="fas fa-info-circle"></i>
            <span>Rows are matched on generic name group, generic name, NDC, and team.</span>
          </div>
          <div class="tip-item">
            <i class="fas fa-clock"></i>
            <span>Large files may take a short while to process.</span>
          </div>
        </div>
      </div>
    <% end %>
  </section>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    var area = document.getElementById("nbpBlendedArea");
    var input = document.getElementById("nbpBlendedInput");
    var info = document.getElementById("nbpBlendedFileInfo");
    var nameEl = document.getElementById("nbpBlendedFileName");
    var sizeEl = document.getElementById("nbpBlendedFileSize");
    var removeBtn = document.getElementById("nbpBlendedRemove");
    var btn = document.getElementById("nbpBlendedBtn");
    var form = document.getElementById("nbpBlendedForm");
    if (!area || !input) return;

    function formatSize(bytes) {
      if (!bytes) return "0 KB";
      var k = 1024;
      var i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + " " + ["Bytes", "KB", "MB", "GB"][i];
    }

    function pickFile(file) {
      if (!file) return;
      var ext = "." + file.name.split(".").pop().toLowerCase();
      if (ext !== ".xlsx" && ext !== ".xls") {
        alert("Please choose an Excel file (.xlsx or .xls).");
        input.value = "";
        return;
      }
      nameEl.textContent = file.name;
      sizeEl.textContent = formatSize(file.size);
      info.style.display = "block";
      btn.disabled = false;
    }

    area.addEventListener("click", function (e) {
      if (e.target !== removeBtn && !removeBtn.contains(e.target)) input.click();
    });

    area.addEventListener("dragover", function (e) {
      e.preventDefault();
      area.classList.add("dragover");
    });
    area.addEventListener("dragleave", function () {
      area.classList.remove("dragover");
    });
    area.addEventListener("drop", function (e) {
      e.preventDefault();
      area.classList.remove("dragover");
      if (e.dataTransfer.files.length) {
        input.files = e.dataTransfer.files;
        pickFile(e.dataTransfer.files[0]);
      }
    });

    input.addEventListener("change", function () {
      if (input.files.length) pickFile(input.files[0]);
    });

    removeBtn.addEventListener("click", function (e) {
      e.stopPropagation();
      input.value = "";
      info.style.display = "none";
      btn.disabled = true;
    });

    form.addEventListener("submit", function (e) {
      if (!input.files.length) {
        e.preventDefault();
        alert("Please select a file to upload.");
      } else {
        btn.disabled = true;
        btn.value = "Processing…";
      }
    });
  });
</script>

<style>
  .nbp-blended {
    --primary: #4361ee;
    --primary-light: #6c8aff;
    --secondary: #7209b7;
    --accent: #4cc9f0;
    --success: #06d6a0;
    --danger: #f72585;
    --light: #f8f9fc;
    --dark: #2b2d42;
    --gray: #8d99ae;
    --border-radius: 16px;
    --shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    --transition: all 0.3s ease;
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    font-family: "Inter", "Segoe UI", Roboto, sans-serif;
    color: var(--dark);
    background: linear-gradient(135deg, #f5f7ff 0%, #f0f4ff 100%);
    min-height: calc(100vh - 20px);
  }

  .nbp-blended .header {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-radius: var(--border-radius);
    padding: 2rem;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow);
    border: 1px solid rgba(255, 255, 255, 0.8);
  }

  .nbp-blended .header-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .nbp-blended .header-text h1 {
    font-weight: 800;
    font-size: 2rem;
    margin: 0 0 0.35rem;
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .nbp-blended .header-text p {
    margin: 0;
    color: var(--gray);
    font-size: 1.02rem;
  }

  .nbp-blended-header-actions {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    align-items: flex-end;
  }

  .nbp-blended .back-btn {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    color: white;
    border-radius: 50px;
    padding: 0.65rem 1.25rem;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 6px 20px rgba(67, 97, 238, 0.3);
    transition: var(--transition);
    white-space: nowrap;
  }

  .nbp-blended .back-btn--ghost {
    background: transparent;
    color: var(--primary);
    border: 2px solid var(--primary);
    box-shadow: none;
  }

  .nbp-blended .back-btn--ghost:hover {
    background: var(--primary);
    color: #fff;
  }

  .nbp-blended .back-btn:hover {
    transform: translateY(-2px);
    color: white;
    text-decoration: none;
  }

  .flash-messages { margin-bottom: 1.25rem; }

  .flash-message {
    padding: 1rem 1.25rem;
    border-radius: var(--border-radius);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .flash-message.alert {
    background: rgba(247, 37, 133, 0.1);
    border: 1px solid rgba(247, 37, 133, 0.3);
    border-left: 4px solid var(--danger);
    color: #9d174d;
  }

  .flash-message.notice {
    background: rgba(6, 214, 160, 0.1);
    border: 1px solid rgba(6, 214, 160, 0.3);
    border-left: 4px solid var(--success);
    color: #047857;
  }

  .upload-card {
    background: white;
    border-radius: var(--border-radius);
    padding: 2.5rem;
    box-shadow: var(--shadow);
    border-top: 4px solid var(--accent);
  }

  .upload-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .upload-icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent) 0%, #06b6d4 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
    color: white;
    font-size: 2rem;
  }

  .upload-text h2 {
    font-weight: 700;
    font-size: 1.65rem;
    color: var(--dark);
    margin: 0 0 0.35rem;
  }

  .upload-text p {
    color: var(--gray);
    margin: 0;
  }

  .upload-area {
    border: 3px dashed var(--primary-light);
    border-radius: var(--border-radius);
    padding: 2.5rem 1.5rem;
    text-align: center;
    background: rgba(67, 97, 238, 0.02);
    transition: var(--transition);
    cursor: pointer;
    position: relative;
    margin-bottom: 1.25rem;
  }

  .upload-area:hover {
    border-color: var(--primary);
    background: rgba(67, 97, 238, 0.05);
  }

  .upload-area.dragover {
    border-color: var(--success);
    background: rgba(6, 214, 160, 0.06);
  }

  .upload-placeholder i {
    font-size: 2.75rem;
    color: var(--primary);
    margin-bottom: 0.75rem;
  }

  .upload-placeholder h3 {
    font-weight: 600;
    color: var(--dark);
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
  }

  .upload-placeholder p {
    color: var(--gray);
    font-size: 0.9rem;
    margin: 0;
  }

  .file-input {
    position: absolute;
    left: -9999px;
    opacity: 0;
  }

  .file-details {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--light);
    border-radius: var(--border-radius);
    border-left: 4px solid var(--success);
    text-align: left;
  }

  .file-details i {
    font-size: 1.75rem;
    color: var(--success);
  }

  .file-meta { flex: 1; }

  .file-name {
    font-weight: 600;
    color: var(--dark);
  }

  .file-size {
    color: var(--gray);
    font-size: 0.85rem;
  }

  .remove-btn {
    background: rgba(247, 37, 133, 0.1);
    border: 2px solid var(--danger);
    color: var(--danger);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition);
  }

  .remove-btn:hover {
    background: var(--danger);
    color: white;
  }

  .upload-actions {
    text-align: center;
  }

  .upload-btn {
    background: linear-gradient(135deg, var(--success) 0%, #05c291 100%);
    color: white;
    border: none;
    border-radius: 50px;
    padding: 1rem 2.5rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
    box-shadow: 0 6px 20px rgba(6, 214, 160, 0.3);
    font-size: 1.05rem;
  }

  .upload-btn:hover:not(:disabled) {
    transform: translateY(-2px);
  }

  .upload-btn:disabled {
    background: var(--gray);
    cursor: not-allowed;
    box-shadow: none;
    transform: none;
  }

  .upload-tips {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 440px;
    margin: 1.25rem auto 0;
  }

  .tip-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.85rem 1rem;
    background: var(--light);
    border-radius: var(--border-radius);
    border-left: 3px solid var(--accent);
    color: var(--gray);
    font-size: 0.9rem;
    text-align: left;
  }

  .tip-item i {
    color: var(--accent);
    margin-top: 0.15rem;
  }

  @media (max-width: 600px) {
    .nbp-blended-header-actions {
      align-items: stretch;
      width: 100%;
    }

    .nbp-blended .back-btn {
      justify-content: center;
    }
  }
</style>
