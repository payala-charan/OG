6	Grouped UtilizationReport Job flow	flowchart TD\r\n  A["Controller / QuarterDataStatus<br/>perform_now / perform_later"] --> B["UtilizationReportGroupedBestMarginJob#perform"]\r\n\r\n  B --> C["Load UtilizationReports<br/>team + period + category:nil<br/>optional generic / report_ids"]\r\n  C --> D{strategy present?}\r\n\r\n  D -->|No - legacy| E{every UR has individual IC?}\r\n  E -->|No, attempt &lt; 40| F["re-enqueue wait 30s"]\r\n  E -->|Yes or timeout| G["Display grouping"]\r\n  D -->|Yes - criteria| G\r\n\r\n  G --> H["UtilizationReportDisplayGrouping<br/>group_reports_for_user"]\r\n  H --> I{strategy present?}\r\n  I -->|Yes| J["ALL groups"]\r\n  I -->|No| K["only groups size &gt; 1"]\r\n  J --> L\r\n  K --> L["For each group:<br/>BatchJob.perform_now(representative.id)"]\r\n\r\n  L --> M["GroupedBestMargin::Organizer"]\r\n  M --> N["1. FindDisplayGroup"]\r\n  N --> O["2. EnsureIndividualBestMargins"]\r\n  O --> P{strategy blank?}\r\n  P -->|Yes| Q["skip - use existing ICs"]\r\n  P -->|No| R["For EACH member UR<br/>ConversionCriteria::Organizer"]\r\n\r\n  R --> S["Load report"]\r\n  S --> T["SelectCriteriaConversionProduct"]\r\n  T --> U{"ConversionBrandEligibility<br/>eligible?"}\r\n  U -->|No mismatch| V["conversion_blocked=true<br/>converted_to=nil"]\r\n  V --> W["Calculate: skip"]\r\n  W --> X["Update: zeroed individual IC"]\r\n  U -->|Yes match| Y["Pick product by strategy"]\r\n  Y --> Z["Calculate metrics"]\r\n  Z --> AA["Update: real individual IC"]\r\n\r\n  Q --> AB["3. CollectIndividualBestMargins"]\r\n  X --> AB\r\n  AA --> AB\r\n  AB --> AC{"skip_grouped_aggregation?<br/>single-record group"}\r\n  AC -->|Yes| AD["Stop. Individual IC only"]\r\n  AC -->|No| AE["4. AggregateIndividualConversions<br/>SUM money fields<br/>COPY product/converted_to from highest UR id"]\r\n  AE --> AF["5. UpdateGroupedInvoiceConversion<br/>upsert status=grouped on representative"]\r\n  AF --> AG["UI: nil product → Select Products"]\r\n	2026-08-19 15:16:43.77245	2026-08-19 15:16:43.782834	209
